+	if (!Loaded)
+	{
+		UE_LOG(LogSoundCueService, Warning, TEXT("LoadSoundCue: failed to load '%s'"), *AssetPath);
+		return nullptr;
+	}
+
+	USoundCue* SoundCue = Cast<USoundCue>(Loaded);
+	if (!SoundCue)
+	{
+		UE_LOG(LogSoundCueService, Warning, TEXT("LoadSoundCue: '%s' is not a SoundCue"), *AssetPath);
+		return nullptr;
+	}
+
+	return SoundCue;
