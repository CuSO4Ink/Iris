+		Tool->TryGetStringField(TEXT("name"), Name);
+		Tool->TryGetStringField(TEXT("description"), Description);
+		View->SetStringField(TEXT("tool"), CompactToolName(ToolsetName, Name));
+		View->SetStringField(TEXT("effect"), ClassifyEffect(Name, Description));
+
+		TSharedRef<FJsonObject> Args = MakeShared<FJsonObject>();
+		const TSharedPtr<FJsonObject>* InputSchema = nullptr;
+		const TSharedPtr<FJsonObject>* Properties = nullptr;
+		if (Tool->TryGetObjectField(TEXT("inputSchema"), InputSchema) && InputSchema && (*InputSchema)->TryGetObjectField(TEXT("properties"), Properties) && Properties)
+		{
+			TSet<FString> Required;
+			const TArray<TSharedPtr<FJsonValue>>* RequiredValues = nullptr;
+			if ((*InputSchema)->TryGetArrayField(TEXT("required"), RequiredValues) && RequiredValues)
+			{
+				for (const TSharedPtr<FJsonValue>& Value : *RequiredValues)
+				{
+					FString RequiredName;
+					if (Value.IsValid() && Value->TryGetString(RequiredName)) Required.Add(RequiredName);
+				}
+			}
+			for (const TPair<FString, TSharedPtr<FJsonValue>>& Pair : (*Properties)->Values)
+			{
+				if (Pair.Value.IsValid() && Pair.Value->Type == EJson::Object)
+				{
+					FString Type = CompactSchemaType(Pair.Value->AsObject(), Pair.Key);
+					if (Required.Contains(Pair.Key)) Type += TEXT("!");
+					Args->SetStringField(Pair.Key, Type);
+				}
+			}
+		}
+		View->SetObjectField(TEXT("args"), Args);
+
+		TSharedRef<FJsonObject> Returns = MakeShared<FJsonObject>();
+		const TSharedPtr<FJsonObject>* OutputSchema = nullptr;
+		if (Tool->TryGetObjectField(TEXT("outputSchema"), OutputSchema) && OutputSchema && (*OutputSchema)->TryGetObjectField(TEXT("properties"), Properties) && Properties)
+		{
+			for (const TPair<FString, TSharedPtr<FJsonValue>>& Pair : (*Properties)->Values)
+			{
+				if (Pair.Value.IsValid() && Pair.Value->Type == EJson::Object) Returns->SetStringField(Pair.Key, CompactSchemaType(Pair.Value->AsObject(), Pair.Key));
+			}
+		}
+		View->SetObjectField(TEXT("returns"), Returns);
+		return View;
+	}
