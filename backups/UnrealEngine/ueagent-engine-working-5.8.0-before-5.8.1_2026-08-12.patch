+FString UNiagaraToolset_System::GetScriptGraphText(const UNiagaraScript* Script)
+{
+	const UNiagaraScriptSource* Source = Script ? Cast<UNiagaraScriptSource>(Script->GetLatestSource()) : nullptr;
+	if (Source == nullptr || Source->NodeGraph == nullptr)
+	{
+		Error(TEXT("Script has no readable Niagara graph."));
+		return {};
+	}
+
+	TSet<UObject*> Nodes;
+	for (UEdGraphNode* Node : Source->NodeGraph->Nodes)
+	{
+		Nodes.Add(Node);
+	}
+	FString ExportedText;
+	FEdGraphUtilities::ExportNodesToText(MoveTemp(Nodes), ExportedText);
+	return ExportedText;
+}
