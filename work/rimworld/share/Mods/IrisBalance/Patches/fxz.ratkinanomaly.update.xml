<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>fxz.ratkinanomaly.update</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;RA_PaladinCoronet&quot;]/statBases/ArmorRating_Sharp</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;RA_PaladinCoronet&quot;]/statBases/ArmorRating_Sharp</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RA_PaladinCoronet"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;RA_PaladinArmor&quot;]/statBases/ArmorRating_Sharp</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;RA_PaladinArmor&quot;]/statBases/ArmorRating_Sharp</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RA_PaladinArmor"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;RA_HeartsRifle_Player&quot;]/statBases/AccuracyTouch</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;RA_HeartsRifle_Player&quot;]/statBases/AccuracyTouch</xpath>
          <value>
            <AccuracyTouch>0.75</AccuracyTouch>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RA_HeartsRifle_Player"]/statBases</xpath>
          <value>
            <AccuracyTouch>0.75</AccuracyTouch>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;RA_HeartsRifle_Player&quot;]/statBases/AccuracyShort</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;RA_HeartsRifle_Player&quot;]/statBases/AccuracyShort</xpath>
          <value>
            <AccuracyShort>0.90</AccuracyShort>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RA_HeartsRifle_Player"]/statBases</xpath>
          <value>
            <AccuracyShort>0.90</AccuracyShort>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;RA_HeartsRifle_Player&quot;]/statBases/AccuracyLong</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;RA_HeartsRifle_Player&quot;]/statBases/AccuracyLong</xpath>
          <value>
            <AccuracyLong>0.95</AccuracyLong>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RA_HeartsRifle_Player"]/statBases</xpath>
          <value>
            <AccuracyLong>0.95</AccuracyLong>
          </value>
        </nomatch>
      </li>
      </operations>
    </match>
  </Operation>
</Patch>
