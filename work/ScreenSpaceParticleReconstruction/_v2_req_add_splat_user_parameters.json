{
  "action": "tool.call",
  "endpoint": "http://127.0.0.1:8000/mcp",
  "timeoutSec": 120,
  "tool": "NiagaraToolsets.NiagaraToolset_System.AddUserVariables",
  "arguments": {
    "system": {
      "refPath": "/Game/SSPR_Validation/M2/AnisotropicSplat_V2/NS_SSPR_AnisotropicSplat_Main.NS_SSPR_AnisotropicSplat_Main"
    },
    "variablesToAdd": [
      {
        "name": "User.SSPR_MinLengthPx",
        "description": "Minimum anisotropic splat length in pixels.",
        "type": {"classStructOrEnum": {"refPath": "/Script/Niagara.NiagaraFloat"}},
        "defaultValue": {"struct": {"refPath": "/Script/Niagara.NiagaraFloat"}, "value": {"value": 2.0}}
      },
      {
        "name": "User.SSPR_VelocityLengthScale",
        "description": "Screen displacement to long-axis scale.",
        "type": {"classStructOrEnum": {"refPath": "/Script/Niagara.NiagaraFloat"}},
        "defaultValue": {"struct": {"refPath": "/Script/Niagara.NiagaraFloat"}, "value": {"value": 1.5}}
      },
      {
        "name": "User.SSPR_MaxLengthPx",
        "description": "Maximum anisotropic splat length in pixels.",
        "type": {"classStructOrEnum": {"refPath": "/Script/Niagara.NiagaraFloat"}},
        "defaultValue": {"struct": {"refPath": "/Script/Niagara.NiagaraFloat"}, "value": {"value": 48.0}}
      },
      {
        "name": "User.SSPR_WidthPx",
        "description": "Short-axis Gaussian sigma in pixels.",
        "type": {"classStructOrEnum": {"refPath": "/Script/Niagara.NiagaraFloat"}},
        "defaultValue": {"struct": {"refPath": "/Script/Niagara.NiagaraFloat"}, "value": {"value": 1.25}}
      },
      {
        "name": "User.SSPR_GaussianCutoffSigma",
        "description": "Gaussian kernel cutoff in standard deviations.",
        "type": {"classStructOrEnum": {"refPath": "/Script/Niagara.NiagaraFloat"}},
        "defaultValue": {"struct": {"refPath": "/Script/Niagara.NiagaraFloat"}, "value": {"value": 2.5}}
      },
      {
        "name": "User.SSPR_DensityPerParticle",
        "description": "Density contribution per particle before Q10 quantization.",
        "type": {"classStructOrEnum": {"refPath": "/Script/Niagara.NiagaraFloat"}},
        "defaultValue": {"struct": {"refPath": "/Script/Niagara.NiagaraFloat"}, "value": {"value": 0.25}}
      },
      {
        "name": "User.SSPR_MinDirectionSpeedPx",
        "description": "Minimum pixel displacement used to define a stable tangent.",
        "type": {"classStructOrEnum": {"refPath": "/Script/Niagara.NiagaraFloat"}},
        "defaultValue": {"struct": {"refPath": "/Script/Niagara.NiagaraFloat"}, "value": {"value": 0.05}}
      }
    ]
  }
}
