+
+	OutInfo.ProfileName = ProfileName;
+
+	const FReferenceSkeleton& RefSkel = Skeleton->GetReferenceSkeleton();
+	const int32 NumBones = RefSkel.GetNum();
+
+	for (int32 BoneIndex = 0; BoneIndex < NumBones; ++BoneIndex)
