  <!-- EN: 증발시키는 -->
  <Miho_PlasmaRounds.traitAdjectives.2>蒸發</Miho_PlasmaRounds.traitAdjectives.2>
  
  <!-- EN: 열화우라늄탄 -->
  <Miho_UraniumRounds.label>貧鈾彈</Miho_UraniumRounds.label>
