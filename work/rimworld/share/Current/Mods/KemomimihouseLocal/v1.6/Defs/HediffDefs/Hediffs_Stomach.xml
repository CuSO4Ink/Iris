<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef ParentName = "DiseaseBase">
    <defName>harapan</defName>
    <label>腹パン</label>
    <description>アカメを虐める相手への容赦のない一撃</description>
    <isBad>true</isBad>
    <!-- 重症値の最大、1(=100%)より大きくすることも小さくすることも出来る -->
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <vomitMtbDays>0.001</vomitMtbDays>
        <painFactor>1.1</painFactor>
      </li>
      <li>
        <minSeverity>0.15</minSeverity>
        <vomitMtbDays>0.0001</vomitMtbDays>
        <painFactor>1.2</painFactor>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.45</minSeverity>
        <vomitMtbDays>0.00007</vomitMtbDays>
        <painFactor>1.3</painFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <vomitMtbDays>0.00004</vomitMtbDays>
        <painFactor>1.4</painFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.3</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.4</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disorientation">
        <wanderMtbHours>0.05</wanderMtbHours>
        <singleWanderDurationTicks>180</singleWanderDurationTicks>
        <wanderRadius>3</wanderRadius>
      </li>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.5</severityPerDay>
      </li>
    </comps>
  </HediffDef>
</Defs>