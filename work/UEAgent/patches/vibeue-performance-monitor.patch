+static TSharedPtr<FJsonObject> ViewportJson(const FVector2D& Size)
+{
+	TSharedPtr<FJsonObject> Result = MakeShared<FJsonObject>();
+	Result->SetNumberField(TEXT("width"), FMath::RoundToInt(Size.X));
+	Result->SetNumberField(TEXT("height"), FMath::RoundToInt(Size.Y));
+	return Result;
+}
