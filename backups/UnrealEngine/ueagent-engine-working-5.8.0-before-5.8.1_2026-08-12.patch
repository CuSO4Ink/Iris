+		{
+			return TEXT("ue_ref<") + CompactClassName(Title) + TEXT(">");
+		}
+		if (Type.Equals(TEXT("object"), ESearchCase::IgnoreCase))
+		{
+			const TSharedPtr<FJsonObject>* Properties = nullptr;
+			if (Schema->TryGetObjectField(TEXT("properties"), Properties) && Properties && (*Properties)->HasField(TEXT("refPath")))
+			{
+				const FString LowerLabel = Label.ToLower();
+				if (LowerLabel.Contains(TEXT("material")) && (LowerLabel.Contains(TEXT("function")) || LowerLabel.Contains(TEXT("or"))))
+					return TEXT("ue_ref<Material|MaterialFunction>");
+				return TEXT("ue_ref<Object>");
+			}
+			return TEXT("object");
+		}
+		return Type.IsEmpty() ? TEXT("json") : Type;
+	}
+
+	FString CompactToolName(const FString& ToolsetName, const FString& FullToolName)
+	{
+		FString ToolsetLeaf = ToolsetName;
+		int32 Index = INDEX_NONE;
+		if (ToolsetLeaf.FindLastChar(TEXT('.'), Index)) ToolsetLeaf = ToolsetLeaf.RightChop(Index + 1);
+		FString ToolLeaf = FullToolName;
+		const FString Prefix = ToolsetName + TEXT(".");
+		if (ToolLeaf.StartsWith(Prefix, ESearchCase::IgnoreCase)) ToolLeaf = ToolLeaf.RightChop(Prefix.Len());
+		else if (ToolLeaf.FindLastChar(TEXT('.'), Index)) ToolLeaf = ToolLeaf.RightChop(Index + 1);
+		return ToolsetLeaf + TEXT(".") + ToolLeaf;
+	}
+
+	FString ClassifyEffect(const FString& Name, const FString& Description)
+	{
+		FString LeafName = Name;
+		int32 DotIndex = INDEX_NONE;
+		if (LeafName.FindLastChar(TEXT('.'), DotIndex)) LeafName = LeafName.RightChop(DotIndex + 1);
+		FString Lower = (LeafName + TEXT(" ") + Description).ToLower();
+		if (Lower.Contains(TEXT("save"))) return TEXT("save");
+		for (const TCHAR* Word : { TEXT("create"), TEXT("add"), TEXT("delete"), TEXT("remove"), TEXT("update"), TEXT("set_"), TEXT("write"), TEXT("modify"), TEXT("edit"), TEXT("rename"), TEXT("move"), TEXT("execute") })
+		{
+			if (Lower.StartsWith(Word) || Lower.Contains(FString(TEXT(" ")) + Word) || Lower.Contains(FString(TEXT("_")) + Word) || Lower.Contains(FString(TEXT(".")) + Word)) return TEXT("write");
+		}
+		for (const TCHAR* Word : { TEXT("get"), TEXT("list"), TEXT("find"), TEXT("read"), TEXT("describe"), TEXT("inspect"), TEXT("query"), TEXT("search"), TEXT("check"), TEXT("validate"), TEXT("discover") })
+		{
+			if (Lower.StartsWith(Word) || Lower.Contains(FString(TEXT(" ")) + Word) || Lower.Contains(FString(TEXT("_")) + Word) || Lower.Contains(FString(TEXT(".")) + Word)) return TEXT("read");
+		}
+		return TEXT("unknown");
+	}
+
+	TSharedRef<FJsonObject> MakeCallView(const TSharedPtr<FJsonObject>& Tool, const FString& ToolsetName)
+	{
+		TSharedRef<FJsonObject> View = MakeShared<FJsonObject>();
+		FString Name;
+		FString Description;
+		Tool->TryGetStringField(TEXT("name"), Name);
+		Tool->TryGetStringField(TEXT("description"), Description);
+		View->SetStringField(TEXT("tool"), CompactToolName(ToolsetName, Name));
+		View->SetStringField(TEXT("effect"), ClassifyEffect(Name, Description));
+
+		TSharedRef<FJsonObject> Args = MakeShared<FJsonObject>();
+		const TSharedPtr<FJsonObject>* InputSchema = nullptr;
+		const TSharedPtr<FJsonObject>* Properties = nullptr;
+		if (Tool->TryGetObjectField(TEXT("inputSchema"), InputSchema) && InputSchema && (*InputSchema)->TryGetObjectField(TEXT("properties"), Properties) && Properties)
+		{
+			TSet<FString> Required;
+			const TArray<TSharedPtr<FJsonValue>>* RequiredValues = nullptr;
+			if ((*InputSchema)->TryGetArrayField(TEXT("required"), RequiredValues) && RequiredValues)
+			{
+				for (const TSharedPtr<FJsonValue>& Value : *RequiredValues)
+				{
+					FString RequiredName;
+					if (Value.IsValid() && Value->TryGetString(RequiredName)) Required.Add(RequiredName);
+				}
+			}
+			for (const TPair<FString, TSharedPtr<FJsonValue>>& Pair : (*Properties)->Values)
+			{
+				if (Pair.Value.IsValid() && Pair.Value->Type == EJson::Object)
+				{
+					FString Type = CompactSchemaType(Pair.Value->AsObject(), Pair.Key);
+					if (Required.Contains(Pair.Key)) Type += TEXT("!");
+					Args->SetStringField(Pair.Key, Type);
+				}
+			}
+		}
+		View->SetObjectField(TEXT("args"), Args);
+
+		TSharedRef<FJsonObject> Returns = MakeShared<FJsonObject>();
+		const TSharedPtr<FJsonObject>* OutputSchema = nullptr;
+		if (Tool->TryGetObjectField(TEXT("outputSchema"), OutputSchema) && OutputSchema && (*OutputSchema)->TryGetObjectField(TEXT("properties"), Properties) && Properties)
+		{
+			for (const TPair<FString, TSharedPtr<FJsonValue>>& Pair : (*Properties)->Values)
+			{
+				if (Pair.Value.IsValid() && Pair.Value->Type == EJson::Object) Returns->SetStringField(Pair.Key, CompactSchemaType(Pair.Value->AsObject(), Pair.Key));
+			}
+		}
+		View->SetObjectField(TEXT("returns"), Returns);
+		return View;
+	}
+
+	TValueOrError<FString, FString> ProjectToolsetSchema(const FString& RawSchema, const FString& ToolName, const FString& Detail)
+	{
+		const bool bCall = Detail.IsEmpty() || Detail.Equals(TEXT("call"), ESearchCase::IgnoreCase);
+		const bool bSummary = Detail.Equals(TEXT("summary"), ESearchCase::IgnoreCase);
+		const bool bFull = Detail.Equals(TEXT("full"), ESearchCase::IgnoreCase);
+		if (!bCall && !bSummary && !bFull)
+		{
+			return MakeError(TEXT("detail must be 'call', 'summary', or 'full'"));
+		}
+		if (bFull && ToolName.IsEmpty())
+		{
+			return MakeValue(RawSchema);
+		}
+
+		TSharedPtr<FJsonObject> Schema;
+		TSharedRef<TJsonReader<>> Reader = TJsonReaderFactory<>::Create(RawSchema);
+		if (!FJsonSerializer::Deserialize(Reader, Schema) || !Schema.IsValid())
+		{
+			return MakeError(TEXT("Toolset schema is not valid JSON"));
+		}
+
+		TSharedRef<FJsonObject> Result = MakeShared<FJsonObject>();
+		FString Value;
+		FString ToolsetSchemaName;
+		Schema->TryGetStringField(TEXT("name"), ToolsetSchemaName);
+		if (!bCall)
+		{
+			if (Schema->TryGetStringField(TEXT("name"), Value)) Result->SetStringField(TEXT("name"), Value);
+			if (Schema->TryGetStringField(TEXT("version"), Value)) Result->SetStringField(TEXT("version"), Value);
+			if (Schema->TryGetStringField(TEXT("description"), Value)) Result->SetStringField(TEXT("description"), Value);
+		}
+
+		const TArray<TSharedPtr<FJsonValue>>* Tools = nullptr;
+		if (!Schema->TryGetArrayField(TEXT("tools"), Tools) || !Tools)
+		{
+			return MakeError(TEXT("Toolset schema has no tools array"));
+		}
+
+		TArray<TSharedPtr<FJsonValue>> SelectedTools;
+		for (const TSharedPtr<FJsonValue>& ToolValue : *Tools)
+		{
+			if (!ToolValue.IsValid() || ToolValue->Type != EJson::Object)
+			{
+				continue;
+			}
+			TSharedPtr<FJsonObject> Tool = ToolValue->AsObject();
+			if (!Tool.IsValid())
+			{
+				continue;
+			}
+			FString Name;
+			Tool->TryGetStringField(TEXT("name"), Name);
+			const bool bMatches = ToolName.IsEmpty()
+				|| Name.Equals(ToolName, ESearchCase::IgnoreCase)
+				|| Name.EndsWith(TEXT(".") + ToolName, ESearchCase::IgnoreCase);
+			if (!bMatches)
+			{
+				continue;
+			}
+
+			if (bCall)
+			{
+				SelectedTools.Add(MakeShared<FJsonValueObject>(MakeCallView(Tool, ToolsetSchemaName)));
+			}
+			else if (bSummary)
+			{
+				TSharedRef<FJsonObject> Summary = MakeShared<FJsonObject>();
+				if (Tool->TryGetStringField(TEXT("name"), Value)) Summary->SetStringField(TEXT("name"), Value);
+				if (Tool->TryGetStringField(TEXT("description"), Value)) Summary->SetStringField(TEXT("description"), Value);
+				SelectedTools.Add(MakeShared<FJsonValueObject>(Summary));
+			}
+			else
+			{
+				SelectedTools.Add(MakeShared<FJsonValueObject>(Tool));
+			}
+		}
+
+		if (!ToolName.IsEmpty() && SelectedTools.Num() == 0)
+		{
+			return MakeError(FString::Printf(TEXT("Tool '%s' not found in toolset schema"), *ToolName));
+		}
+		if (bCall && !ToolName.IsEmpty() && SelectedTools.Num() == 1)
+		{
+			return MakeValue(JsonValueToString(SelectedTools[0]));
+		}
+		Result->SetArrayField(TEXT("tools"), MoveTemp(SelectedTools));
+		return MakeValue(JsonValueToString(MakeShared<FJsonValueObject>(Result)));
+	}
+}
