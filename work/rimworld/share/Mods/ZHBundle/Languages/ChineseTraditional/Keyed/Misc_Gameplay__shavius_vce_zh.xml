  <VCE_CheeseFinished>一份奶酪已經發酵完成</VCE_CheeseFinished>
	<!-- EN: Cheese press is pressing {0}. It will be ready with {1} quality in {2} -->
  <VCE_CheeseInProgress>該奶酪壓制器正在壓制{0}。他會在{2}以內以{1}質量完成</VCE_CheeseInProgress>
	<!-- EN: This cheese has reached its desired degree of ripening and is waiting for pickup -->
  <VCE_CheeseReady>該奶酪已達到目標質量，等待被收取</VCE_CheeseReady>
	<!-- EN: This milk has been improperly defined to work with the cheese press, contact the milk mod's author -->
  <VCE_MilkImproperlyDefined>該原乳並不能和奶酪壓制器兼容，請聯繫奶源的mod作者</VCE_MilkImproperlyDefined>
