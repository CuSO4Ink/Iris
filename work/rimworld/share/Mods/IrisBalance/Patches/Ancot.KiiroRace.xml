          <xpath>Defs/ThingDef[defName=&quot;Kiiro_ValorArmor&quot;]/statBases/ArmorRating_Sharp</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Kiiro_ValorArmor"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
