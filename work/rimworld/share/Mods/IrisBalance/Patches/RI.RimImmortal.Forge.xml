<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RI.RimImmortal.Forge</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;RI_Apparel_PoisonPythonHelmet&quot;]/statBases/ArmorRating_Sharp</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;RI_Apparel_PoisonPythonHelmet&quot;]/statBases/ArmorRating_Sharp</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RI_Apparel_PoisonPythonHelmet"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;RI_Apparel_FireDragonHelmet&quot;]/statBases/ArmorRating_Sharp</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;RI_Apparel_FireDragonHelmet&quot;]/statBases/ArmorRating_Sharp</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RI_Apparel_FireDragonHelmet"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;RI_Apparel_AncientCultivatorArmor&quot;]/statBases/ArmorRating_Sharp</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;RI_Apparel_AncientCultivatorArmor&quot;]/statBases/ArmorRating_Sharp</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RI_Apparel_AncientCultivatorArmor"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;RI_Apparel_PoisonPythonArmor&quot;]/statBases/ArmorRating_Sharp</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;RI_Apparel_PoisonPythonArmor&quot;]/statBases/ArmorRating_Sharp</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RI_Apparel_PoisonPythonArmor"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </nomatch>
      </li>
      </operations>
    </match>
  </Operation>
</Patch>
