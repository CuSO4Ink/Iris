+static TSharedPtr<FJsonObject> BuildMonitorContext()
+{
+	const FString CurrentMap = GetMonitorMap();
+	const FVector2D CurrentViewportSize = GetMonitorViewportSize();
+	const TMap<FString, FString> CurrentSettings = GetMonitorSettings();
+	const bool bMapChanged = CurrentMap != GMonitorStartMap;
+	const bool bResolutionChanged = FMath::RoundToInt(CurrentViewportSize.X) != FMath::RoundToInt(GMonitorStartViewportSize.X)
+		|| FMath::RoundToInt(CurrentViewportSize.Y) != FMath::RoundToInt(GMonitorStartViewportSize.Y);
+
+	TArray<TSharedPtr<FJsonValue>> Changes;
+	TArray<FString> Names;
+	GMonitorStartSettings.GenerateKeyArray(Names);
+	Names.Sort();
+	for (const FString& Name : Names)
+	{
+		const FString* Current = CurrentSettings.Find(Name);
+		const FString& Started = GMonitorStartSettings.FindChecked(Name);
+		if (!Current || *Current != Started)
+		{
+			TSharedPtr<FJsonObject> Change = MakeShared<FJsonObject>();
+			Change->SetStringField(TEXT("name"), Name);
+			Change->SetStringField(TEXT("start"), Started);
+			Change->SetStringField(TEXT("current"), Current ? *Current : TEXT("unavailable"));
+			Changes.Add(MakeShared<FJsonValueObject>(Change));
+		}
+	}
+
+	TSharedPtr<FJsonObject> Context = MakeShared<FJsonObject>();
+	Context->SetBoolField(TEXT("pie_running"), IsPIERunning());
+	Context->SetBoolField(TEXT("context_lost"), GMonitorContextLost);
+	Context->SetStringField(TEXT("map_start"), GMonitorStartMap);
+	Context->SetStringField(TEXT("map_current"), CurrentMap);
+	Context->SetBoolField(TEXT("map_changed"), bMapChanged);
+	Context->SetObjectField(TEXT("viewport_start"), ViewportJson(GMonitorStartViewportSize));
+	Context->SetObjectField(TEXT("viewport_current"), ViewportJson(CurrentViewportSize));
+	Context->SetBoolField(TEXT("resolution_changed"), bResolutionChanged);
+	Context->SetObjectField(TEXT("settings_start"), SettingsJson(GMonitorStartSettings));
+	Context->SetObjectField(TEXT("settings_current"), SettingsJson(CurrentSettings));
+	Context->SetArrayField(TEXT("settings_changes"), Changes);
+	Context->SetBoolField(TEXT("settings_changed"), !Changes.IsEmpty());
+	Context->SetBoolField(
+		TEXT("comparable"),
+		IsPIERunning() && !GMonitorContextLost && !bMapChanged && !bResolutionChanged && Changes.IsEmpty());
+	Context->SetStringField(TEXT("engine_version"), FEngineVersion::Current().ToString());
+	Context->SetStringField(TEXT("rhi"), FApp::GetGraphicsRHI());
+	Context->SetStringField(TEXT("cpu"), FPlatformMisc::GetCPUBrand());
+	Context->SetStringField(TEXT("gpu"), GRHIAdapterName.IsEmpty() ? FPlatformMisc::GetPrimaryGPUBrand() : GRHIAdapterName);
+	return Context;
+}
