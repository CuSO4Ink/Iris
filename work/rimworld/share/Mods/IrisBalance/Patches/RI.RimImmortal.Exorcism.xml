        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/GeneDef[defName="RI_ZombieGene_BoneScale"]/statOffsets</xpath>
          <value>
            <ArmorRating_Heat>0.2</ArmorRating_Heat>
