  <!-- EN: MG-42 "incendiary" -->
  <Gun_IncendiaryMachineGun.verbs.Verb_Shoot.label>MG42通用機槍（怒焰）</Gun_IncendiaryMachineGun.verbs.Verb_Shoot.label>
  
