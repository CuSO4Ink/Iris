-			TEXT("ParameterName"),
-			TEXT("Group"),
-			TEXT("ExpressionGUID"),
-			TEXT("MaterialExpressionEditorX"),
-			TEXT("MaterialExpressionEditorY"),
-		};
-		TSharedRef<FJsonObject> PropsObj = MakeShared<FJsonObject>();
-		for (TFieldIterator<FProperty> PropIt(Expr->GetClass()); PropIt; ++PropIt)
