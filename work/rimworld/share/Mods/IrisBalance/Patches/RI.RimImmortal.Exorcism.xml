<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RI.RimImmortal.Exorcism</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;RI_Bullet_FireWave&quot;]/projectile/damageAmountBase</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;RI_Bullet_FireWave&quot;]/projectile/damageAmountBase</xpath>
          <value>
            <damageAmountBase>11</damageAmountBase>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RI_Bullet_FireWave"]/projectile</xpath>
          <value>
            <damageAmountBase>11</damageAmountBase>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;RI_Apparel_CurseProtectArmor&quot;]/statBases/ArmorRating_Sharp</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;RI_Apparel_CurseProtectArmor&quot;]/statBases/ArmorRating_Sharp</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RI_Apparel_CurseProtectArmor"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;RI_RangeWeapon_DetainGhostFlag&quot;]/statBases/AccuracyTouch</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;RI_RangeWeapon_DetainGhostFlag&quot;]/statBases/AccuracyTouch</xpath>
          <value>
            <AccuracyTouch>0.90</AccuracyTouch>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RI_RangeWeapon_DetainGhostFlag"]/statBases</xpath>
          <value>
            <AccuracyTouch>0.90</AccuracyTouch>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
