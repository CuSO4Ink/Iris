+
+	TSharedPtr<FJsonObject> Threads = MakeShared<FJsonObject>();
+	Threads->SetObjectField(TEXT("game_thread"), DistributionJson(Summary.Game));
+	Threads->SetObjectField(TEXT("render_thread"), DistributionJson(Summary.Render));
+	Threads->SetObjectField(TEXT("rhi_thread"), DistributionJson(Summary.Rhi));
+	Threads->SetObjectField(TEXT("gpu"), DistributionJson(Summary.Gpu));
+	Threads->SetObjectField(TEXT("frame"), DistributionJson(Summary.Frame));
+
+	TSharedPtr<FJsonObject> BoundCounts = MakeShared<FJsonObject>();
+	for (const TCHAR* Name : { TEXT("GameThread"), TEXT("RenderThread"), TEXT("RHIThread"), TEXT("GPU") })
+	{
+		BoundCounts->SetNumberField(Name, Summary.BoundCounts.FindRef(Name));
+	}
+	TSharedPtr<FJsonObject> Verdict = MakeShared<FJsonObject>();
+	Verdict->SetStringField(TEXT("dominant_bound"), Summary.DominantBound);
+	Verdict->SetObjectField(TEXT("bound_counts"), BoundCounts);
+	Verdict->SetNumberField(TEXT("contested_frames"), Summary.ContestedCount);
+	Verdict->SetNumberField(TEXT("contested_pct"), RoundPerf(100.0 * Summary.ContestedCount / SampleDenominator));
+
+	const double VramDenominator = FMath::Max(1, Summary.VramUsed.SampleCount);
+	TSharedPtr<FJsonObject> Vram = MakeShared<FJsonObject>();
+	Vram->SetBoolField(TEXT("available"), Summary.VramUsed.SampleCount > 0);
+	Vram->SetStringField(TEXT("source"), TEXT("RHIGetMemoryStats"));
+	Vram->SetObjectField(TEXT("used"), DistributionJson(Summary.VramUsed, TEXT("mb")));
+	Vram->SetObjectField(TEXT("usage"), DistributionJson(Summary.VramUsage, TEXT("pct")));
+	Vram->SetNumberField(TEXT("current_time_seconds"), RoundPerf(Summary.VramCurrentTimeSeconds));
+	Vram->SetNumberField(TEXT("current_used_mb"), RoundPerf(Summary.VramCurrentUsedMB));
+	Vram->SetNumberField(TEXT("current_budget_mb"), RoundPerf(Summary.VramCurrentBudgetMB));
+	Vram->SetNumberField(TEXT("current_available_mb"), RoundPerf(Summary.VramCurrentAvailableMB));
+	Vram->SetNumberField(TEXT("current_demoted_mb"), RoundPerf(Summary.VramCurrentDemotedMB));
+	Vram->SetNumberField(TEXT("peak_time_seconds"), RoundPerf(Summary.VramPeakTimeSeconds));
+	Vram->SetBoolField(TEXT("current_over_budget"), Summary.bVramCurrentOverBudget);
+	Vram->SetNumberField(TEXT("over_budget_frames"), Summary.VramOverBudgetCount);
+	Vram->SetNumberField(
+		TEXT("over_budget_pct"),
+		RoundPerf(100.0 * Summary.VramOverBudgetCount / VramDenominator));
+	Vram->SetStringField(
+		TEXT("note"),
+		TEXT("Budget is the OS/driver local-memory budget for this process, not the adapter's physical capacity."));
+
+	TArray<FPerfMonitorSample> Worst = GMonitorSamples;
+	Worst.Sort([](const FPerfMonitorSample& A, const FPerfMonitorSample& B)
+	{
+		return A.Timing.FrameMs > B.Timing.FrameMs;
+	});
+	TArray<TSharedPtr<FJsonValue>> Hotspots;
+	for (int32 Index = 0; Index < FMath::Min(5, Worst.Num()); ++Index)
+	{
+		const FPerfMonitorSample& Sample = Worst[Index];
+		const PerformanceVerdict::FVerdict SampleVerdict = PerformanceVerdict::Classify(
+			Sample.Timing.GameMs,
+			Sample.Timing.RenderMs,
+			Sample.Timing.RhiMs,
+			Sample.Timing.GpuMs,
+			Sample.Timing.bRhiAvailable,
+			Sample.Timing.bGpuAvailable);
+		TSharedPtr<FJsonObject> Hotspot = MakeShared<FJsonObject>();
+		Hotspot->SetNumberField(TEXT("time_seconds"), RoundPerf(Sample.Timing.TimeSeconds));
+		Hotspot->SetNumberField(TEXT("frame_ms"), RoundPerf(Sample.Timing.FrameMs));
+		Hotspot->SetNumberField(TEXT("game_thread_ms"), RoundPerf(Sample.Timing.GameMs));
+		Hotspot->SetNumberField(TEXT("render_thread_ms"), RoundPerf(Sample.Timing.RenderMs));
+		Hotspot->SetNumberField(TEXT("rhi_thread_ms"), RoundPerf(Sample.Timing.RhiMs));
+		Hotspot->SetNumberField(TEXT("gpu_ms"), RoundPerf(Sample.Timing.GpuMs));
+		Hotspot->SetStringField(TEXT("bound"), SampleVerdict.Bound);
+		Hotspot->SetBoolField(TEXT("contested"), SampleVerdict.bContested);
+		if (Sample.Timing.bVramAvailable)
+		{
+			constexpr double BytesPerMB = 1024.0 * 1024.0;
+			Hotspot->SetNumberField(TEXT("vram_used_mb"), RoundPerf(Sample.Timing.VramUsedBytes / BytesPerMB));
+			Hotspot->SetNumberField(TEXT("vram_budget_mb"), RoundPerf(Sample.Timing.VramBudgetBytes / BytesPerMB));
+			Hotspot->SetNumberField(
+				TEXT("vram_usage_pct"),
+				RoundPerf(100.0 * Sample.Timing.VramUsedBytes / Sample.Timing.VramBudgetBytes));
+			Hotspot->SetBoolField(
+				TEXT("vram_over_budget"),
+				Sample.Timing.VramDemotedBytes > 0
+					|| Sample.Timing.VramUsedBytes > Sample.Timing.VramBudgetBytes);
+		}
+		Hotspot->SetBoolField(TEXT("has_viewpoint"), Sample.bHasViewpoint);
+		if (Sample.bHasViewpoint)
+		{
+			TSharedPtr<FJsonObject> Location = MakeShared<FJsonObject>();
+			Location->SetNumberField(TEXT("x"), RoundPerf(Sample.ViewLocation.X));
+			Location->SetNumberField(TEXT("y"), RoundPerf(Sample.ViewLocation.Y));
+			Location->SetNumberField(TEXT("z"), RoundPerf(Sample.ViewLocation.Z));
+			TSharedPtr<FJsonObject> Rotation = MakeShared<FJsonObject>();
+			Rotation->SetNumberField(TEXT("pitch"), RoundPerf(Sample.ViewRotation.Pitch));
+			Rotation->SetNumberField(TEXT("yaw"), RoundPerf(Sample.ViewRotation.Yaw));
+			Rotation->SetNumberField(TEXT("roll"), RoundPerf(Sample.ViewRotation.Roll));
+			Hotspot->SetObjectField(TEXT("location"), Location);
+			Hotspot->SetObjectField(TEXT("rotation"), Rotation);
+		}
+		Hotspots.Add(MakeShared<FJsonValueObject>(Hotspot));
+	}
+
+	TSharedPtr<FJsonObject> Root = MakeShared<FJsonObject>();
+	Root->SetStringField(TEXT("schema"), TEXT("vibeue-performance-monitor-v1"));
+	Root->SetStringField(TEXT("status"), Status);
+	Root->SetBoolField(TEXT("monitoring"), GMonitorActive);
+	Root->SetStringField(TEXT("started_at_utc"), GMonitorStartedAtUtc.ToIso8601());
+	Root->SetNumberField(TEXT("elapsed_seconds"), RoundPerf(FPlatformTime::Seconds() - GMonitorStartSeconds));
+	Root->SetNumberField(TEXT("window_seconds"), RoundPerf(WindowSeconds));
+	Root->SetNumberField(TEXT("frames_total"), static_cast<double>(GMonitorTotalSamples));
+	Root->SetNumberField(TEXT("frames_kept"), GMonitorSamples.Num());
+	Root->SetNumberField(TEXT("warmup_frames_skipped"), GMonitorWarmupSkipped);
+	Root->SetNumberField(TEXT("instrumentation_frames_skipped"), GMonitorInstrumentationSkipped);
+	Root->SetNumberField(TEXT("invalid_frames_skipped"), GMonitorInvalidSkipped);
+	Root->SetObjectField(TEXT("context"), BuildMonitorContext());
+	Root->SetObjectField(TEXT("budget"), Budget);
+	Root->SetObjectField(TEXT("threads"), Threads);
+	Root->SetObjectField(TEXT("verdict"), Verdict);
+	Root->SetObjectField(TEXT("vram"), Vram);
+	Root->SetArrayField(TEXT("hotspots"), Hotspots);
+	if (Summary.SampleCount == 0)
+	{
+		Root->SetStringField(TEXT("warning"), TEXT("No valid samples yet. Wait for warmup to finish, then read again."));
+	}
+	return Root;
 }
 
