          <value>
            <power>30.8</power>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;Axolotl_FlameVermilionBirdCrown&quot;]/statBases/ArmorRating_Sharp</xpath>
        <match Class="PatchOperationReplace">
