+{
+	FNiagaraScratchResult Result;
+	UNiagaraSystem* System = LoadSystem(SystemPath);
+	if (!System) { Result.Message = TEXT("System not found"); return Result; }
+	if (VariableName.IsEmpty())
+	{
+		Result.Message = TEXT("Variable name is empty");
+		return Result;
+	}
+
+	const FName ParameterName(*VariableName);
+	const FName ObjectName(*FString::Printf(
+		TEXT("%s_InternalDI"),
+		*ParameterName.ToString().Replace(TEXT("."), TEXT("_"))));
+	UNiagaraDataInterfaceRasterizationGrid3D* RasterDI =
+		FindObject<UNiagaraDataInterfaceRasterizationGrid3D>(
+			System, *ObjectName.ToString());
+	if (!RasterDI)
+	{
+		RasterDI = NewObject<UNiagaraDataInterfaceRasterizationGrid3D>(
+			System,
+			UNiagaraDataInterfaceRasterizationGrid3D::StaticClass(),
+			ObjectName,
+			RF_Transactional);
+	}
+	if (!RasterDI)
+	{
+		Result.Message = TEXT("Failed to create RasterizationGrid3D data interface");
+		return Result;
+	}
+
+	const FIntVector RequestedSize(
+		FMath::Max(SizeX, 1),
+		FMath::Max(SizeY, 1),
+		FMath::Max(SizeZ, 1));
+	const int32 RequestedAttributes = FMath::Max(NumAttributes, 1);
+	const float RequestedPrecision = FMath::Max(Precision, KINDA_SMALL_NUMBER);
+	auto ConfigureRasterDI = [
+		&RequestedSize,
+		RequestedAttributes,
+		RequestedPrecision,
+		ResetValue,
+		bClearBeforeNonIterationStage
+	](UNiagaraDataInterfaceRasterizationGrid3D* TargetDI)
+	{
+		if (!TargetDI) return;
+		TargetDI->Modify();
+		TargetDI->NumCells = RequestedSize;
+		TargetDI->NumAttributes = RequestedAttributes;
+		TargetDI->Precision = RequestedPrecision;
+		TargetDI->ResetValue = ResetValue;
+		TargetDI->ClearBeforeNonIterationStage = bClearBeforeNonIterationStage;
+	};
+
+	System->Modify();
+	ConfigureRasterDI(RasterDI);
+
+	const FNiagaraVariable Variable(
+		FNiagaraTypeDefinition(
+			UNiagaraDataInterfaceRasterizationGrid3D::StaticClass()),
+		ParameterName);
+	FNiagaraUserRedirectionParameterStore& ExposedParameters =
+		System->GetExposedParameters();
+	int32 ParameterOffset = ExposedParameters.IndexOf(Variable);
+	if (ParameterOffset == INDEX_NONE)
+	{
+		ExposedParameters.AddParameter(
+			Variable, false, true, &ParameterOffset);
+	}
+	UNiagaraDataInterfaceRasterizationGrid3D* StoredRasterDI =
+		Cast<UNiagaraDataInterfaceRasterizationGrid3D>(
+			ExposedParameters.GetDataInterface(ParameterOffset));
+	if (!StoredRasterDI)
+	{
+		ExposedParameters.SetDataInterface(RasterDI, ParameterOffset);
+		StoredRasterDI = RasterDI;
+	}
+	ConfigureRasterDI(StoredRasterDI);
+
+	FPropertyChangedEvent PropertyChangedEvent(
+		nullptr, EPropertyChangeType::ValueSet);
+	System->PostEditChangeProperty(PropertyChangedEvent);
+	System->MarkPackageDirty();
+	System->RequestCompile(false);
+	System->WaitForCompilationComplete();
+
+	Result.bSuccess = true;
+	Result.Message = TEXT("RasterizationGrid3D user parameter created");
+	Result.ModuleName = ParameterName.ToString();
+	Result.ScriptPath = StoredRasterDI
+		? StoredRasterDI->GetPathName()
+		: RasterDI->GetPathName();
+	return Result;
+}
