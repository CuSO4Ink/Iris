	<!-- Mod options -->
	
	<!-- EN: Mood offset -->
  <VCEV_MoodMultiplier>心情偏移</VCEV_MoodMultiplier>
	<!-- EN: Both negative and positive moods produced by low and high Food Variety need will be multiplied by this number. +/- 5 by default. -->
  <VCEV_MoodMultiplierDesc>因饮食多样性需求较高/较低而获得的心情增益/减益会根据此项的值偏移。默认情况下为+5/-5。</VCEV_MoodMultiplierDesc>
	<!-- EN: Reset -->
  <VCEV_Reset>重设</VCEV_Reset>
	
	<!-- EN: Low Food Variety Threshold -->
  <VCEV_LowVarietyThreshold>饮食多样性阈值（较低）</VCEV_LowVarietyThreshold>
	<!-- EN: Colonists with lower food variety than this will get negative mood effects. 30% by default. -->
  <VCEV_LowVarietyThresholdDesc>当殖民者的饮食多样性需求低于某个阈值时，会获得心情减益。默认情况下为30%。</VCEV_LowVarietyThresholdDesc>
	
	<!-- EN: High Food Variety Threshold -->
  <VCEV_HighVarietyThreshold>饮食多样性阈值（较高）</VCEV_HighVarietyThreshold>
	<!-- EN: Colonists with higher food variety than this will get positive mood effects. 60% by default. -->
  <VCEV_HighVarietyThresholdDesc>当殖民者的饮食多样性需求高于某个阈值时，会获得心情增益。默认情况下为60%。</VCEV_HighVarietyThresholdDesc>
	
	<!-- EN: Number of latest meals to count -->
  <VCEV_NumberOfMeals>最近享用食物的记录数量</VCEV_NumberOfMeals>
	<!-- EN: The food variety need level will be calculated by counting among this number of meals consumed. Default is 7 latest meals. -->
  <VCEV_NumberOfMealsDesc>殖民者最近享用食物的记录数量。会影响食物多样性的值。默认情况下为7。</VCEV_NumberOfMealsDesc>
	
	<!-- EN: Number of latest ingredients to count -->
  <VCEV_NumberOfIngredients>最近享用食材的记录数量</VCEV_NumberOfIngredients>
	<!-- EN: The food variety need level will be calculated by counting among this number of ingredients consumed. Default is 7 latest ingredients. -->
  <VCEV_NumberOfIngredientsDesc>殖民者最近享用食材的记录数量。会影响食材多样性的值。默认情况下为7。</VCEV_NumberOfIngredientsDesc>

	<!-- EN: Number of ingredient stack per meal (requires reload) -->
  <VCEV_NumberOfIngredientStacked>每份食物所显示的原料数量（需要重新加载）</VCEV_NumberOfIngredientStacked>
	<!-- EN: By default, vanilla meals start deleting "common" ingredients after 3 ingredients. This allows you to increase that limit. Requires a mod reload to take effect. -->
  <VCEV_NumberOfIngredientStackedDesc>默认情况下，烹饪食物（例如简单食物、精致食物）的原料只会显示3种。超过3种时，那些相对而言比较“普通”的原料将被删除。调整此项可以提高原料数量的显示上限。需要重新加载Mod后才会使改动生效。</VCEV_NumberOfIngredientStackedDesc>

