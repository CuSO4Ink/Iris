  <!-- EN: 끈끈한 -->
  <Miho_MeltyPlasma.traitAdjectives.0>強蝕</Miho_MeltyPlasma.traitAdjectives.0>
  <!-- EN: 잘붙는 -->
  <Miho_MeltyPlasma.traitAdjectives.1>濃縮</Miho_MeltyPlasma.traitAdjectives.1>
  <!-- EN: 끈적한 -->
  <Miho_MeltyPlasma.traitAdjectives.2>蝕盡</Miho_MeltyPlasma.traitAdjectives.2>
  
  <!-- EN: 플라즈마탄 -->
  <Miho_PlasmaRounds.label>等離子彈</Miho_PlasmaRounds.label>
  <!-- EN: 높은 에너지를 저장하고 있는 전지를 발사해 플라즈마 폭발을 일으킵니다. -->
  <Miho_PlasmaRounds.description>此武器采用等離子電池作為彈藥，命中時可以快速地熔解目標身上的裝甲，且會對建築造成額外傷害。</Miho_PlasmaRounds.description>
  <!-- EN: 태양의 -->
  <Miho_PlasmaRounds.traitAdjectives.0>天陽</Miho_PlasmaRounds.traitAdjectives.0>
  <!-- EN: 뜨거운 -->
