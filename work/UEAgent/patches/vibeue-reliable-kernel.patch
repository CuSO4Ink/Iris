+const TArray<FString>& FUEAgentReliableKernel::GetControlToolNames()
+{
+	static const TArray<FString> Names = {
+		TEXT("ueagent_state"),
+		TEXT("ueagent_submit"),
+		TEXT("ueagent_get_job"),
+		TEXT("ueagent_cancel"),
+		TEXT("ueagent_snapshot"),
+		TEXT("ueagent_batch_read"),
+		TEXT("ueagent_save"),
+		TEXT("ueagent_recover"),
+	};
