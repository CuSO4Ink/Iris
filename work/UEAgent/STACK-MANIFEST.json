  "runtime": {
    "endpoint": "http://127.0.0.1:8000/mcp",
    "required_plugins": ["ModelContextProtocol", "EditorToolset", "VibeUE", "PlatformCrypto"],
    "reliable_protocol": "2.0.0",
    "mutation_transport": "ueagent-command-queue",
    "control_tools": [
      "ueagent_state",
      "ueagent_submit",
      "ueagent_get_job",
      "ueagent_cancel",
      "ueagent_snapshot",
      "ueagent_batch_read",
      "ueagent_save",
      "ueagent_recover",
      "ueagent_profile_gpu"
    ],
    "persistence": {
      "state": "Saved/UEAgent/state.json",
      "operations": "Saved/UEAgent/Operations",
      "inbox": "Saved/UEAgent/Inbox",
      "evidence": "Saved/UEAgent/Evidence"
    },
    "save_policy": "verified command receipt -> scoped one-use capability -> immutable save receipt",
    "gateway": "scripts/mcp_gateway.ps1",
    "gateway_process_guard": {
      "max_private_memory_mb": 2048,
      "hard_deadline_grace_sec": 15
    },
    "projection_profiles": ["identity", "topology", "logic", "runtime", "hlsl", "changed"],
    "cache_lifecycle": "scripts/reflect_cache.ps1 -Action reconcile",
    "daemon": {
      "script": "scripts/mcp_gateway_daemon.ps1",
      "auto_start": false,
      "defaults": {
        "max_private_memory_mb": 2048,
        "hard_request_grace_sec": 15,
        "max_requests": 1000,
        "max_uptime_sec": 7200,
        "idle_ttl_sec": 900,
        "max_request_bytes": 8388608,
        "max_response_bytes": 67108864
      }
    }
  },
  "verification": {
    "bootstrap": "scripts/bootstrap.ps1 -UProject <PROJECT> -EngineRoot <UE_ROOT> -ApplyMcpToolSearchPatch",
    "bootstrap_niagara_authoring": "scripts/bootstrap.ps1 -UProject <PROJECT> -EngineRoot <UE_ROOT> -ApplyNiagaraAuthoringProfile -ApplyMcpToolSearchPatch",
    "bootstrap_target": "scripts/bootstrap.ps1 -UProject <PROJECT> -EngineRoot <UE_ROOT> -TargetProfile <NAME> [-ExternalPluginSourceRoot <PLUGIN_BUNDLE>]",
    "bootstrap_abyss": "scripts/bootstrap.ps1 -UProject <PROJECT> -EngineRoot <UE_ROOT> -TargetProfile Abyss -ExternalPluginSourceRoot <ABYSS_PLUGIN_BUNDLE>",
    "reliable_profile": "tests/test_reliable_profile.ps1 -VibeUEPath <PROJECT>/Plugins/VibeUE -EngineRoot <UE_ROOT>",
    "static": "scripts/bootstrap.ps1 -UProject <PROJECT> -EngineRoot <UE_ROOT> -ApplyMcpToolSearchPatch -CheckOnly",
    "static_target": "scripts/bootstrap.ps1 -UProject <PROJECT> -EngineRoot <UE_ROOT> -TargetProfile <NAME> -CheckOnly",
    "static_abyss": "scripts/bootstrap.ps1 -UProject <PROJECT> -EngineRoot <UE_ROOT> -TargetProfile Abyss -CheckOnly",
    "doctor": "scripts/doctor.ps1 -RouteFile <PROJECT>/Saved/UEAgent/route.json",
    "route": "scripts/compact_context.ps1 -RouteFile <PROJECT>/Saved/UEAgent/route.json"
  }
}
