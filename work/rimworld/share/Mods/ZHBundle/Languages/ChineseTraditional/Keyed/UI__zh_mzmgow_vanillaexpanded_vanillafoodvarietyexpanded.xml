	<!-- Mod options -->
	
	<!-- EN: Mood offset -->
  <VCEV_MoodMultiplier>心情偏移</VCEV_MoodMultiplier>
	<!-- EN: Both negative and positive moods produced by low and high Food Variety need will be multiplied by this number. +/- 5 by default. -->
  <VCEV_MoodMultiplierDesc>因飲食多樣性需求較高/較低而獲得的心情增益/減益會根據此項的值偏移。默認情況下為+5/-5。</VCEV_MoodMultiplierDesc>
	<!-- EN: Reset -->
  <VCEV_Reset>重設</VCEV_Reset>
	
	<!-- EN: Low Food Variety Threshold -->
  <VCEV_LowVarietyThreshold>飲食多樣性閾值（較低）</VCEV_LowVarietyThreshold>
	<!-- EN: Colonists with lower food variety than this will get negative mood effects. 30% by default. -->
  <VCEV_LowVarietyThresholdDesc>當殖民者的飲食多樣性需求低於某個閾值時，會獲得心情減益。默認情況下為30%。</VCEV_LowVarietyThresholdDesc>
	
	<!-- EN: High Food Variety Threshold -->
  <VCEV_HighVarietyThreshold>飲食多樣性閾值（較高）</VCEV_HighVarietyThreshold>
	<!-- EN: Colonists with higher food variety than this will get positive mood effects. 60% by default. -->
  <VCEV_HighVarietyThresholdDesc>當殖民者的飲食多樣性需求高於某個閾值時，會獲得心情增益。默認情況下為60%。</VCEV_HighVarietyThresholdDesc>
	
	<!-- EN: Number of latest meals to count -->
  <VCEV_NumberOfMeals>最近享用料理的記錄數量</VCEV_NumberOfMeals>
	<!-- EN: The food variety need level will be calculated by counting among this number of meals consumed. Default is 7 latest meals. -->
  <VCEV_NumberOfMealsDesc>殖民者最近享用料理的記錄數量。會影響料理多樣性的值。默認情況下為7。</VCEV_NumberOfMealsDesc>
	
	<!-- EN: Number of latest ingredients to count -->
  <VCEV_NumberOfIngredients>最近享用食材的記錄數量</VCEV_NumberOfIngredients>
	<!-- EN: The food variety need level will be calculated by counting among this number of ingredients consumed. Default is 7 latest ingredients. -->
  <VCEV_NumberOfIngredientsDesc>殖民者最近享用食材的記錄數量。會影響食材多樣性的值。默認情況下為7。</VCEV_NumberOfIngredientsDesc>

	<!-- EN: Number of ingredient stack per meal (requires reload) -->
  <VCEV_NumberOfIngredientStacked>每份料理所顯示的原料數量（需要重新加載）</VCEV_NumberOfIngredientStacked>
	<!-- EN: By default, vanilla meals start deleting "common" ingredients after 3 ingredients. This allows you to increase that limit. Requires a mod reload to take effect. -->
  <VCEV_NumberOfIngredientStackedDesc>默認情況下，料理的原料只會顯示3種。超過3種時，那些相對而言比較“普通”的原料將被刪除。調整此項可以提高原料數量的顯示上限。需要重新加載Mod後才會使改動生效。</VCEV_NumberOfIngredientStackedDesc>

