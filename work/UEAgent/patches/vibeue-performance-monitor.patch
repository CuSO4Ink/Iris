+static TSharedPtr<FJsonObject> SettingsJson(const TMap<FString, FString>& Settings)
+{
+	TSharedPtr<FJsonObject> Result = MakeShared<FJsonObject>();
+	TArray<FString> Names;
+	Settings.GenerateKeyArray(Names);
+	Names.Sort();
+	for (const FString& Name : Names) Result->SetStringField(Name, Settings.FindChecked(Name));
+	return Result;
+}
