+	{
+		return false;
+	}
+
+	FScopedTransaction Transaction(NSLOCTEXT("SoundCueService", "SetWavePlayerAsset", "Set WavePlayer Asset"));
+	SoundCue->Modify();
+	WavePlayer->Modify();
+
+	WavePlayer->SetSoundWave(SoundWave);
+	SoundCue->MarkPackageDirty();
+
+	return true;
+}
