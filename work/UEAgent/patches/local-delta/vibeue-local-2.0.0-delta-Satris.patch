-FMetaSoundInfo UMetaSoundService::GetMetaSoundInfo(const FString& AssetPath)
-{
-	FMetaSoundInfo Info;
-	Info.AssetPath = AssetPath;
-
-	FString LoadError;
-	UMetaSoundSource* Source = nullptr;
-	UMetaSoundBuilderBase* Builder = BeginEditing(AssetPath, &Source, LoadError);
