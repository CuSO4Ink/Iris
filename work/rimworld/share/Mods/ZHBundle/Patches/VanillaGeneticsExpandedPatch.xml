                        <value>毛</value>
                    </value>
                </li>
                <li Class="PatchOperationReplace"> 
                    <xpath>/Defs/ThingDef[defName="VCE_Cheese"]/comps/li[@Class="VEF.Things.CompProperties_LabelByIngredients"]/overrides/li[key="GR_RatMilk"]/value</xpath>
                    <value>
                        <value>雪牛鼠</value>
                    </value>
                </li>
			</operations>
		</match>
	</Operation>
</Patch>
