<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: executioner ghoul (intense) -->
  <ExecutionerGhoul.stages.executioner_ghoul_intense.label>戮刑尸鬼恐惧（激烈）</ExecutionerGhoul.stages.executioner_ghoul_intense.label>
  <!-- EN: NO! NO! STAY AWAY!!!. -->
  <ExecutionerGhoul.stages.executioner_ghoul_intense.description>不！不！快让我离开这里！</ExecutionerGhoul.stages.executioner_ghoul_intense.description>
  <!-- EN: executioner ghoul (strong) -->
  <ExecutionerGhoul.stages.executioner_ghoul_strong.label>戮刑尸鬼恐惧（强烈）</ExecutionerGhoul.stages.executioner_ghoul_strong.label>
  <!-- EN: That thing. Its smile feels ominous -->
  <ExecutionerGhoul.stages.executioner_ghoul_strong.description>那个该死的怪物...它的笑容让我不寒而栗。</ExecutionerGhoul.stages.executioner_ghoul_strong.description>
  <!-- EN: executioner ghoul (distant) -->
  <ExecutionerGhoul.stages.executioner_ghoul_distant.label>戮刑尸鬼恐惧（遥远）</ExecutionerGhoul.stages.executioner_ghoul_distant.label>
  <!-- EN: I feel a sudden chill through my skin. -->
  <ExecutionerGhoul.stages.executioner_ghoul_distant.description>我的身体不由自主地涌起了一层鸡皮疙瘩。</ExecutionerGhoul.stages.executioner_ghoul_distant.description>
  
  <!-- EN: howling spider (intense) -->
  <HowlingSpider.stages.howling_spider_intense.label>尖啸骇蛛恐惧（激烈）</HowlingSpider.stages.howling_spider_intense.label>
  <!-- EN: STAY AWAY!!!. -->
  <HowlingSpider.stages.howling_spider_intense.description>我真的受不了！快让我离开这里！</HowlingSpider.stages.howling_spider_intense.description>
  <!-- EN: howling spider (strong) -->
  <HowlingSpider.stages.howling_spider_strong.label>尖啸骇蛛恐惧（强烈）</HowlingSpider.stages.howling_spider_strong.label>
  <!-- EN: Its howling hurts my ears. -->
  <HowlingSpider.stages.howling_spider_strong.description>它尖锐至极的叫声快把我的耳朵搞聋了！</HowlingSpider.stages.howling_spider_strong.description>
  <!-- EN: howling spider (distant) -->
  <HowlingSpider.stages.howling_spider_distant.label>尖啸骇蛛恐惧（遥远）</HowlingSpider.stages.howling_spider_distant.label>
  <!-- EN: What the fuck is that. -->
  <HowlingSpider.stages.howling_spider_distant.description>那他娘的是个什么鬼东西？</HowlingSpider.stages.howling_spider_distant.description>
  
</LanguageData>