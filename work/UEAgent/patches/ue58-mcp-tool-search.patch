+				if (Tool->TryGetStringField(TEXT("description"), Value)) Summary->SetStringField(TEXT("description"), Value);
+				SelectedTools.Add(MakeShared<FJsonValueObject>(Summary));
+			}
+			else
+			{
+				SelectedTools.Add(MakeShared<FJsonValueObject>(Tool));
+			}
+		}
+
+		if (!ToolName.IsEmpty() && SelectedTools.Num() == 0)
+		{
+			return MakeError(FString::Printf(TEXT("Tool '%s' not found in toolset schema"), *ToolName));
+		}
+		if (bCall && !ToolName.IsEmpty() && SelectedTools.Num() == 1)
+		{
+			return MakeValue(JsonValueToString(SelectedTools[0]));
+		}
+		Result->SetArrayField(TEXT("tools"), MoveTemp(SelectedTools));
+		return MakeValue(JsonValueToString(MakeShared<FJsonValueObject>(Result)));
+	}
