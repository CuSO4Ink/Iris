+	struct FJsonProjection
+	{
+		TSet<FString> Fields;
+		TSet<FString> Excluded;
+		int32 MaxItems = 0;
+		bool bStructured = false;
+		bool bIncludeText = false;
+
+		bool IsActive() const
+		{
+			return Fields.Num() > 0 || Excluded.Num() > 0 || MaxItems > 0 || bStructured;
+		}
+	};
+
+	FJsonProjection ReadProjection(const TSharedPtr<FJsonObject>& Object)
+	{
+		FJsonProjection Projection;
+		if (!Object.IsValid())
+		{
+			return Projection;
+		}
+
+		const TArray<TSharedPtr<FJsonValue>>* Values = nullptr;
+		if (Object->TryGetArrayField(TEXT("fields"), Values) && Values)
+		{
+			for (const TSharedPtr<FJsonValue>& Value : *Values)
+			{
+				FString Path;
+				if (Value.IsValid() && Value->TryGetString(Path) && !Path.IsEmpty())
+				{
+					Projection.Fields.Add(Path);
+				}
+			}
+		}
+		if (Object->TryGetArrayField(TEXT("exclude"), Values) && Values)
+		{
+			for (const TSharedPtr<FJsonValue>& Value : *Values)
+			{
+				FString Path;
+				if (Value.IsValid() && Value->TryGetString(Path) && !Path.IsEmpty())
+				{
+					Projection.Excluded.Add(Path);
+				}
+			}
+		}
+
+		double MaxItems = 0.0;
+		if (Object->TryGetNumberField(TEXT("max_items"), MaxItems))
+		{
+			Projection.MaxItems = FMath::Clamp(static_cast<int32>(MaxItems), 1, 4096);
+		}
+		Object->TryGetBoolField(TEXT("structured"), Projection.bStructured);
+		Object->TryGetBoolField(TEXT("include_text"), Projection.bIncludeText);
+		return Projection;
+	}
+
+	bool IsIncludedPath(const FJsonProjection& Projection, const FString& Path)
+	{
+		if (Projection.Fields.Num() == 0 || Path.IsEmpty())
+		{
+			return true;
+		}
+		for (const FString& Field : Projection.Fields)
+		{
+			if (Path == Field || Path.StartsWith(Field + TEXT(".")) || Field.StartsWith(Path + TEXT(".")))
+			{
+				return true;
+			}
+		}
+		return false;
+	}
+
+	bool IsExcludedPath(const FJsonProjection& Projection, const FString& Path)
+	{
+		for (const FString& Excluded : Projection.Excluded)
+		{
+			if (Path == Excluded || Path.StartsWith(Excluded + TEXT(".")))
+			{
+				return true;
+			}
+		}
+		return false;
+	}
+
+	TSharedPtr<FJsonValue> ProjectJsonValue(const TSharedPtr<FJsonValue>& Value, const FJsonProjection& Projection, const FString& Path)
+	{
+		if (!Value.IsValid())
+		{
+			return Value;
+		}
+
+		if (Value->Type == EJson::Object)
+		{
+			TSharedRef<FJsonObject> Source = Value->AsObject().ToSharedRef();
+			TSharedRef<FJsonObject> Result = MakeShared<FJsonObject>();
+			for (const TPair<FString, TSharedPtr<FJsonValue>>& Pair : Source->Values)
+			{
+				const FString ChildPath = Path.IsEmpty() ? Pair.Key : Path + TEXT(".") + Pair.Key;
+				if (IsExcludedPath(Projection, ChildPath) || !IsIncludedPath(Projection, ChildPath))
+				{
+					continue;
+				}
+				Result->SetField(Pair.Key, ProjectJsonValue(Pair.Value, Projection, ChildPath));
+			}
+			return MakeShared<FJsonValueObject>(Result);
+		}
+
+		if (Value->Type == EJson::Array)
+		{
+			const TArray<TSharedPtr<FJsonValue>>& Source = Value->AsArray();
+			TArray<TSharedPtr<FJsonValue>> Result;
+			const int32 Count = Projection.MaxItems > 0 ? FMath::Min(Projection.MaxItems, Source.Num()) : Source.Num();
+			Result.Reserve(Count);
+			for (int32 Index = 0; Index < Count; ++Index)
+			{
+				Result.Add(ProjectJsonValue(Source[Index], Projection, Path));
+			}
+			return MakeShared<FJsonValueArray>(MoveTemp(Result));
+		}
+
+		// Scalar values are immutable and can be shared without copying.
+		return Value;
+	}
+
+	FString JsonValueToString(const TSharedPtr<FJsonValue>& Value)
+	{
+		FString Output;
+		TSharedRef<TJsonWriter<TCHAR, TCondensedJsonPrintPolicy<TCHAR>>> Writer =
+			TJsonWriterFactory<TCHAR, TCondensedJsonPrintPolicy<TCHAR>>::Create(&Output);
+		FJsonSerializer::Serialize(Value.ToSharedRef(), FString(), Writer);
+		return Output;
+	}
+
+	FModelContextProtocolToolResult MakeProjectedToolResult(const FString& RawResult, const TSharedPtr<FJsonObject>& ProjectionObject)
+	{
+		const FJsonProjection Projection = ReadProjection(ProjectionObject);
+		if (!Projection.IsActive())
+		{
+			return UE::ModelContextProtocol::MakeTextResult(RawResult);
+		}
+
+		TSharedPtr<FJsonValue> Parsed;
+		TSharedRef<TJsonReader<>> Reader = TJsonReaderFactory<>::Create(RawResult);
+		if (!FJsonSerializer::Deserialize(Reader, Parsed) || !Parsed.IsValid())
+		{
+			// A tool may legitimately return plain text. Projection is best-effort and never corrupts it.
+			return UE::ModelContextProtocol::MakeTextResult(RawResult);
+		}
+
+		TSharedPtr<FJsonValue> Projected = ProjectJsonValue(Parsed, Projection, FString());
+		if (!Projection.bStructured)
+		{
+			return UE::ModelContextProtocol::MakeTextResult(JsonValueToString(Projected));
+		}
+
+		FModelContextProtocolToolResult Result = UE::ModelContextProtocol::MakeStructuredContentResult(Projected);
+		if (!Projection.bIncludeText && Result.JsonObject.IsValid())
+		{
+			// Explicit structured mode is the opt-in token-saving path. Legacy text can be retained with include_text=true.
+			Result.JsonObject->RemoveField(TEXT("content"));
+		}
+		return Result;
+	}
