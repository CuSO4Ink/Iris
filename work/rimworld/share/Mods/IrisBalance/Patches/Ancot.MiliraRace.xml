<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Ancot.MiliraRace</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;Milira_SingleHandblade&quot;]/tools/li[1]/power</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;Milira_SingleHandblade&quot;]/tools/li[1]/power</xpath>
          <value>
            <power>16.8</power>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Milira_SingleHandblade"]/tools/li[1]</xpath>
          <value>
            <power>16.8</power>
          </value>
        </nomatch>
      </li>
      </operations>
    </match>
  </Operation>
</Patch>
