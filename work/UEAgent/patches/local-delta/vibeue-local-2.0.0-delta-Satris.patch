+bool UMetaSoundService::ParseNodeGuid(const FString& NodeIdStr, FGuid& OutGuid, FMetaSoundResult& OutResult)
+{
+	if (!FGuid::Parse(NodeIdStr, OutGuid))
+	{
+		OutResult = Fail(FString::Printf(TEXT("Invalid NodeId: '%s'"), *NodeIdStr));
+		return false;
+	}
+	return true;
+}
