+FString UPerformanceService::StartMonitor(
+	float TargetFPS,
+	int32 WarmupFrames,
+	int32 MaxSamples,
+	float HitchThresholdMs)
+{
+	if (!IsPIERunning())
+	{
+		return ErrJson(
+			TEXT("PIE_REQUIRED"),
+			TEXT("Start in-process PIE first. The monitor rejects editor-viewport timing so it cannot be mistaken for a game baseline."));
+	}
+	if (GMonitorActive)
+	{
+		return ErrJson(TEXT("ALREADY_MONITORING"), TEXT("A performance monitor is already active. Read or stop it first."));
+	}
+	if (GMonitorTickerHandle.IsValid())
+	{
+		FTSTicker::GetCoreTicker().RemoveTicker(GMonitorTickerHandle);
+		GMonitorTickerHandle.Reset();
+	}
+
+	GMonitorTargetFps = static_cast<float>(PerformanceVerdict::SafeTargetFps(TargetFPS));
+	const double BudgetMs = 1000.0 / GMonitorTargetFps;
+	GMonitorHitchThresholdMs = FMath::IsFinite(HitchThresholdMs) && HitchThresholdMs > 0.0f
+		? FMath::Clamp(HitchThresholdMs, 1.0f, 5000.0f)
+		: static_cast<float>(FMath::Max(50.0, BudgetMs * 2.0));
+	GMonitorMaxSamples = FMath::Clamp(MaxSamples, 30, 3600);
+	GMonitorWarmupRemaining = FMath::Clamp(WarmupFrames, 0, 600);
+	GMonitorSuppressFrames = 0;
+	GMonitorWarmupSkipped = 0;
+	GMonitorInstrumentationSkipped = 0;
+	GMonitorInvalidSkipped = 0;
+	GMonitorTotalSamples = 0;
+	GMonitorNextIndex = 0;
+	GMonitorSamples.Reset(GMonitorMaxSamples);
+	GMonitorStartSeconds = FPlatformTime::Seconds();
+	GMonitorStartedAtUtc = FDateTime::UtcNow();
+	GMonitorStartMap = GetMonitorMap();
+	GMonitorStartViewportSize = GetMonitorViewportSize();
+	GMonitorStartSettings = GetMonitorSettings();
+	GMonitorContextLost = false;
+	GMonitorHasSession = true;
+	GMonitorActive = true;
+	GMonitorTickerHandle = FTSTicker::GetCoreTicker().AddTicker(
+		FTickerDelegate::CreateStatic(&TickPerformanceMonitor));
+
+	TSharedPtr<FJsonObject> Root = BuildMonitorSnapshot(TEXT("monitoring"));
+	Root->SetNumberField(TEXT("warmup_frames_remaining"), GMonitorWarmupRemaining);
+	Root->SetNumberField(TEXT("max_samples"), GMonitorMaxSamples);
+	Root->SetStringField(
+		TEXT("note"),
+		TEXT("Monitoring started. Move through the representative route, then call ReadMonitor or StopMonitor."));
+	return OkJson(Root);
+}
+
+FString UPerformanceService::ReadMonitor()
+{
+	if (!GMonitorHasSession)
+	{
+		return ErrJson(TEXT("NOT_STARTED"), TEXT("No performance monitor session exists. Call StartMonitor first."));
+	}
+
+	TSharedPtr<FJsonObject> Root = BuildMonitorSnapshot(GMonitorActive ? TEXT("monitoring") : TEXT("stopped"));
+	Root->SetNumberField(TEXT("warmup_frames_remaining"), GMonitorWarmupRemaining);
+	if (GMonitorActive)
+	{
+		GMonitorSuppressFrames = FMath::Max(GMonitorSuppressFrames, 3);
+		Root->SetStringField(
+			TEXT("note"),
+			TEXT("The next three frames will be discarded so this MCP read cannot create a false GameThread hitch."));
+	}
+	return OkJson(Root);
+}
+
+FString UPerformanceService::StopMonitor(const FString& Name, bool SaveSnapshot)
+{
+	if (!GMonitorHasSession)
+	{
+		return ErrJson(TEXT("NOT_STARTED"), TEXT("No performance monitor session exists. Call StartMonitor first."));
+	}
+	if (GMonitorTickerHandle.IsValid())
+	{
+		FTSTicker::GetCoreTicker().RemoveTicker(GMonitorTickerHandle);
+		GMonitorTickerHandle.Reset();
+	}
+	GMonitorActive = false;
+
+	TSharedPtr<FJsonObject> Root = BuildMonitorSnapshot(GMonitorContextLost ? TEXT("context_lost") : TEXT("stopped"));
+	Root->SetStringField(TEXT("note"), TEXT("Monitoring stopped; final rolling statistics are retained until the next StartMonitor call."));
+	if (!SaveSnapshot) return OkJson(Root);
+
+	FString SafeName = FPaths::MakeValidFileName(Name.IsEmpty() ? TEXT("monitor") : Name, TEXT('_'));
+	if (SafeName.IsEmpty()) SafeName = TEXT("monitor");
+	const FString Directory = PerformanceOutputDirAbs(TEXT("Snapshots"));
+	const FString Path = Directory / FString::Printf(
+		TEXT("%s_%s.json"),
+		*SafeName,
+		*FDateTime::Now().ToString(TEXT("%Y%m%d_%H%M%S")));
+	Root->SetStringField(TEXT("snapshot_file"), ProjectRelativePath(Path));
+	const FString Json = OkJson(Root);
+	if (!FFileHelper::SaveStringToFile(Json, *Path, FFileHelper::EEncodingOptions::ForceUTF8WithoutBOM))
+	{
+		return ErrJson(TEXT("SNAPSHOT_WRITE_FAILED"), FString::Printf(TEXT("Could not write monitor snapshot: %s"), *ProjectRelativePath(Path)));
+	}
+	return Json;
+}
