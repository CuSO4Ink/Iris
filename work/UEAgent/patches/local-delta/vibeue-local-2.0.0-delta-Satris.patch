-	if (Size && !Size->IsEmpty()) Out->SetStringField(TEXT("dimensions"),   *Size);
-
-	Out->SetStringField(TEXT("message"), FString::Printf(
-		TEXT("Heightmap saved to %s. Import via Edit > Import Heightmap in the Landscape editor."), *FilePath));
