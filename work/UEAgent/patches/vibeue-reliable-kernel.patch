+	TSharedPtr<FJsonObject> Ok()
+	{
+		TSharedPtr<FJsonObject> Result = MakeShared<FJsonObject>();
+		Result->SetBoolField(TEXT("success"), true);
+		return Result;
+	}
+
+	void AppendEscapedJsonString(FStringBuilderBase& Out, const FString& Value)
+	{
+		Out.AppendChar(TEXT('"'));
+		for (const TCHAR Character : Value)
+		{
+			switch (Character)
+			{
+			case TEXT('"'): Out.Append(TEXT("\\\"")); break;
+			case TEXT('\\'): Out.Append(TEXT("\\\\")); break;
+			case TEXT('\b'): Out.Append(TEXT("\\b")); break;
+			case TEXT('\f'): Out.Append(TEXT("\\f")); break;
+			case TEXT('\n'): Out.Append(TEXT("\\n")); break;
+			case TEXT('\r'): Out.Append(TEXT("\\r")); break;
+			case TEXT('\t'): Out.Append(TEXT("\\t")); break;
+			default:
+				if (Character < 0x20)
+				{
+					Out.Appendf(TEXT("\\u%04x"), static_cast<uint32>(Character));
+				}
+				else
+				{
+					Out.AppendChar(Character);
+				}
+				break;
+			}
+		}
+		Out.AppendChar(TEXT('"'));
+	}
+
+	void AppendCanonicalJson(FStringBuilderBase& Out, const TSharedPtr<FJsonValue>& Value)
+	{
+		if (!Value.IsValid() || Value->Type == EJson::Null)
+		{
+			Out.Append(TEXT("null"));
+			return;
+		}
+
+		switch (Value->Type)
+		{
+		case EJson::String:
+			AppendEscapedJsonString(Out, Value->AsString());
+			break;
+		case EJson::Boolean:
+			Out.Append(Value->AsBool() ? TEXT("true") : TEXT("false"));
+			break;
+		case EJson::Number:
+		{
+			const double Number = Value->AsNumber();
+			Out.Append(Number == 0.0 ? TEXT("0") : *FString::Printf(TEXT("%.17g"), Number));
+			break;
+		}
+		case EJson::Array:
+		{
+			Out.AppendChar(TEXT('['));
+			const TArray<TSharedPtr<FJsonValue>>& Values = Value->AsArray();
+			for (int32 Index = 0; Index < Values.Num(); ++Index)
+			{
+				if (Index > 0) Out.AppendChar(TEXT(','));
+				AppendCanonicalJson(Out, Values[Index]);
+			}
+			Out.AppendChar(TEXT(']'));
+			break;
+		}
+		case EJson::Object:
+		{
+			Out.AppendChar(TEXT('{'));
+			TArray<FString> Keys;
+			for (const auto& Pair : Value->AsObject()->Values)
+			{
+				Keys.Add(FString(Pair.Key));
+			}
+			Keys.Sort();
+			for (int32 Index = 0; Index < Keys.Num(); ++Index)
+			{
+				if (Index > 0) Out.AppendChar(TEXT(','));
+				AppendEscapedJsonString(Out, Keys[Index]);
+				Out.AppendChar(TEXT(':'));
+				AppendCanonicalJson(Out, Value->AsObject()->TryGetField(Keys[Index]));
+			}
+			Out.AppendChar(TEXT('}'));
+			break;
+		}
+		default:
+			Out.Append(TEXT("null"));
+			break;
+		}
+	}
+
+	FString CanonicalJson(const TSharedPtr<FJsonValue>& Value)
+	{
+		TStringBuilder<4096> Builder;
+		AppendCanonicalJson(Builder, Value);
+		return Builder.ToString();
+	}
+
+	FString CanonicalJson(const TSharedPtr<FJsonObject>& Object)
+	{
+		return CanonicalJson(MakeShared<FJsonValueObject>(Object.IsValid() ? Object : MakeShared<FJsonObject>()));
+	}
+
+	bool ParseObject(const FString& Json, TSharedPtr<FJsonObject>& OutObject)
+	{
+		const TSharedRef<TJsonReader<>> Reader = TJsonReaderFactory<>::Create(Json);
+		return FJsonSerializer::Deserialize(Reader, OutObject) && OutObject.IsValid();
+	}
+
+	TSharedPtr<FJsonValue> ParseValue(const FString& Json)
+	{
+        TArray<TSharedPtr<FJsonValue>> Values;
+        const TSharedRef<TJsonReader<>> Reader = TJsonReaderFactory<>::Create(TEXT("[") + Json + TEXT("]"));
+        return FJsonSerializer::Deserialize(Reader, Values) && Values.Num() == 1 ? Values[0] : nullptr;
+	}
+
+	TSharedPtr<FJsonObject> CloneObject(const TSharedPtr<FJsonObject>& Source)
+	{
+		TSharedPtr<FJsonObject> Copy = MakeShared<FJsonObject>();
+		if (Source.IsValid())
+		{
+			for (const auto& Pair : Source->Values)
+			{
+				Copy->SetField(FString(Pair.Key), Pair.Value);
+			}
+		}
+		return Copy;
+	}
+
+	FString JsonStringField(const TSharedPtr<FJsonObject>& Object, const TCHAR* Name)
+	{
+		FString Value;
+		if (Object.IsValid()) Object->TryGetStringField(Name, Value);
+		return Value;
+	}
+
+	TArray<FString> JsonStringArray(const TSharedPtr<FJsonObject>& Object, const TCHAR* Name)
+	{
+		TArray<FString> Result;
+		const TArray<TSharedPtr<FJsonValue>>* Values = nullptr;
+		if (!Object.IsValid() || !Object->TryGetArrayField(Name, Values) || !Values) return Result;
+		for (const TSharedPtr<FJsonValue>& Value : *Values)
+		{
+			FString String;
+			if (Value.IsValid() && Value->TryGetString(String)) Result.Add(String);
+		}
+		return Result;
+	}
+
+	bool IsGuid(const FString& Value)
+	{
+		FGuid Parsed;
+		return FGuid::ParseExact(Value, EGuidFormats::DigitsWithHyphens, Parsed)
+			&& Value.Equals(Parsed.ToString(EGuidFormats::DigitsWithHyphens), ESearchCase::IgnoreCase);
+	}
+
+	FString NormalizePackageScope(FString Scope)
+	{
+		Scope.TrimStartAndEndInline();
+		if (Scope.StartsWith(TEXT("object:"), ESearchCase::IgnoreCase))
+		{
+			Scope.RightChopInline(7);
+		}
+		if (!Scope.StartsWith(TEXT("/"))) return {};
+		const FString PackageName = FPackageName::ObjectPathToPackageName(Scope);
+		return FPackageName::IsValidLongPackageName(PackageName, true) ? PackageName : FString();
+	}
+
+	FString ObjectPathForScope(const FString& Scope, const FString& PackageName)
+	{
+		FString Value = Scope;
+		if (Value.StartsWith(TEXT("object:"), ESearchCase::IgnoreCase)) Value.RightChopInline(7);
+		if (Value.Contains(TEXT("."))) return Value;
+		return PackageName + TEXT(".") + FPackageName::GetShortName(PackageName);
+	}
+
+	bool IsSaveToolName(const FString& ToolName)
+	{
+		FString Leaf = ToolName;
+		int32 Dot = INDEX_NONE;
+		if (Leaf.FindLastChar(TEXT('.'), Dot)) Leaf.RightChopInline(Dot + 1);
+		return Leaf.StartsWith(TEXT("Save"), ESearchCase::IgnoreCase);
+	}
+
+	bool ResultIndicatesSuccess(FString RawResult, FString& OutNormalized, FString& OutError)
+	{
+		OutNormalized = RawResult;
+		TSharedPtr<FJsonValue> Value = ParseValue(RawResult);
+		if (Value.IsValid() && Value->Type == EJson::String)
+		{
+			const FString Nested = Value->AsString();
+			if (Nested.StartsWith(TEXT("{")) || Nested.StartsWith(TEXT("[")))
+			{
+				OutNormalized = Nested;
+				Value = ParseValue(Nested);
+			}
+		}
+		if (!Value.IsValid()) return true;
+		if (Value->Type == EJson::Boolean && !Value->AsBool())
+		{
+			OutError = TEXT("Tool returned false");
+			return false;
+		}
+		if (Value->Type == EJson::Object)
+		{
+			const TSharedPtr<FJsonObject> Object = Value->AsObject();
+			bool bSuccess = true;
+			const bool bHasSuccess = Object->TryGetBoolField(TEXT("success"), bSuccess)
+				|| Object->TryGetBoolField(TEXT("bSuccess"), bSuccess);
+			if (bHasSuccess && !bSuccess)
+			{
+				OutError = JsonStringField(Object, TEXT("error"));
+				if (OutError.IsEmpty()) OutError = JsonStringField(Object, TEXT("message"));
+				if (OutError.IsEmpty()) OutError = TEXT("Tool reported failure");
+				return false;
+			}
+		}
+		return true;
+	}
+
+    FString BusinessResult(FString Raw)
+    {
+        // ToolsetRegistry may wrap a JSON string in a sole returnValue field.
+        // Unwrap transport containers, preserving actual null/false/arrays.
+        for (int32 Depth = 0; Depth < 16; ++Depth)
+        {
+            auto Value = ParseValue(Raw);
+            if (!Value.IsValid()) return Raw;
+            if (Value->Type == EJson::String)
+            {
+                const FString Inner = Value->AsString();
+                if (!ParseValue(Inner).IsValid()) return Raw;
+                Raw = Inner; continue;
+            }
+            if (Value->Type == EJson::Object && Value->AsObject()->Values.Num() == 1 && Value->AsObject()->HasField(TEXT("returnValue")))
+            { Raw = CanonicalJson(Value->AsObject()->TryGetField(TEXT("returnValue"))); continue; }
+            return Raw;
+        }
+        return Raw;
+    }
+
+    bool Matches(const TSharedPtr<FJsonValue>& Actual, const TSharedPtr<FJsonValue>& Expected)
+    {
+        if (!Expected.IsValid()) return false;
+        if (!Actual.IsValid()) return Expected->Type == EJson::Null;
+        if (Actual->Type != Expected->Type) return false;
+        if (Expected->Type == EJson::Object)
+        {
+            for (const auto& Pair : Expected->AsObject()->Values)
+                if (!Actual->AsObject()->HasField(Pair.Key) || !Matches(Actual->AsObject()->TryGetField(Pair.Key), Pair.Value)) return false;
+            return true;
+        }
+        if (Expected->Type == EJson::Number)
+            return FMath::IsNearlyEqual(Actual->AsNumber(), Expected->AsNumber(), 1.e-6);
+        return CanonicalJson(Actual) == CanonicalJson(Expected);
+    }
+}
+class FUEAgentReliableKernel::FImpl
+{
+public:
+    struct FSnapshot
+    {
+        FString Scope, PackageName, ObjectPath, Error;
+        bool bDirty = false;
+        int64 SaveGeneration = 0;
+        int32 PropertyCount = 0, Bytes = 0;
+        TSharedPtr<FJsonObject> Data;
+    };
+    struct FJob
+    {
+        FString CommandId, RequestJson, State = TEXT("queued"), RawResult;
+        FString Outcome = TEXT("pending"), ErrorCode, ErrorMessage;
+        TSharedPtr<FJsonObject> Request, Readback, Result;
+        TArray<FString> Packages, PreexistingDirty;
+        bool bReadOnly = false, bSave = false, bAllowDirty = false, bChecking = false;
+        bool bVerified = false, bCancelRequested = false, bDeadlineReported = false;
+        double Deadline = 0;
+    };
+
+    void Initialize()
+    {
+        if (bInitialized) return;
+        bInitialized = true;
+        bool Enabled = false;
+        if (GConfig) GConfig->GetBool(UEAgentReliable::ConfigSection, TEXT("Enabled"), Enabled, GEditorIni);
+        bEnabled = Enabled;
+        EditorEpoch = FGuid::NewGuid().ToString(EGuidFormats::DigitsWithHyphens);
+        OperationsDir = FPaths::ConvertRelativePathToFull(FPaths::ProjectSavedDir() / TEXT("UEAgent/Operations"));
+        EvidenceDir = FPaths::ConvertRelativePathToFull(FPaths::ProjectSavedDir() / TEXT("UEAgent/Evidence"));
+        InboxDir = FPaths::ConvertRelativePathToFull(FPaths::ProjectSavedDir() / TEXT("UEAgent/Inbox"));
+        for (const FString& Directory : { OperationsDir, EvidenceDir, InboxDir }) IFileManager::Get().MakeDirectory(*Directory, true);
+        PackageSavedHandle = UPackage::PackageSavedWithContextEvent.AddLambda(
+            [this](const FString&, UPackage* Package, FObjectPostSaveContext Context)
+            { if (Package && Context.SaveSucceeded() && !Context.IsCooking() && !Context.IsProceduralSave()) PackageSaveGenerations.FindOrAdd(Package->GetName())++; });
+        TickerHandle = FTSTicker::GetCoreTicker().AddTicker(FTickerDelegate::CreateRaw(this, &FImpl::Tick));
+        RecoverIncomplete(false);
+    }
+    void Shutdown()
+    {
+        bInitialized = false;
+        FTSTicker::GetCoreTicker().RemoveTicker(TickerHandle);
+        UPackage::PackageSavedWithContextEvent.Remove(PackageSavedHandle);
+        Jobs.Reset(); Queue.Reset(); ActiveJobId.Reset();
+    }
+    bool IsEnabled() const { return bEnabled; }
+
+    TSharedPtr<FJsonObject> Invoke(const FString& Operation, const TSharedPtr<FJsonObject>& Parameters)
+    {
+        if (Operation == TEXT("ueagent_state")) return State();
+        if (!bEnabled || !bInitialized) return UEAgentReliable::Error(TEXT("EXECUTOR_DISABLED"), TEXT("Editor task executor is unavailable"));
+        FString Project = UEAgentReliable::JsonStringField(Parameters, TEXT("expected_project"));
+        FString ActualProject = FPaths::ConvertRelativePathToFull(FPaths::GetProjectFilePath());
+        FPaths::NormalizeFilename(Project); FPaths::NormalizeFilename(ActualProject);
+        if (Project.IsEmpty() || !Project.Equals(ActualProject, ESearchCase::IgnoreCase))
+            return UEAgentReliable::Error(TEXT("PROJECT_MISMATCH"), TEXT("Request is not bound to this project"));
+        if (UEAgentReliable::JsonStringField(Parameters, TEXT("editor_epoch")) != EditorEpoch)
+            return UEAgentReliable::Error(TEXT("EDITOR_CHANGED"), TEXT("Bind this session to the current editor before dispatch"));
+        if (Operation == TEXT("ueagent_submit")) return Submit(Parameters);
+        if (Operation == TEXT("ueagent_get_job")) return GetJob(Parameters);
+        if (Operation == TEXT("ueagent_cancel")) return Cancel(Parameters);
+        if (Operation == TEXT("ueagent_save")) return Save(Parameters);
+        if (Operation == TEXT("ueagent_snapshot")) return SnapshotRequest(Parameters);
+        if (Operation == TEXT("ueagent_batch_read")) return BatchRead(Parameters);
+        if (Operation == TEXT("ueagent_recover")) return RecoverIncomplete(false);
+        return UEAgentReliable::Error(TEXT("UNKNOWN_OPERATION"), Operation);
+    }
+
+    TSharedPtr<FJsonObject> State() const
+    {
+        auto Result = UEAgentReliable::Ok();
+        Result->SetStringField(TEXT("protocol_version"), UEAgentReliable::ProtocolVersion);
+        Result->SetStringField(TEXT("editor_epoch"), EditorEpoch);
+        Result->SetStringField(TEXT("project_file"), FPaths::ConvertRelativePathToFull(FPaths::GetProjectFilePath()));
+        Result->SetNumberField(TEXT("editor_pid"), FPlatformProcess::GetCurrentProcessId());
+        Result->SetBoolField(TEXT("enabled"), bEnabled);
+        Result->SetStringField(TEXT("active_command_id"), ActiveJobId);
+        Result->SetNumberField(TEXT("queued_jobs"), Queue.Num());
+        TArray<TSharedPtr<FJsonValue>> Dirty;
+        int32 Count = 0;
+        for (TObjectIterator<UPackage> It; It; ++It)
+            if (It->IsDirty() && *It != GetTransientPackage() && !It->HasAnyPackageFlags(PKG_CompiledIn) && FPackageName::IsValidLongPackageName(It->GetName(), true))
+            { ++Count; if (Dirty.Num() < 64) Dirty.Add(MakeShared<FJsonValueString>(It->GetName())); }
+        Result->SetNumberField(TEXT("dirty_package_count"), Count);
+        Result->SetArrayField(TEXT("dirty_packages"), Dirty);
+        return Result;
+    }
+
+    FString RequestPath(const FString& Id) const { return OperationsDir / (Id + TEXT(".request.json")); }
+    FString ReceiptPath(const FString& Id) const { return OperationsDir / (Id + TEXT(".receipt.json")); }
+    bool ValidId(const FString& Id) const { return UEAgentReliable::IsGuid(Id); }
+    TSharedPtr<FJsonObject> JobJson(const FJob& Job) const
+    {
+        if (Job.Result.IsValid()) return Job.Result;
+        auto Result = UEAgentReliable::Ok();
+        Result->SetStringField(TEXT("command_id"), Job.CommandId);
+        Result->SetStringField(TEXT("state"), Job.State);
+        if (Job.bDeadlineReported) Result->SetStringField(TEXT("notice"), TEXT("deadline exceeded; underlying operation still owns the writer"));
+        return Result;
+    }
+
+    TSharedPtr<FJsonObject> Submit(const TSharedPtr<FJsonObject>& Parameters)
+    {
+        using namespace UEAgentReliable;
+        const FString Id = JsonStringField(Parameters, TEXT("command_id")).ToLower();
+        if (!ValidId(Id)) return UEAgentReliable::Error(TEXT("INVALID_COMMAND_ID"), TEXT("Canonical UUID required"));
+        for (const TCHAR* Retired : { TEXT("expected_snapshots"), TEXT("payload_sha256"), TEXT("verify"), TEXT("lease_mode"), TEXT("fault_injection") })
+            if (Parameters->HasField(Retired)) return UEAgentReliable::Error(TEXT("RETIRED_ARGUMENT"), FString(Retired));
+        auto Job = MakeShared<FJob>();
+        Job->CommandId = Id;
+        Job->Request = CloneObject(Parameters);
+        Job->Request->RemoveField(TEXT("editor_epoch"));
+        Job->Request->RemoveField(TEXT("expected_project"));
+        Job->Request->SetStringField(TEXT("command_id"), Id);
+        Parameters->TryGetBoolField(TEXT("read_only"), Job->bReadOnly);
+        Parameters->TryGetBoolField(TEXT("save"), Job->bSave);
+        Parameters->TryGetBoolField(TEXT("allow_preexisting_dirty_save"), Job->bAllowDirty);
+        const TSharedPtr<FJsonObject>* Check = nullptr;
+        if (Parameters->TryGetObjectField(TEXT("readback"), Check)) Job->Readback = *Check;
+        if (Job->bSave && (Job->bReadOnly || !Job->Readback.IsValid()))
+            return UEAgentReliable::Error(TEXT("SAVE_REQUIRES_READBACK"), TEXT("Save needs a mutation and explicit targeted readback"));
+        if (Job->Readback.IsValid() && (!Job->Readback->HasField(TEXT("expect")) || JsonStringField(Job->Readback, TEXT("tool_name")).IsEmpty()))
+            return UEAgentReliable::Error(TEXT("INVALID_READBACK"), TEXT("readback requires tool_name and expect"));
+        const FString Tool = JsonStringField(Parameters, TEXT("tool_name"));
+        if (Tool.IsEmpty()) return UEAgentReliable::Error(TEXT("INVALID_TARGET"), TEXT("tool_name is required"));
+        if (IsSaveToolName(Tool)) return UEAgentReliable::Error(TEXT("USE_TASK_SAVE"), TEXT("Use task save, not a direct save tool"));
+        const auto Scopes = JsonStringArray(Parameters, TEXT("scopes"));
+        if (Scopes.Num() > MaxBatchItems) return UEAgentReliable::Error(TEXT("TOO_MANY_SCOPES"), TEXT("At most 64 scopes"));
+        for (const FString& Scope : Scopes)
+        {
+            if (Scope.StartsWith(TEXT("editor:"))) continue;
+            const FString Package = NormalizePackageScope(Scope);
+            if (Package.IsEmpty()) return UEAgentReliable::Error(TEXT("INVALID_SCOPE"), Scope);
+            Job->Packages.AddUnique(Package);
+        }
+        Job->Packages.Sort();
+        if (Job->bSave && Job->Packages.IsEmpty()) return UEAgentReliable::Error(TEXT("SAVE_SCOPE_REQUIRED"), TEXT("Declare exact packages to save"));
+        // Materialize once, before accepting. Durable identity includes actual attachment content.
+        if (auto AttachmentError = MaterializeAttachments(Job->Request); AttachmentError.IsValid()) return AttachmentError;
+        Job->RequestJson = CanonicalJson(Job->Request);
+        if (FTCHARToUTF8(*Job->RequestJson).Length() > MaxCommandBytes) return UEAgentReliable::Error(TEXT("COMMAND_TOO_LARGE"), TEXT("Request exceeds 8 MiB"));
+        if (const auto* Existing = Jobs.Find(Id))
+            return (*Existing)->RequestJson == Job->RequestJson ? JobJson(*(*Existing)) : UEAgentReliable::Error(TEXT("COMMAND_ID_REUSED"), Id);
+        if (auto Accepted = LoadObjectFile(RequestPath(Id)); Accepted.IsValid())
+        {
+            if (JsonStringField(Accepted, TEXT("request")) != Job->RequestJson) return UEAgentReliable::Error(TEXT("COMMAND_ID_REUSED"), Id);
+            auto Receipt = LoadObjectFile(ReceiptPath(Id));
+            return Receipt.IsValid() ? GetReceipt(Parameters) : UEAgentReliable::Error(TEXT("RESULT_UNKNOWN"), TEXT("Accepted record exists without terminal result; do not resend"));
+        }
+        if (FPaths::FileExists(OperationsDir / (Id + TEXT(".journal.ndjson")))) return UEAgentReliable::Error(TEXT("RESULT_UNKNOWN"), TEXT("Historic accepted command; inspect its result instead of executing again"));
+        if (FPaths::FileExists(ReceiptPath(Id))) return UEAgentReliable::Error(TEXT("COMMAND_ID_REUSED"), TEXT("An older task already owns this ID"));
+        if (Queue.Num() >= MaxQueuedJobs) return UEAgentReliable::Error(TEXT("QUEUE_FULL"), TEXT("256 queued tasks"));
+        double Timeout = 120000;
+        Parameters->TryGetNumberField(TEXT("timeout_ms"), Timeout);
+        Job->Deadline = FPlatformTime::Seconds() + FMath::Clamp(Timeout, 1000., 3600000.) / 1000.;
+        for (auto It = Jobs.CreateIterator(); It; ++It)
+            if (Jobs.Num() >= MaxQueuedJobs && It.Value()->bReadOnly && It.Value()->Result.IsValid()) It.RemoveCurrent();
+        if (Jobs.Num() >= MaxQueuedJobs) return UEAgentReliable::Error(TEXT("QUEUE_FULL"), TEXT("Too many pending reads or tasks"));
+        if (!Job->bReadOnly)
+        {
+            auto Record = Ok();
+            Record->SetStringField(TEXT("command_id"), Id);
+            Record->SetStringField(TEXT("editor_epoch"), EditorEpoch);
+            Record->SetStringField(TEXT("request"), Job->RequestJson);
+            if (!WriteObjectAtomic(RequestPath(Id), Record, false)) return UEAgentReliable::Error(TEXT("ACCEPT_WRITE_FAILED"), TEXT("No operation was dispatched"));
+        }
+        Jobs.Add(Id, Job);
+        if (Job->bReadOnly) Start(*Job);
+        else Queue.Add(Id);
+        return JobJson(*Job);
+    }
+
+    TSharedPtr<FJsonObject> MaterializeAttachments(const TSharedPtr<FJsonObject>& Request)
+    {
+        using namespace UEAgentReliable;
+        const TArray<TSharedPtr<FJsonValue>>* Attachments = nullptr;
+        if (!Request->TryGetArrayField(TEXT("attachments"), Attachments)) return nullptr;
+        const TSharedPtr<FJsonObject>* Original = nullptr;
+        auto Arguments = Request->TryGetObjectField(TEXT("arguments"), Original) ? CloneObject(*Original) : MakeShared<FJsonObject>();
+        int64 Total = 0;
+        for (const auto& Item : *Attachments)
+        {
+            if (!Item.IsValid() || Item->Type != EJson::Object) return UEAgentReliable::Error(TEXT("INVALID_ATTACHMENT"), TEXT("Object required"));
+            const auto Attachment = Item->AsObject();
+            const FString Argument = JsonStringField(Attachment, TEXT("argument"));
+            const FString Relative = JsonStringField(Attachment, TEXT("path"));
+            FString Path = FPaths::ConvertRelativePathToFull(InboxDir / Relative);
+            FPaths::NormalizeFilename(Path);
+            if (Argument.IsEmpty() || Relative.IsEmpty() || !FPaths::IsUnderDirectory(Path, InboxDir)) return UEAgentReliable::Error(TEXT("ATTACHMENT_PATH_DENIED"), Relative);
+            TArray<uint8> Bytes;
+            if (!FFileHelper::LoadFileToArray(Bytes, *Path)) return UEAgentReliable::Error(TEXT("ATTACHMENT_NOT_FOUND"), Relative);
+            Total += Bytes.Num();
+            if (Total > MaxCommandBytes || Bytes.Contains(0)) return UEAgentReliable::Error(TEXT("INVALID_ATTACHMENT"), TEXT("Attachment is too large or contains NUL"));
+            const FUTF8ToTCHAR Decoded(reinterpret_cast<const ANSICHAR*>(Bytes.GetData()), Bytes.Num());
+            const FString Text(Decoded.Length(), Decoded.Get());
+            const FTCHARToUTF8 RoundTrip(*Text);
+            if (RoundTrip.Length() != Bytes.Num() || (Bytes.Num() && FMemory::Memcmp(RoundTrip.Get(), Bytes.GetData(), Bytes.Num()) != 0)) return UEAgentReliable::Error(TEXT("INVALID_UTF8"), Relative);
+            Arguments->SetStringField(Argument, Text);
+        }
+        Request->SetObjectField(TEXT("arguments"), Arguments);
+        Request->RemoveField(TEXT("attachments"));
+        return nullptr;
+    }
+
+    bool Tick(float)
+    {
+        if (!bInitialized) return false;
+        if (!ActiveJobId.IsEmpty())
+        {
+            if (auto* Active = Jobs.Find(ActiveJobId); Active && FPlatformTime::Seconds() > (*Active)->Deadline) (*Active)->bDeadlineReported = true;
+        }
+        else if (!Queue.IsEmpty())
+        {
+            const FString Id = Queue[0]; Queue.RemoveAt(0);
+            if (auto* Job = Jobs.Find(Id)) Start(*(*Job));
+        }
+        return true;
+    }
+
+    void Start(FJob& Job)
+    {
+        if (!Job.bReadOnly)
+        {
+            ActiveJobId = Job.CommandId;
+            for (const FString& Name : Job.Packages)
+                if (UPackage* Package = FindPackage(nullptr, *Name); Package && Package->IsDirty()) Job.PreexistingDirty.Add(Name);
+        }
+        if (FPlatformTime::Seconds() > Job.Deadline)
+        { Job.Outcome = TEXT("failed"); Job.ErrorCode = TEXT("DEADLINE_EXCEEDED"); Job.ErrorMessage = TEXT("Task expired before dispatch"); Finalize(Job); return; }
+        Job.State = TEXT("running");
+        Dispatch(Job);
+    }
+
+    void Dispatch(FJob& Job)
+    {
+        using namespace UEAgentReliable;
+        const auto Target = Job.bChecking ? Job.Readback : Job.Request;
+        const FString Type = JsonStringField(Target, TEXT("target_type"));
+        const FString Tool = JsonStringField(Target, TEXT("tool_name"));
+        const TSharedPtr<FJsonObject>* ArgumentPointer = nullptr;
+        const auto Arguments = Target->TryGetObjectField(TEXT("arguments"), ArgumentPointer) ? *ArgumentPointer : MakeShared<FJsonObject>();
+        if (Type == TEXT("vibeue"))
+        {
+            TMap<FString, FString> Values;
+            for (const auto& Pair : Arguments->Values)
+                Values.Add(FString(Pair.Key), Pair.Value->Type == EJson::String ? Pair.Value->AsString() : CanonicalJson(Pair.Value));
+            FString Raw;
+            { FManagedMutationScope Managed; Raw = FToolRegistry::Get().ExecuteTool(Tool, Values); }
+            OnResult(Job.CommandId, true, Raw, FString());
+            return;
+        }
+        if (!Type.IsEmpty() && Type != TEXT("toolset")) { OnResult(Job.CommandId, false, FString(), TEXT("Unknown target_type")); return; }
+        UToolCallAsyncResultString* AsyncResult = nullptr;
+        { FManagedMutationScope Managed; AsyncResult = UToolsetRegistry::ExecuteTool(JsonStringField(Target, TEXT("toolset_name")), Tool, CanonicalJson(Arguments)); }
+        if (!AsyncResult) { OnResult(Job.CommandId, false, FString(), TEXT("ToolsetRegistry returned no result")); return; }
+        auto Handler = UToolCallAsyncResultFutureHandler::Create(AsyncResult);
+        Handler->GetValueAsJson().Next([this, Id = Job.CommandId](UE::ToolsetRegistry::FJsonValueOrError&& Result)
+        {
+            const bool Success = !Result.HasError();
+            FString Raw, Error;
+            if (!Success) Error = Result.GetError();
+            else if (Result.GetValue().IsValid() && !Result.GetValue()->TryGetString(Raw)) Raw = CanonicalJson(Result.GetValue());
+            AsyncTask(ENamedThreads::GameThread, [this, Id, Success, Raw = MoveTemp(Raw), Error = MoveTemp(Error)]()
+            { if (bInitialized) OnResult(Id, Success, Raw, Error); });
+        });
+    }
+
+    void OnResult(const FString& Id, bool Success, const FString& Raw, FString Error)
+    {
+        using namespace UEAgentReliable;
+        auto Job = Jobs.FindRef(Id);
+        if (!Job.IsValid() || Job->Result.IsValid()) return;
+        FString Normalized, SemanticError;
+        // A read of false is data. A mutation returning false is failure.
+        const bool SemanticSuccess = ResultIndicatesSuccess(BusinessResult(Raw), Normalized, SemanticError);
+        Success = Success && ((Job->bReadOnly || Job->bChecking) && Normalized == TEXT("false") ? true : SemanticSuccess);
+        if (Error.IsEmpty() && !Success) Error = SemanticError;
+        if (!Success)
+        {
+            Job->Outcome = Job->bReadOnly ? TEXT("failed") : TEXT("result_unknown");
+            Job->ErrorCode = TEXT("TOOL_FAILED"); Job->ErrorMessage = Error;
+            Finalize(*Job); return;
+        }
+        if (Job->bChecking)
+        {
+            Job->bVerified = Matches(ParseValue(Normalized), Job->Readback->TryGetField(TEXT("expect")));
+            if (!Job->bVerified) { Job->Outcome = TEXT("failed"); Job->ErrorCode = TEXT("READBACK_MISMATCH"); Job->ErrorMessage = Normalized; }
+            else Job->Outcome = TEXT("succeeded");
+            Finalize(*Job); return;
+        }
+        Job->RawResult = Normalized;
+        if (Job->Readback.IsValid()) { Job->bChecking = true; Job->State = TEXT("verifying"); Dispatch(*Job); return; }
+        Job->Outcome = TEXT("succeeded");
+        Finalize(*Job);
+    }
+
+    void Finalize(FJob& Job)
+    {
+        using namespace UEAgentReliable;
+        auto Result = Job.Outcome == TEXT("succeeded") ? Ok() : UEAgentReliable::Error(Job.ErrorCode, Job.ErrorMessage);
+        Result->SetStringField(TEXT("command_id"), Job.CommandId);
+        Result->SetStringField(TEXT("editor_epoch"), EditorEpoch);
+        Result->SetStringField(TEXT("state"), TEXT("terminal"));
+        Result->SetStringField(TEXT("outcome"), Job.Outcome);
+        Result->SetStringField(TEXT("verification"), Job.bVerified ? TEXT("verified") : TEXT("not_verified"));
+        Result->SetBoolField(TEXT("read_only"), Job.bReadOnly);
+        if (Job.bCancelRequested) Result->SetStringField(TEXT("notice"), TEXT("Underlying operation completed after cancellation; automatic save was skipped"));
+        TArray<TSharedPtr<FJsonValue>> Packages;
+        auto Generations = MakeShared<FJsonObject>();
+        bool CanSave = !Job.bReadOnly && Job.bVerified && Job.Outcome == TEXT("succeeded");
+        if (!Job.bAllowDirty && !Job.PreexistingDirty.IsEmpty()) CanSave = false;
+        for (const FString& Name : Job.Packages)
+            if (UPackage* Package = FindPackage(nullptr, *Name); Package && Package->IsDirty())
+            { Packages.Add(MakeShared<FJsonValueString>(Name)); Generations->SetNumberField(Name, PackageSaveGenerations.FindRef(Name)); }
+        Result->SetArrayField(TEXT("packages"), Packages);
+        Result->SetObjectField(TEXT("package_generations"), Generations);
+        Result->SetBoolField(TEXT("can_save"), CanSave && !Packages.IsEmpty());
+        Result->SetStringField(TEXT("persistence"), Packages.IsEmpty() ? TEXT("clean") : TEXT("dirty_not_saved"));
+        if (!Job.PreexistingDirty.IsEmpty() && !Job.bAllowDirty) Result->SetStringField(TEXT("save_blocked"), TEXT("preexisting_dirty"));
+        if (FTCHARToUTF8(*Job.RawResult).Length() <= MaxInlineResultBytes)
+        {
+            auto Value = ParseValue(Job.RawResult);
+            Result->SetField(TEXT("result"), Value.IsValid() ? Value : MakeShared<FJsonValueString>(Job.RawResult));
+        }
+        else
+        {
+            const FString Path = EvidenceDir / (Job.CommandId + TEXT(".result.json"));
+            if (!FFileHelper::SaveStringToFile(Job.RawResult, *Path, FFileHelper::EEncodingOptions::ForceUTF8WithoutBOM))
+            { Result->SetBoolField(TEXT("success"), false); Result->SetStringField(TEXT("outcome"), TEXT("result_unknown")); Result->SetStringField(TEXT("error_code"), TEXT("EVIDENCE_WRITE_FAILED")); Result->SetBoolField(TEXT("can_save"), false); }
+            else Result->SetStringField(TEXT("result_file"), Path);
+        }
+        if (Job.bSave && !Result->GetBoolField(TEXT("can_save")) && !Packages.IsEmpty() && Job.Outcome == TEXT("succeeded"))
+        { Result->SetBoolField(TEXT("success"), false); Result->SetStringField(TEXT("error_code"), TEXT("SAVE_NOT_AUTHORIZED")); }
+        Job.State = TEXT("terminal"); Job.Result = Result;
+        if (!Job.bReadOnly && !WriteObjectAtomic(ReceiptPath(Job.CommandId), Result, false))
+        { Result->SetBoolField(TEXT("success"), false); Result->SetStringField(TEXT("outcome"), TEXT("result_unknown")); Result->SetStringField(TEXT("error_code"), TEXT("RECEIPT_WRITE_FAILED")); Result->SetBoolField(TEXT("can_save"), false); }
+        Queue.Remove(Job.CommandId);
+        if (ActiveJobId == Job.CommandId) ActiveJobId.Reset();
+        if (Job.bSave && Result->GetBoolField(TEXT("can_save")))
+        {
+            auto Params = MakeShared<FJsonObject>(); Params->SetStringField(TEXT("command_id"), Job.CommandId);
+            auto Saved = Save(Params);
+            Result->SetObjectField(TEXT("save"), Saved);
+            bool SavedOk = false; Saved->TryGetBoolField(TEXT("success"), SavedOk);
+            if (!SavedOk) { Result->SetBoolField(TEXT("success"), false); Result->SetStringField(TEXT("outcome"), TEXT("result_unknown")); }
+            else Result->SetStringField(TEXT("persistence"), TEXT("saved"));
+        }
+        if (!Job.bReadOnly) Jobs.Remove(Job.CommandId);
+    }
+
+    TSharedPtr<FJsonObject> GetReceipt(const TSharedPtr<FJsonObject>& Parameters) const
+    {
+        using namespace UEAgentReliable;
+        const FString Id = JsonStringField(Parameters, TEXT("command_id")).ToLower();
+        if (!ValidId(Id)) return UEAgentReliable::Error(TEXT("INVALID_COMMAND_ID"), Id);
+        auto Result = LoadObjectFile(ReceiptPath(Id));
+        if (!Result.IsValid()) return UEAgentReliable::Error(TEXT("RECEIPT_NOT_FOUND"), Id);
+        auto Saved = LoadObjectFile(OperationsDir / (Id + TEXT(".save.receipt.json")));
+        if (Saved.IsValid())
+        {
+            Result->SetObjectField(TEXT("save"), Saved);
+            bool Ok = false; Saved->TryGetBoolField(TEXT("success"), Ok);
+            Result->SetBoolField(TEXT("success"), Ok);
+            Result->SetStringField(TEXT("persistence"), Ok ? TEXT("saved") : TEXT("unknown"));
+        }
+        else if (FPaths::FileExists(OperationsDir / (Id + TEXT(".save.started.json"))))
+        { Result->SetBoolField(TEXT("success"), false); Result->SetStringField(TEXT("persistence"), TEXT("unknown")); Result->SetStringField(TEXT("error_code"), TEXT("SAVE_RESULT_UNKNOWN")); }
+        return Result;
+    }
+    TSharedPtr<FJsonObject> GetJob(const TSharedPtr<FJsonObject>& Parameters) const
+    {
+        const FString Id = UEAgentReliable::JsonStringField(Parameters, TEXT("command_id")).ToLower();
+        if (const auto* Job = Jobs.Find(Id)) return JobJson(*(*Job));
+        return GetReceipt(Parameters);
+    }
+    TSharedPtr<FJsonObject> Cancel(const TSharedPtr<FJsonObject>& Parameters)
+    {
+        const FString Id = UEAgentReliable::JsonStringField(Parameters, TEXT("command_id")).ToLower();
+        auto Job = Jobs.FindRef(Id);
+        if (!Job.IsValid()) return GetReceipt(Parameters);
+        if (Job->Result.IsValid()) return Job->Result;
+        if (Queue.Remove(Id)) { Job->Outcome = TEXT("cancelled"); Job->ErrorCode = TEXT("CANCELLED"); Finalize(*Job); }
+        else { Job->bCancelRequested = true; Job->bSave = false; Job->State = TEXT("cancelling"); }
+        return JobJson(*Job);
+    }
+
+    TSharedPtr<FJsonObject> Save(const TSharedPtr<FJsonObject>& Parameters)
+    {
+        using namespace UEAgentReliable;
+        const FString Id = JsonStringField(Parameters, TEXT("command_id")).ToLower();
+        if (!ValidId(Id)) return UEAgentReliable::Error(TEXT("INVALID_COMMAND_ID"), Id);
+        const FString SavedPath = OperationsDir / (Id + TEXT(".save.receipt.json"));
+        if (auto Previous = LoadObjectFile(SavedPath); Previous.IsValid()) return Previous;
+        const FString StartedPath = OperationsDir / (Id + TEXT(".save.started.json"));
+        if (FPaths::FileExists(StartedPath)) return UEAgentReliable::Error(TEXT("SAVE_RESULT_UNKNOWN"), TEXT("Save was started; do not save again automatically"));
+        if (!ActiveJobId.IsEmpty()) return UEAgentReliable::Error(TEXT("EDITOR_BUSY"), TEXT("A writer is active"));
+        auto Receipt = LoadObjectFile(ReceiptPath(Id));
+        bool CanSave = false;
+        if (!Receipt.IsValid() || !Receipt->TryGetBoolField(TEXT("can_save"), CanSave) || !CanSave) return UEAgentReliable::Error(TEXT("SAVE_NOT_AUTHORIZED"), Id);
+        if (JsonStringField(Receipt, TEXT("editor_epoch")) != EditorEpoch) return UEAgentReliable::Error(TEXT("EDITOR_CHANGED"), TEXT("Previous-epoch dirty state is not a save authorization"));
+        const auto Names = JsonStringArray(Receipt, TEXT("packages"));
+        auto Requested = JsonStringArray(Parameters, TEXT("packages")); Requested.Sort();
+        if (!Requested.IsEmpty() && Requested != Names) return UEAgentReliable::Error(TEXT("PACKAGE_SET_MISMATCH"), Id);
+        const auto Generations = Receipt->GetObjectField(TEXT("package_generations"));
+        TArray<UPackage*> Packages;
+        for (const FString& Name : Names)
+        {
+            if (PackageSaveGenerations.FindRef(Name) != static_cast<int64>(Generations->GetNumberField(Name))) return UEAgentReliable::Error(TEXT("OUT_OF_BAND_SAVE"), Name);
+            UPackage* Package = FindPackage(nullptr, *Name);
+            if (!Package || !Package->IsDirty()) return UEAgentReliable::Error(TEXT("PACKAGE_NOT_DIRTY"), Name);
+            Packages.Add(Package);
+        }
+        if (!WriteObjectAtomic(StartedPath, Parameters, false)) return UEAgentReliable::Error(TEXT("SAVE_RECORD_WRITE_FAILED"), TEXT("No save dispatched"));
+        bool Saved = UEditorLoadingAndSavingUtils::SavePackages(Packages, false);
+        for (UPackage* Package : Packages) Saved &= Package && !Package->IsDirty();
+        auto Result = Saved ? Ok() : UEAgentReliable::Error(TEXT("SAVE_RESULT_UNKNOWN"), TEXT("Native save did not confirm all packages clean"));
+        Result->SetStringField(TEXT("command_id"), Id);
+        Result->SetArrayField(TEXT("packages"), Receipt->GetArrayField(TEXT("packages")));
+        Result->SetStringField(TEXT("persistence"), Saved ? TEXT("saved") : TEXT("unknown"));
+        if (!WriteObjectAtomic(SavedPath, Result, false)) return UEAgentReliable::Error(TEXT("SAVE_RESULT_UNKNOWN"), TEXT("Save may have completed; result record could not be written"));
+        return Result;
+    }
+
+    TSharedPtr<FJsonObject> RecoverIncomplete(bool)
+    {
+        using namespace UEAgentReliable;
+        TArray<FString> Files;
+        IFileManager::Get().FindFiles(Files, *(OperationsDir / TEXT("*.request.json")), true, false);
+        for (FString File : Files)
+        {
+            File.RemoveFromEnd(TEXT(".request.json"));
+            if (!ValidId(File) || Jobs.Contains(File) || FPaths::FileExists(ReceiptPath(File))) continue;
+            auto Result = UEAgentReliable::Error(TEXT("RESULT_UNKNOWN"), TEXT("Accepted task has no terminal result; inspect exact state before a new operation"));
+            Result->SetStringField(TEXT("command_id"), File);
+            Result->SetStringField(TEXT("state"), TEXT("terminal"));
+            Result->SetStringField(TEXT("outcome"), TEXT("result_unknown"));
+            Result->SetBoolField(TEXT("can_save"), false);
+            if (!WriteObjectAtomic(ReceiptPath(File), Result, false)) return UEAgentReliable::Error(TEXT("RECOVERY_WRITE_FAILED"), File);
+        }
+        return Ok();
+    }
+
+	FSnapshot CaptureSnapshot(const FString& Scope, bool bIncludeValues) const
+	{
+		FSnapshot Snapshot;
+		Snapshot.Scope = Scope;
+		Snapshot.Data = MakeShared<FJsonObject>();
+		Snapshot.Data->SetStringField(TEXT("scope"), Scope);
+		auto Finish = [&Snapshot, bIncludeValues]()
+		{
+			if (!Snapshot.Error.IsEmpty()) return;
+			Snapshot.Data->SetNumberField(TEXT("property_count"), Snapshot.PropertyCount);
+			const FString Canonical = UEAgentReliable::CanonicalJson(Snapshot.Data);
+			const FTCHARToUTF8 Utf8(*Canonical);
+			Snapshot.Bytes = Utf8.Length();
+			if (Snapshot.Bytes > UEAgentReliable::MaxSnapshotBytes)
+			{
+				Snapshot.Error = TEXT("authoritative snapshot exceeds 8 MiB: ") + Snapshot.Scope;
+				return;
+			}
+			if (!bIncludeValues) Snapshot.Data->RemoveField(TEXT("properties"));
+			Snapshot.Data->SetNumberField(TEXT("snapshot_bytes"), Snapshot.Bytes);
+		};
+
+		if (Scope.StartsWith(TEXT("editor:"), ESearchCase::IgnoreCase))
+		{
+			CaptureEditorSnapshot(Scope.ToLower(), Snapshot);
+			Finish();
+			return Snapshot;
+		}
+
+		Snapshot.PackageName = UEAgentReliable::NormalizePackageScope(Scope);
+		if (Snapshot.PackageName.IsEmpty())
+		{
+			Snapshot.Error = TEXT("invalid package/object scope: ") + Scope;
+			return Snapshot;
+		}
+		Snapshot.ObjectPath = UEAgentReliable::ObjectPathForScope(Scope, Snapshot.PackageName);
+		UPackage* Package = FindPackage(nullptr, *Snapshot.PackageName);
+		if (!Package) Package = LoadPackage(nullptr, *Snapshot.PackageName, LOAD_NoWarn);
+		if (!Package)
+		{
+			Snapshot.SaveGeneration = PackageSaveGenerations.FindRef(Snapshot.PackageName);
+			Snapshot.Data->SetStringField(TEXT("package"), Snapshot.PackageName);
+			Snapshot.Data->SetStringField(TEXT("object"), Snapshot.ObjectPath);
+			Snapshot.Data->SetBoolField(TEXT("exists"), false);
+			Snapshot.Data->SetBoolField(TEXT("dirty"), false);
+			Snapshot.Data->SetNumberField(TEXT("save_generation"), static_cast<double>(Snapshot.SaveGeneration));
+			Finish();
+			return Snapshot;
+		}
+		UObject* Object = StaticFindObject(UObject::StaticClass(), nullptr, *Snapshot.ObjectPath);
+		// A package scope may resolve its primary asset. An explicit object scope must never
+		// silently turn a missing CDO/subobject into a successful snapshot of another object.
+		if (!Object && !Scope.StartsWith(TEXT("object:"), ESearchCase::IgnoreCase))
+		{
+			Object = Package->FindAssetInPackage();
+		}
+		if (!Object)
+		{
+			Snapshot.bDirty = Package->IsDirty();
+			Snapshot.SaveGeneration = PackageSaveGenerations.FindRef(Snapshot.PackageName);
+			Snapshot.Data->SetStringField(TEXT("package"), Snapshot.PackageName);
+			Snapshot.Data->SetStringField(TEXT("object"), Snapshot.ObjectPath);
+			Snapshot.Data->SetBoolField(TEXT("exists"), false);
+			Snapshot.Data->SetBoolField(TEXT("dirty"), Snapshot.bDirty);
+			Snapshot.Data->SetNumberField(TEXT("save_generation"), static_cast<double>(Snapshot.SaveGeneration));
+			Finish();
+			return Snapshot;
+		}
+
+		Snapshot.ObjectPath = Object->GetPathName();
+		Snapshot.bDirty = Package->IsDirty();
+		Snapshot.SaveGeneration = PackageSaveGenerations.FindRef(Snapshot.PackageName);
+		Snapshot.Data->SetStringField(TEXT("package"), Snapshot.PackageName);
+		Snapshot.Data->SetStringField(TEXT("object"), Snapshot.ObjectPath);
+		Snapshot.Data->SetBoolField(TEXT("exists"), true);
+		Snapshot.Data->SetStringField(TEXT("class"), Object->GetClass()->GetPathName());
+		Snapshot.Data->SetBoolField(TEXT("dirty"), Snapshot.bDirty);
+		Snapshot.Data->SetNumberField(TEXT("save_generation"), static_cast<double>(Snapshot.SaveGeneration));
+
+		FString Filename;
+		if (FPackageName::DoesPackageExist(Snapshot.PackageName, &Filename))
+		{
+			Snapshot.Data->SetNumberField(TEXT("file_size"), static_cast<double>(IFileManager::Get().FileSize(*Filename)));
+			Snapshot.Data->SetStringField(TEXT("file_timestamp"), IFileManager::Get().GetTimeStamp(*Filename).ToIso8601());
+		}
+
+		if (!bIncludeValues) { Finish(); return Snapshot; }
+		TSharedPtr<FJsonObject> Properties = MakeShared<FJsonObject>();
+		int32 TotalCharacters = 0;
+		TArray<FProperty*> SortedProperties;
+		for (TFieldIterator<FProperty> It(Object->GetClass(), EFieldIteratorFlags::IncludeSuper); It; ++It)
+		{
+			FProperty* Property = *It;
+			if (!Property || Property->HasAnyPropertyFlags(CPF_Transient | CPF_DuplicateTransient | CPF_Deprecated)) continue;
+			SortedProperties.Add(Property);
+		}
+		SortedProperties.Sort([](const FProperty& Left, const FProperty& Right)
+		{
+			return Left.GetName() < Right.GetName();
+		});
+		for (FProperty* Property : SortedProperties)
+		{
+			FString Value;
+			Property->ExportText_InContainer(0, Value, Object, Object, Object, PPF_Copy);
+			TotalCharacters += Property->GetName().Len() + Value.Len();
+			if (TotalCharacters * sizeof(TCHAR) > UEAgentReliable::MaxSnapshotBytes)
+			{
+				Snapshot.Error = TEXT("authoritative snapshot exceeds 8 MiB: ") + Scope;
+				return Snapshot;
+			}
+			Properties->SetStringField(Property->GetName(), Value);
+			++Snapshot.PropertyCount;
+		}
+		Snapshot.Data->SetObjectField(TEXT("properties"), Properties);
+		Finish();
+		return Snapshot;
+	}
+
+	void CaptureEditorSnapshot(const FString& Scope, FSnapshot& Snapshot) const
+	{
+		if (Scope == TEXT("editor:world"))
+		{
+			UWorld* World = GEditor ? GEditor->GetEditorWorldContext().World() : nullptr;
+			if (!World) { Snapshot.Error = TEXT("editor world unavailable"); return; }
+			TArray<FString> ActorPaths;
+			for (TActorIterator<AActor> It(World); It && ActorPaths.Num() < 100000; ++It) ActorPaths.Add(It->GetPathName());
+			ActorPaths.Sort();
+			TArray<TSharedPtr<FJsonValue>> Actors;
+			for (const FString& Path : ActorPaths) Actors.Add(MakeShared<FJsonValueString>(Path));
+			Snapshot.Data->SetStringField(TEXT("world"), World->GetPathName());
+			Snapshot.Data->SetArrayField(TEXT("actors"), Actors);
+			Snapshot.PackageName = World->GetOutermost()->GetName();
+			Snapshot.bDirty = World->GetOutermost()->IsDirty();
+			Snapshot.Data->SetBoolField(TEXT("dirty"), Snapshot.bDirty);
+			return;
+		}
+		if (Scope == TEXT("editor:selection"))
+		{
+			TArray<FString> Paths;
+			if (GEditor && GEditor->GetSelectedActors())
+			{
+				for (FSelectionIterator It(*GEditor->GetSelectedActors()); It; ++It)
+					if (UObject* Object = Cast<UObject>(*It)) Paths.Add(Object->GetPathName());
+			}
+			Paths.Sort();
+			TArray<TSharedPtr<FJsonValue>> Values;
+			for (const FString& Path : Paths) Values.Add(MakeShared<FJsonValueString>(Path));
+			Snapshot.Data->SetArrayField(TEXT("selected"), Values);
+			return;
+		}
+		if (Scope == TEXT("editor:viewport"))
+		{
+			if (!GCurrentLevelEditingViewportClient) { Snapshot.Error = TEXT("level viewport unavailable"); return; }
+			const FVector Location = GCurrentLevelEditingViewportClient->GetViewLocation();
+			const FRotator Rotation = GCurrentLevelEditingViewportClient->GetViewRotation();
+			Snapshot.Data->SetStringField(TEXT("location"), Location.ToString());
+			Snapshot.Data->SetStringField(TEXT("rotation"), Rotation.ToString());
+			Snapshot.Data->SetBoolField(TEXT("realtime"), GCurrentLevelEditingViewportClient->IsRealtime());
+			return;
+		}
+		Snapshot.Error = TEXT("unsupported editor scope: ") + Scope;
+	}
+
+	TSharedPtr<FJsonObject> SnapshotRequest(const TSharedPtr<FJsonObject>& Parameters) const
+	{
+		const TArray<FString> Scopes = UEAgentReliable::JsonStringArray(Parameters, TEXT("scopes"));
+		if (Scopes.IsEmpty() || Scopes.Num() > UEAgentReliable::MaxBatchItems)
+			return UEAgentReliable::Error(TEXT("INVALID_SCOPES"), TEXT("provide 1-64 scopes"));
+		bool bIncludeValues = false;
+		if (Parameters.IsValid()) Parameters->TryGetBoolField(TEXT("include_values"), bIncludeValues);
+		TSharedPtr<FJsonObject> Result = UEAgentReliable::Ok();
+		Result->SetStringField(TEXT("editor_epoch"), EditorEpoch);
+		TArray<TSharedPtr<FJsonValue>> Values;
+		for (const FString& Scope : Scopes)
+		{
+			FSnapshot Snapshot = CaptureSnapshot(Scope, bIncludeValues);
+			if (!Snapshot.Error.IsEmpty())
+			{
+				TSharedPtr<FJsonObject> Failure = UEAgentReliable::Error(TEXT("SNAPSHOT_FAILED"), Snapshot.Error);
+				Failure->SetStringField(TEXT("scope"), Scope);
+				Values.Add(MakeShared<FJsonValueObject>(Failure));
+			}
+			else Values.Add(MakeShared<FJsonValueObject>(Snapshot.Data));
+		}
+		Result->SetArrayField(TEXT("snapshots"), Values);
+		return Result;
+	}
+
+	TSharedPtr<FJsonObject> BatchRead(const TSharedPtr<FJsonObject>& Parameters) const
+	{
+		const TArray<TSharedPtr<FJsonValue>>* Requests = nullptr;
+		if (!Parameters.IsValid() || !Parameters->TryGetArrayField(TEXT("requests"), Requests)
+			|| !Requests || Requests->IsEmpty() || Requests->Num() > UEAgentReliable::MaxBatchItems)
+		{
+			return UEAgentReliable::Error(TEXT("INVALID_BATCH"), TEXT("requests must contain 1-64 bounded read requests"));
+		}
+		TSharedPtr<FJsonObject> Result = UEAgentReliable::Ok();
+		Result->SetStringField(TEXT("editor_epoch"), EditorEpoch);
+		TArray<TSharedPtr<FJsonValue>> Results;
+		int32 ApproximateBytes = 0;
+		for (const TSharedPtr<FJsonValue>& Value : *Requests)
+		{
+			if (!Value.IsValid() || Value->Type != EJson::Object)
+			{
+				Results.Add(MakeShared<FJsonValueObject>(UEAgentReliable::Error(TEXT("INVALID_READ"), TEXT("request must be an object"))));
+				continue;
+			}
+			const TSharedPtr<FJsonObject> Request = Value->AsObject();
+			const FString Kind = UEAgentReliable::JsonStringField(Request, TEXT("kind")).ToLower();
+			TSharedPtr<FJsonObject> Item;
+			if (Kind == TEXT("snapshot")) Item = SnapshotRequest(Request);
+			else if (Kind == TEXT("job")) Item = GetJob(Request);
+			else if (Kind == TEXT("receipt")) Item = GetReceipt(Request);
+			else if (Kind == TEXT("state")) Item = State();
+			else Item = UEAgentReliable::Error(TEXT("READ_KIND_DENIED"), TEXT("kind must be snapshot, job, receipt, or state"));
+			const FTCHARToUTF8 ItemUtf8(*UEAgentReliable::CanonicalJson(Item));
+			ApproximateBytes += ItemUtf8.Length();
+			if (ApproximateBytes > UEAgentReliable::MaxSnapshotBytes)
+			{
+				Results.Add(MakeShared<FJsonValueObject>(UEAgentReliable::Error(TEXT("BATCH_LIMIT"), TEXT("batch response exceeded 8 MiB"))));
+				break;
+			}
+			Results.Add(MakeShared<FJsonValueObject>(Item));
+		}
+		Result->SetArrayField(TEXT("results"), Results);
+		return Result;
+	}
+	bool WriteObjectAtomic(const FString& Path, const TSharedPtr<FJsonObject>& Object, bool bReplace) const
+	{
+		if (!bReplace && FPaths::FileExists(Path)) return false;
+		const FString Temp = Path + TEXT(".tmp.") + FGuid::NewGuid().ToString(EGuidFormats::Digits);
+		if (!FFileHelper::SaveStringToFile(UEAgentReliable::CanonicalJson(Object), *Temp,
+			FFileHelper::EEncodingOptions::ForceUTF8WithoutBOM)) return false;
+		if (!IFileManager::Get().Move(*Path, *Temp, bReplace, true, false, true))
+		{
+			IFileManager::Get().Delete(*Temp, false, true);
+			return false;
+		}
+		return true;
+	}
+	TSharedPtr<FJsonObject> LoadObjectFile(const FString& Path) const
+	{
+		FString Json;
+		TSharedPtr<FJsonObject> Object;
+		return FFileHelper::LoadFileToString(Json, *Path) && UEAgentReliable::ParseObject(Json, Object) ? Object : nullptr;
+	}
+
+private:
+    bool bInitialized = false, bEnabled = false;
+    FString EditorEpoch, OperationsDir, EvidenceDir, InboxDir, ActiveJobId;
+    TArray<FString> Queue;
+    TMap<FString, TSharedPtr<FJob>> Jobs;
+    TMap<FString, int64> PackageSaveGenerations;
+    FTSTicker::FDelegateHandle TickerHandle;
+    FDelegateHandle PackageSavedHandle;
+};
