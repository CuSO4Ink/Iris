+FString UNiagaraToolset_Component::GetRuntimeState(UNiagaraComponent* Component)
+{
+	if (!ValidateComponent(Component))
+	{
+		return {};
+	}
+
+	TSharedRef<FJsonObject> Root = MakeShared<FJsonObject>();
+	Root->SetStringField(TEXT("component"), Component->GetPathName());
+	Root->SetStringField(TEXT("system"), GetPathNameSafe(Component->GetAsset()));
+	Root->SetBoolField(TEXT("componentActive"), Component->IsActive());
+	Root->SetBoolField(TEXT("componentComplete"), Component->IsComplete());
+
+	FNiagaraSystemInstanceControllerPtr Controller = Component->GetSystemInstanceController();
+	Root->SetBoolField(TEXT("controllerValid"), Controller.IsValid() && Controller->IsValid());
+	if (Controller.IsValid() && Controller->IsValid())
+	{
+		Controller->WaitForConcurrentTickAndFinalize();
+		Root->SetStringField(TEXT("requestedState"), UEnum::GetValueAsString(Controller->GetRequestedExecutionState()));
+		Root->SetStringField(TEXT("actualState"), UEnum::GetValueAsString(Controller->GetActualExecutionState()));
+		Root->SetNumberField(TEXT("ageSeconds"), Controller->GetAge());
+
+		const FBox& Bounds = Controller->GetLocalBounds();
+		TSharedRef<FJsonObject> BoundsJson = MakeShared<FJsonObject>();
+		BoundsJson->SetBoolField(TEXT("valid"), Bounds.IsValid != 0);
+		BoundsJson->SetStringField(TEXT("min"), Bounds.Min.ToString());
+		BoundsJson->SetStringField(TEXT("max"), Bounds.Max.ToString());
+		Root->SetObjectField(TEXT("localBounds"), BoundsJson);
+
+		TArray<TSharedPtr<FJsonValue>> Emitters;
+		if (FNiagaraSystemInstance* Instance = Controller->GetSystemInstance_Unsafe())
+		{
+			for (const FNiagaraEmitterInstanceRef& Emitter : Instance->GetEmitters())
+			{
+				TSharedRef<FJsonObject> EmitterJson = MakeShared<FJsonObject>();
+				EmitterJson->SetStringField(TEXT("name"), Emitter->GetEmitterHandle().GetUniqueInstanceName());
+				EmitterJson->SetStringField(TEXT("executionState"), UEnum::GetValueAsString(Emitter->GetExecutionState()));
+				EmitterJson->SetStringField(TEXT("simTarget"), UEnum::GetValueAsString(Emitter->GetSimTarget()));
+				EmitterJson->SetNumberField(TEXT("numParticles"), Emitter->GetNumParticles());
+				Emitters.Add(MakeShared<FJsonValueObject>(EmitterJson));
+			}
+		}
+		Root->SetArrayField(TEXT("emitters"), Emitters);
+	}
+
+	FString Json;
+	TSharedRef<TJsonWriter<>> Writer = TJsonWriterFactory<>::Create(&Json);
+	FJsonSerializer::Serialize(Root, Writer);
+	return Json;
+}
