-		for (const FLandscapeInfoLayerSettings& LayerSettings : LandscapeInfo->Layers)
-		{
-			if (LayerSettings.LayerInfoObj &&
-				LayerSettings.LayerInfoObj->GetLayerName().ToString().Equals(LayerName, ESearchCase::IgnoreCase))
