+			TEXT("VibeUE.NiagaraService.ListRapidIterationParams"),
+			TEXT("VibeUE.NiagaraService.GetEmitterLifecycle"),
+			TEXT("VibeUE.NiagaraEmitterService.GetColorCurveKeys"),
+			TEXT("VibeUE.NiagaraEmitterService.GetRapidIterationParameters"),
+			TEXT("VibeUE.NiagaraScratchPadService.GetScratchScriptPath"),
+			TEXT("VibeUE.NiagaraScratchPadService.ListScratchModules"),
+			TEXT("VibeUE.NiagaraScratchPadService.ListNodes"),
+			TEXT("VibeUE.NiagaraScratchPadService.GetNodePins"),
+			TEXT("VibeUE.NiagaraScratchPadService.ListConnections"),
+			TEXT("VibeUE.NiagaraScratchPadService.GetCustomHlslCode"),
+			TEXT("VibeUE.NiagaraScratchPadService.GetCompileMessages"),
+			TEXT("VibeUE.PerformanceService.FrameTiming"),
+			TEXT("VibeUE.PerformanceService.ReadMonitor"),
+			TEXT("VibeUE.PerformanceService.GetTraceStatus"),
+			TEXT("VibeUE.PerformanceService.Analyse"),
+			TEXT("VibeUE.PerformanceService.GetStandaloneStatus"),
+		};
+		for (const TCHAR* Name : BuiltIn) ReadOnlyTools.Add(FString(Name).ToLower());
+
+		TArray<FString> Configured;
+		if (GConfig) GConfig->GetArray(UEAgentReliable::ConfigSection, TEXT("ReadOnlyTools"), Configured, GEditorIni);
+		for (FString Name : Configured)
+		{
+			Name.TrimStartAndEndInline();
+			if (!Name.IsEmpty()) ReadOnlyTools.Add(Name.ToLower());
+		}
+	}
+
+	TSharedPtr<FJsonObject> State() const
+	{
+		TSharedPtr<FJsonObject> Result = UEAgentReliable::Ok();
+		Result->SetStringField(TEXT("protocol_version"), UEAgentReliable::ProtocolVersion);
+		Result->SetBoolField(TEXT("enabled"), bEnabled.Load());
+		Result->SetStringField(TEXT("editor_epoch"), EditorEpoch);
+		Result->SetNumberField(TEXT("editor_pid"), static_cast<double>(FPlatformProcess::GetCurrentProcessId()));
+		Result->SetStringField(TEXT("project"), FApp::GetProjectName());
+		Result->SetStringField(TEXT("engine_version"), FEngineVersion::Current().ToString());
+		Result->SetStringField(TEXT("active_command_id"), ActiveJobId);
+		Result->SetStringField(TEXT("last_receipt_id"), LastReceiptId);
+		Result->SetBoolField(TEXT("performance_frozen"), IsPerformanceFrozen());
+
+		TArray<TSharedPtr<FJsonValue>> Queued;
+		for (const FString& Id : Queue) Queued.Add(MakeShared<FJsonValueString>(Id));
+		Result->SetArrayField(TEXT("queued_command_ids"), Queued);
+
+		TArray<TSharedPtr<FJsonValue>> Leases;
+		for (const auto& Pair : ActiveLeases)
+		{
+			TSharedPtr<FJsonObject> Lease = MakeShared<FJsonObject>();
+			Lease->SetStringField(TEXT("scope"), Pair.Key);
+			Lease->SetStringField(TEXT("command_id"), Pair.Value);
+			Leases.Add(MakeShared<FJsonValueObject>(Lease));
+		}
+		Result->SetArrayField(TEXT("leases"), Leases);
+
+		TArray<FString> DirtyNames;
+		int32 DirtyPackageCount = 0;
+		for (TObjectIterator<UPackage> It; It; ++It)
+		{
+			UPackage* Package = *It;
+			if (Package && Package->IsDirty()
+				&& Package != GetTransientPackage()
+				&& !Package->HasAnyPackageFlags(PKG_CompiledIn)
+				&& FPackageName::IsValidLongPackageName(Package->GetName(), true))
+			{
+				++DirtyPackageCount;
+				if (DirtyNames.Num() < 256) DirtyNames.Add(Package->GetName());
+			}
+		}
+		DirtyNames.Sort();
+		TArray<TSharedPtr<FJsonValue>> Dirty;
+		for (const FString& Name : DirtyNames) Dirty.Add(MakeShared<FJsonValueString>(Name));
+		Result->SetArrayField(TEXT("dirty_packages"), Dirty);
+		Result->SetNumberField(TEXT("dirty_package_count"), DirtyPackageCount);
+		Result->SetBoolField(TEXT("dirty_packages_truncated"), DirtyPackageCount > DirtyNames.Num());
+		Result->SetNumberField(TEXT("job_count"), Jobs.Num());
+		Result->SetNumberField(TEXT("read_only_tool_count"), ReadOnlyTools.Num());
+		return Result;
+	}
+
+	TSharedPtr<FJsonObject> Submit(const TSharedPtr<FJsonObject>& Parameters, bool bPerformance)
+	{
+		if (!Parameters.IsValid()) return UEAgentReliable::Error(TEXT("INVALID_REQUEST"), TEXT("Parameters are required"));
+		const FString CommandId = UEAgentReliable::JsonStringField(Parameters, TEXT("command_id"));
+		if (!UEAgentReliable::IsGuid(CommandId))
+		{
+			return UEAgentReliable::Error(TEXT("INVALID_COMMAND_ID"), TEXT("command_id must be a canonical hyphenated UUID"));
+		}
+
+		TSharedPtr<FJob> Job = MakeShared<FJob>();
+		Job->CommandId = CommandId.ToLower();
+		Job->AcceptedAt = FDateTime::UtcNow();
+		Job->bPerformanceProfile = bPerformance;
+		Job->FaultInjection = UEAgentReliable::JsonStringField(Parameters, TEXT("fault_injection")).ToLower();
+		if (!Job->FaultInjection.IsEmpty() && !bFaultInjectionEnabled)
+		{
+			return UEAgentReliable::Error(TEXT("FAULT_INJECTION_DISABLED"), TEXT("EnableFaultInjection is false"));
+		}
+		if (!Job->FaultInjection.IsEmpty()
+			&& Job->FaultInjection != TEXT("after_accept")
+			&& Job->FaultInjection != TEXT("before_execute")
+			&& Job->FaultInjection != TEXT("after_execute")
+			&& Job->FaultInjection != TEXT("before_receipt"))
+		{
+			return UEAgentReliable::Error(TEXT("INVALID_FAULT_INJECTION"), TEXT("fault_injection must be after_accept, before_execute, after_execute, or before_receipt"));
+		}
+
+		if (bPerformance)
+		{
+			Job->TargetType = TEXT("profile_gpu");
+			Job->ToolName = TEXT("ProfileGPU");
+			Job->LeaseMode = TEXT("performance");
+			Job->VerifyMode = TEXT("success");
+			Parameters->TryGetNumberField(TEXT("warmup_frames"), Job->WarmupFrames);
+			Parameters->TryGetNumberField(TEXT("sample_frames"), Job->SampleFrames);
+			double Number = Job->TargetFPS;
+			if (Parameters->TryGetNumberField(TEXT("target_fps"), Number)) Job->TargetFPS = static_cast<float>(Number);
+			Number = Job->HitchThresholdMs;
+			if (Parameters->TryGetNumberField(TEXT("hitch_threshold_ms"), Number)) Job->HitchThresholdMs = static_cast<float>(Number);
+			Job->WarmupFrames = FMath::Clamp(Job->WarmupFrames, 0, 600);
+			Job->SampleFrames = FMath::Clamp(Job->SampleFrames, 30, 3600);
+			Job->TargetFPS = FMath::Clamp(Job->TargetFPS, 1.0f, 1000.0f);
+			Job->HitchThresholdMs = FMath::Clamp(Job->HitchThresholdMs, 1.0f, 10000.0f);
+		}
+		else
+		{
+			Job->TargetType = UEAgentReliable::JsonStringField(Parameters, TEXT("target_type")).ToLower();
+			Job->ToolsetName = UEAgentReliable::JsonStringField(Parameters, TEXT("toolset_name"));
+			Job->ToolName = UEAgentReliable::JsonStringField(Parameters, TEXT("tool_name"));
+			Job->LeaseMode = UEAgentReliable::JsonStringField(Parameters, TEXT("lease_mode")).ToLower();
+			Job->VerifyMode = UEAgentReliable::JsonStringField(Parameters, TEXT("verify")).ToLower();
+			Parameters->TryGetBoolField(TEXT("allow_preexisting_dirty_save"), Job->bAllowPreexistingDirtySave);
+			if (Job->TargetType.IsEmpty()) Job->TargetType = TEXT("toolset");
+			if (Job->LeaseMode.IsEmpty()) Job->LeaseMode = TEXT("scoped");
+			if (Job->VerifyMode.IsEmpty()) Job->VerifyMode = TEXT("changed_or_noop");
+			if (Job->ToolName.IsEmpty()
+				|| (Job->TargetType != TEXT("toolset") && Job->TargetType != TEXT("vibeue"))
+				|| (Job->TargetType == TEXT("toolset") && Job->ToolsetName.IsEmpty()))
+			{
+				return UEAgentReliable::Error(TEXT("INVALID_TARGET"), TEXT("target_type, toolset_name (for toolset), and tool_name are required"));
+			}
+			if (Job->VerifyMode != TEXT("changed_or_noop")
+				&& Job->VerifyMode != TEXT("changed")
+				&& Job->VerifyMode != TEXT("unchanged")
+				&& Job->VerifyMode != TEXT("success"))
+			{
+				return UEAgentReliable::Error(TEXT("INVALID_VERIFY_MODE"), TEXT("verify must be changed_or_noop, changed, unchanged, or success"));
+			}
+			if (UEAgentReliable::IsSaveToolName(Job->ToolName))
+			{
+				return UEAgentReliable::Error(TEXT("SAVE_REQUIRES_TOKEN"), TEXT("Direct save/apply tools are disabled; mutate first, then call ueagent_save with the issued token"));
+			}
+			if (Job->TargetType == TEXT("vibeue"))
+			{
+				const FToolMetadata* Tool = FToolRegistry::Get().FindTool(Job->ToolName);
+				if (!Tool) return UEAgentReliable::Error(TEXT("TOOL_NOT_FOUND"), Job->ToolName);
+				if (Tool->Category.Equals(TEXT("Python"), ESearchCase::IgnoreCase))
+				{
+					return UEAgentReliable::Error(TEXT("PYTHON_MUTATION_DISABLED"), TEXT("Python is not a reliable mutation transport; use a typed ToolsetRegistry service"));
+				}
+			}
+
+			const TSharedPtr<FJsonObject>* Arguments = nullptr;
+			if (Parameters->TryGetObjectField(TEXT("arguments"), Arguments) && Arguments && Arguments->IsValid())
+			{
+				Job->Arguments = UEAgentReliable::CloneObject(*Arguments);
+			}
+			else
+			{
+				Job->Arguments = MakeShared<FJsonObject>();
+			}
+			if (TSharedPtr<FJsonObject> AttachmentError = MaterializeAttachments(Parameters, *Job); AttachmentError.IsValid())
+			{
+				return AttachmentError;
+			}
+
+			Job->Scopes = UEAgentReliable::JsonStringArray(Parameters, TEXT("scopes"));
+			if (Job->Scopes.Num() > UEAgentReliable::MaxBatchItems)
+			{
+				return UEAgentReliable::Error(TEXT("TOO_MANY_SCOPES"), TEXT("a command may declare at most 64 scopes"));
+			}
+			Job->Scopes.Sort();
+			for (int32 Index = Job->Scopes.Num() - 1; Index > 0; --Index)
+			{
+				if (Job->Scopes[Index] == Job->Scopes[Index - 1]) Job->Scopes.RemoveAt(Index);
+			}
+			if (Job->Scopes.IsEmpty() && Job->LeaseMode != TEXT("exclusive"))
+			{
+				return UEAgentReliable::Error(TEXT("SCOPES_REQUIRED"), TEXT("Mutations need canonical scopes; use lease_mode=exclusive only when the target cannot be scoped"));
+			}
+			if (Job->Scopes.IsEmpty() && Job->VerifyMode != TEXT("success"))
+			{
+				return UEAgentReliable::Error(TEXT("VERIFY_REQUIRES_SCOPES"), TEXT("unscoped exclusive commands can only use verify=success"));
+			}
+			if (Job->LeaseMode != TEXT("scoped") && Job->LeaseMode != TEXT("exclusive"))
+			{
+				return UEAgentReliable::Error(TEXT("INVALID_LEASE_MODE"), TEXT("lease_mode must be scoped or exclusive"));
+			}
+			for (const FString& Scope : Job->Scopes)
+			{
+				if (!Scope.StartsWith(TEXT("editor:"), ESearchCase::IgnoreCase))
+				{
+					const FString PackageName = UEAgentReliable::NormalizePackageScope(Scope);
+					if (PackageName.IsEmpty()) return UEAgentReliable::Error(TEXT("INVALID_SCOPE"), Scope);
+					Job->Packages.AddUnique(PackageName);
+				}
+			}
+			Job->Packages.Sort();
+
+			const TSharedPtr<FJsonObject>* Expected = nullptr;
+			if (Parameters->TryGetObjectField(TEXT("expected_snapshots"), Expected) && Expected && Expected->IsValid())
+			{
+				for (const auto& Pair : (*Expected)->Values)
+				{
+					if (!Job->Scopes.Contains(FString(Pair.Key)))
+					{
+						return UEAgentReliable::Error(TEXT("EXPECTED_SCOPE_NOT_DECLARED"), FString(Pair.Key));
+					}
+					FString Hash;
+					if (!Pair.Value.IsValid() || !Pair.Value->TryGetString(Hash) || Hash.Len() != 64)
+					{
+						return UEAgentReliable::Error(TEXT("INVALID_EXPECTED_SNAPSHOT"), FString(Pair.Key));
+					}
+					Job->ExpectedSnapshots.Add(FString(Pair.Key), Hash.ToLower());
+				}
+			}
+
+			const FString ArgumentsJson = UEAgentReliable::CanonicalJson(Job->Arguments);
+			const FTCHARToUTF8 ArgumentsUtf8(*ArgumentsJson);
+			if (ArgumentsUtf8.Length() > UEAgentReliable::MaxCommandBytes)
+			{
+				return UEAgentReliable::Error(TEXT("COMMAND_TOO_LARGE"), TEXT("canonical arguments exceed 8 MiB"));
+			}
+			const FString ExpectedPayloadHash = UEAgentReliable::JsonStringField(Parameters, TEXT("payload_sha256")).ToLower();
+			if (ArgumentsUtf8.Length() >= UEAgentReliable::LargePayloadHashThreshold && ExpectedPayloadHash.IsEmpty())
+			{
+				return UEAgentReliable::Error(TEXT("PAYLOAD_HASH_REQUIRED"), TEXT("arguments >= 64 KiB require payload_sha256 (including large HLSL)"));
+			}
+			if (!ExpectedPayloadHash.IsEmpty()
+				&& !UEAgentReliable::ConstantTimeEquals(ExpectedPayloadHash, UEAgentReliable::Sha256String(ArgumentsJson)))
+			{
+				return UEAgentReliable::Error(TEXT("PAYLOAD_HASH_MISMATCH"), TEXT("payload_sha256 does not match canonical arguments"));
+			}
+		}
+
+		double TimeoutMs = bPerformance ? 300000.0 : 120000.0;
+		Parameters->TryGetNumberField(TEXT("timeout_ms"), TimeoutMs);
+		TimeoutMs = FMath::Clamp(TimeoutMs, 1000.0, 3600000.0);
+		Job->DeadlineSeconds = FPlatformTime::Seconds() + TimeoutMs / 1000.0;
+
+		TSharedPtr<FJsonObject> DigestObject = UEAgentReliable::CloneObject(Parameters);
+		DigestObject->RemoveField(TEXT("payload_sha256"));
+		Job->Digest = UEAgentReliable::Sha256String(UEAgentReliable::CanonicalJson(DigestObject));
+		if (const TSharedPtr<FJob>* Existing = Jobs.Find(Job->CommandId))
+		{
+			if ((*Existing)->Digest != Job->Digest)
+			{
+				return UEAgentReliable::Error(TEXT("COMMAND_ID_REUSED"), TEXT("command_id already belongs to a different digest"));
+			}
+			return JobJson(*(*Existing));
+		}
+		if (FPaths::FileExists(ReceiptPath(Job->CommandId)))
+		{
+			TSharedPtr<FJsonObject> Receipt = LoadObjectFile(ReceiptPath(Job->CommandId));
+			if (Receipt.IsValid() && UEAgentReliable::JsonStringField(Receipt, TEXT("command_digest")) == Job->Digest)
+			{
+				Receipt->SetBoolField(TEXT("replayed"), true);
+				return Receipt;
+			}
+			return UEAgentReliable::Error(TEXT("COMMAND_ID_REUSED"), TEXT("an immutable receipt exists for another digest"));
+		}
+		if (Queue.Num() >= UEAgentReliable::MaxQueuedJobs)
+		{
+			return UEAgentReliable::Error(TEXT("QUEUE_FULL"), TEXT("the editor command queue already contains 256 jobs"));
+		}
+
+		Jobs.Add(Job->CommandId, Job);
+		Transition(*Job, TEXT("accepted"), TEXT("command accepted and durably journaled"), true);
+		if (Job->FaultInjection == TEXT("after_accept"))
+		{
+			FailBeforeEffect(*Job, TEXT("FAULT_AFTER_ACCEPT"), TEXT("Injected failure after durable acceptance"));
+			return GetReceipt(Parameters);
+		}
+		Job->State = TEXT("queued");
+		Transition(*Job, TEXT("queued"), TEXT("waiting for compatible editor lease"));
+		Queue.Add(Job->CommandId);
+		WriteStateFile();
+		return JobJson(*Job);
+	}
+
+	TSharedPtr<FJsonObject> MaterializeAttachments(const TSharedPtr<FJsonObject>& Parameters, FJob& Job)
+	{
+		const TArray<TSharedPtr<FJsonValue>>* Attachments = nullptr;
+		if (!Parameters->TryGetArrayField(TEXT("attachments"), Attachments) || !Attachments) return nullptr;
+		int64 TotalBytes = 0;
+		for (const TSharedPtr<FJsonValue>& Value : *Attachments)
+		{
+			if (!Value.IsValid() || Value->Type != EJson::Object)
+				return UEAgentReliable::Error(TEXT("INVALID_ATTACHMENT"), TEXT("attachment must be an object"));
+			const TSharedPtr<FJsonObject> Attachment = Value->AsObject();
+			const FString Argument = UEAgentReliable::JsonStringField(Attachment, TEXT("argument"));
+			const FString RelativePath = UEAgentReliable::JsonStringField(Attachment, TEXT("path"));
+			const FString ExpectedHash = UEAgentReliable::JsonStringField(Attachment, TEXT("sha256")).ToLower();
+			if (Argument.IsEmpty() || RelativePath.IsEmpty() || ExpectedHash.Len() != 64)
+				return UEAgentReliable::Error(TEXT("INVALID_ATTACHMENT"), TEXT("argument, path, and sha256 are required"));
+
+			FString FullPath = FPaths::ConvertRelativePathToFull(InboxDir / RelativePath);
+			FPaths::NormalizeFilename(FullPath);
+			FString NormalizedInbox = InboxDir;
+			FPaths::NormalizeFilename(NormalizedInbox);
+			if (!FPaths::IsUnderDirectory(FullPath, NormalizedInbox))
+				return UEAgentReliable::Error(TEXT("ATTACHMENT_PATH_DENIED"), TEXT("attachments must stay under Saved/UEAgent/Inbox"));
+
+			TArray<uint8> Bytes;
+			if (!FFileHelper::LoadFileToArray(Bytes, *FullPath))
+				return UEAgentReliable::Error(TEXT("ATTACHMENT_NOT_FOUND"), RelativePath);
+			TotalBytes += Bytes.Num();
+			if (TotalBytes > UEAgentReliable::MaxCommandBytes)
+				return UEAgentReliable::Error(TEXT("ATTACHMENT_TOO_LARGE"), TEXT("combined attachments exceed 8 MiB"));
+			if (!UEAgentReliable::ConstantTimeEquals(ExpectedHash, UEAgentReliable::Sha256Bytes(Bytes.GetData(), Bytes.Num())))
+				return UEAgentReliable::Error(TEXT("ATTACHMENT_HASH_MISMATCH"), RelativePath);
+			if (Bytes.Contains(0))
+				return UEAgentReliable::Error(TEXT("ATTACHMENT_ENCODING"), TEXT("attachments must be UTF-8 text without NUL bytes"));
+			const FUTF8ToTCHAR Converted(reinterpret_cast<const ANSICHAR*>(Bytes.GetData()), Bytes.Num());
+			const FTCHARToUTF8 RoundTrip(Converted.Get(), Converted.Length());
+			if (RoundTrip.Length() != Bytes.Num()
+				|| FMemory::Memcmp(RoundTrip.Get(), Bytes.GetData(), Bytes.Num()) != 0)
+			{
+				return UEAgentReliable::Error(TEXT("ATTACHMENT_ENCODING"), TEXT("attachment is not canonical UTF-8"));
+			}
+			Job.Arguments->SetStringField(Argument, FString(Converted.Length(), Converted.Get()));
+		}
+		return nullptr;
+	}
+
+	bool Tick(float)
+	{
+		if (!bInitialized.Load() || !bEnabled.Load()) return true;
+		if (!ActiveJobId.IsEmpty())
+		{
+			TSharedPtr<FJob>* Found = Jobs.Find(ActiveJobId);
+			if (!Found)
+			{
+				ReleaseActive();
+				return true;
+			}
+			FJob& Job = *(*Found);
+			if (Job.bPerformanceProfile) TickPerformance(Job);
+			else if (Job.State == TEXT("waiting_external")
+				&& !Job.bDeadlineReported
+				&& FPlatformTime::Seconds() > Job.DeadlineSeconds)
+			{
+				Job.bDeadlineReported = true;
+				Job.ErrorCode = TEXT("DEADLINE_EXCEEDED");
+				Job.ErrorMessage = TEXT("Underlying tool has not completed; lease remains held to avoid overlapping unknown effects");
+				Transition(Job, TEXT("waiting_external"), Job.ErrorMessage);
+			}
+			return true;
+		}
+
+		if (!Queue.IsEmpty())
+		{
+			// ponytail: one game-thread writer is the safety ceiling; split by scope only when tool execution itself becomes isolated.
+			const FString Id = Queue[0];
+			Queue.RemoveAt(0);
+			if (TSharedPtr<FJob>* Job = Jobs.Find(Id)) Start(*(*Job));
+		}
+		return true;
+	}
+
+	void Start(FJob& Job)
+	{
+		ActiveJobId = Job.CommandId;
+		bMutationActive.Store(true);
+		bPerformanceFrozen.Store(Job.bPerformanceProfile);
+		if (Job.LeaseMode == TEXT("exclusive") || Job.bPerformanceProfile)
+			ActiveLeases.Add(TEXT("editor:*"), Job.CommandId);
+		else
+			for (const FString& Scope : Job.Scopes) ActiveLeases.Add(Scope, Job.CommandId);
+
+		Job.State = TEXT("preflight");
+		Job.StartedAt = FDateTime::UtcNow();
+		Transition(Job, TEXT("preflight"), TEXT("lease acquired; collecting authoritative editor snapshots"));
+		if (Job.FaultInjection == TEXT("before_execute"))
+		{
+			FailBeforeEffect(Job, TEXT("FAULT_BEFORE_EXECUTE"), TEXT("Injected failure before mutation"));
+			return;
+		}
+		if (!Job.bPerformanceProfile && !Preflight(Job)) return;
+
+		Job.State = TEXT("running");
+		Transition(Job, TEXT("running"), TEXT("dispatching on the editor game thread"));
+		if (Job.bPerformanceProfile)
+		{
+			UEAgentReliable::FManagedMutationScope Managed;
+			Job.ProfileStartResult = UPerformanceService::StartMonitor(
+				Job.TargetFPS, Job.WarmupFrames, Job.SampleFrames, Job.HitchThresholdMs);
+			FString Normalized, Error;
+			if (!UEAgentReliable::ResultIndicatesSuccess(Job.ProfileStartResult, Normalized, Error))
+			{
+				Complete(Job, false, Normalized, TEXT("PROFILE_START_FAILED"), Error);
+				return;
+			}
+			Job.ElapsedProfileFrames = 0;
+			return;
+		}
+
+		if (Job.TargetType == TEXT("vibeue"))
+		{
+			TMap<FString, FString> Arguments;
+			for (const auto& Pair : Job.Arguments->Values)
+			{
+				if (Pair.Value.IsValid() && Pair.Value->Type == EJson::String)
+					Arguments.Add(FString(Pair.Key), Pair.Value->AsString());
+				else
+					Arguments.Add(FString(Pair.Key), UEAgentReliable::CanonicalJson(Pair.Value));
+			}
+			FString Raw;
+			{
+				UEAgentReliable::FManagedMutationScope Managed;
+				Raw = FToolRegistry::Get().ExecuteTool(Job.ToolName, Arguments);
+			}
+			FString Normalized, Error;
+			const bool bSuccess = UEAgentReliable::ResultIndicatesSuccess(Raw, Normalized, Error);
+			Complete(Job, bSuccess, Normalized, bSuccess ? FString() : TEXT("TOOL_REPORTED_FAILURE"), Error);
+			return;
+		}
+
+		FString ArgumentsJson = UEAgentReliable::CanonicalJson(Job.Arguments);
+		UToolCallAsyncResultString* AsyncResult = nullptr;
+		{
+			UEAgentReliable::FManagedMutationScope Managed;
+			AsyncResult = UToolsetRegistry::ExecuteTool(Job.ToolsetName, Job.ToolName, ArgumentsJson);
+		}
+		if (!AsyncResult)
+		{
+			Complete(Job, false, FString(), TEXT("DISPATCH_FAILED"), TEXT("ToolsetRegistry returned no async result"));
+			return;
+		}
+		Job.State = TEXT("waiting_external");
+		Transition(Job, TEXT("waiting_external"), TEXT("ToolsetRegistry accepted the typed call"));
+		TStrongObjectPtr<UToolCallAsyncResultFutureHandler> Handler =
+			UToolCallAsyncResultFutureHandler::Create(AsyncResult);
+		Handler->GetValueAsJson().Next(
+			[this, CommandId = Job.CommandId](UE::ToolsetRegistry::FJsonValueOrError&& Result)
+			{
+				bool bSuccess = !Result.HasError();
+				FString Raw;
+				FString ErrorMessage;
+				if (Result.HasError())
+				{
+					ErrorMessage = Result.GetError();
+				}
+				else if (Result.GetValue().IsValid())
+				{
+					if (!Result.GetValue()->TryGetString(Raw)) Raw = UEAgentReliable::CanonicalJson(Result.GetValue());
+				}
+				AsyncTask(ENamedThreads::GameThread,
+					[this, CommandId, bSuccess, Raw = MoveTemp(Raw), ErrorMessage = MoveTemp(ErrorMessage)]()
+					{
+						if (!bInitialized.Load()) return;
+						TSharedPtr<FJob>* Found = Jobs.Find(CommandId);
+						if (!Found || ActiveJobId != CommandId) return;
+						FString Normalized, SemanticError;
+						const bool bSemanticSuccess = bSuccess
+							&& UEAgentReliable::ResultIndicatesSuccess(Raw, Normalized, SemanticError);
+						Complete(*(*Found), bSemanticSuccess, Normalized,
+							bSuccess ? (bSemanticSuccess ? FString() : TEXT("TOOL_REPORTED_FAILURE")) : TEXT("TOOLSET_ERROR"),
+							bSuccess ? SemanticError : ErrorMessage);
+					});
+			});
+	}
+
+	bool Preflight(FJob& Job)
+	{
+		for (const FString& Scope : Job.Scopes)
+		{
+			FSnapshot Snapshot = CaptureSnapshot(Scope, false);
+			if (!Snapshot.Error.IsEmpty())
+			{
+				FailBeforeEffect(Job, TEXT("SNAPSHOT_FAILED"), Snapshot.Error);
+				return false;
+			}
+			Job.BeforeSnapshots.Add(Scope, Snapshot);
+			if (!Snapshot.PackageName.IsEmpty())
+			{
+				Job.Packages.AddUnique(Snapshot.PackageName);
+				if (Snapshot.bDirty) Job.PreexistingDirtyPackages.AddUnique(Snapshot.PackageName);
+			}
+			if (const FString* Expected = Job.ExpectedSnapshots.Find(Scope);
+				Expected && !UEAgentReliable::ConstantTimeEquals(Expected->ToLower(), Snapshot.Hash))
+			{
+				Job.Effect = TEXT("none");
+				Job.Verification = TEXT("conflict");
+				FailBeforeEffect(Job, TEXT("SNAPSHOT_CONFLICT"),
+					FString::Printf(TEXT("scope %s expected %s but editor has %s"), *Scope, **Expected, *Snapshot.Hash));
+				return false;
+			}
+		}
+		Job.Packages.Sort();
+		Job.PreexistingDirtyPackages.Sort();
+		return true;
+	}
+
+	void Complete(FJob& Job, bool bToolSuccess, const FString& RawResult, const FString& ErrorCode, const FString& ErrorMessage)
+	{
+		if (Job.State == TEXT("terminal")) return;
+		Job.RawResult = RawResult;
+		Job.ErrorCode = ErrorCode;
+		Job.ErrorMessage = ErrorMessage;
+		if (Job.FaultInjection == TEXT("after_execute"))
+		{
+			Job.Outcome = TEXT("result_unknown");
+			Job.Effect = TEXT("unknown");
+			Job.Verification = TEXT("not_run");
+			Job.Persistence = Job.bUnexpectedSave ? TEXT("saved_out_of_band") : TEXT("unknown");
+			Job.ErrorCode = TEXT("FAULT_AFTER_EXECUTE");
+			Job.ErrorMessage = TEXT("Injected failure after execution and before verification");
+			Finalize(Job);
+			return;
+		}
+		Job.State = TEXT("verifying");
+		Transition(Job, TEXT("verifying"), TEXT("re-reading authoritative editor state"));
+
+		bool bSnapshotFailure = false;
+		bool bChanged = false;
+		for (const FString& Scope : Job.Scopes)
+		{
+			FSnapshot Snapshot = CaptureSnapshot(Scope, false);
+			if (!Snapshot.Error.IsEmpty()) bSnapshotFailure = true;
+			Job.AfterSnapshots.Add(Scope, Snapshot);
+			if (const FSnapshot* Before = Job.BeforeSnapshots.Find(Scope);
+				Before && !Snapshot.Hash.IsEmpty() && Snapshot.Hash != Before->Hash)
+			{
+				bChanged = true;
+			}
+		}
+
+		Job.Effect = Job.Scopes.IsEmpty() ? TEXT("unknown")
+			: (bChanged ? TEXT("changed") : (bSnapshotFailure ? TEXT("unknown") : TEXT("no_change")));
+		Job.Verification = bSnapshotFailure ? TEXT("failed") : (Job.Scopes.IsEmpty() ? TEXT("unverified") : TEXT("verified"));
+		bool bVerificationPolicySatisfied = !bSnapshotFailure || Job.VerifyMode == TEXT("success");
+		if (bVerificationPolicySatisfied && Job.VerifyMode == TEXT("changed") && !bChanged)
+		{
+			bVerificationPolicySatisfied = false;
+			Job.Verification = TEXT("failed");
+			Job.ErrorCode = TEXT("VERIFY_EXPECTED_CHANGE");
+			Job.ErrorMessage = TEXT("verify=changed required an authoritative state change, but none was observed");
+		}
+		else if (bVerificationPolicySatisfied && Job.VerifyMode == TEXT("unchanged") && bChanged)
+		{
+			bVerificationPolicySatisfied = false;
+			Job.Verification = TEXT("failed");
+			Job.ErrorCode = TEXT("VERIFY_UNEXPECTED_CHANGE");
+			Job.ErrorMessage = TEXT("verify=unchanged was violated by an authoritative state change");
+		}
+		if (Job.bUnexpectedSave)
+		{
+			Job.Outcome = TEXT("result_unknown");
+			Job.Persistence = TEXT("saved_out_of_band");
+			Job.ErrorCode = TEXT("UNEXPECTED_SAVE");
+			Job.ErrorMessage = TEXT("A domain tool saved during mutation; receipt cannot claim the save boundary was preserved");
+		}
+		else if (Job.bUnexpectedDirty)
+		{
+			Job.Outcome = TEXT("result_unknown");
+			Job.Persistence = TEXT("dirty_out_of_scope");
+			Job.ErrorCode = TEXT("WRITE_SCOPE_VIOLATION");
+			Job.ErrorMessage = TEXT("The command dirtied a package outside its declared write scopes");
+		}
+		else if (!bToolSuccess && (bChanged || bSnapshotFailure))
+		{
+			Job.Outcome = TEXT("result_unknown");
+		}
+		else if (!bToolSuccess)
+		{
+			Job.Outcome = TEXT("failed");
+		}
+		else if (bSnapshotFailure && Job.VerifyMode != TEXT("success"))
+		{
+			Job.Outcome = TEXT("result_unknown");
+			Job.ErrorCode = TEXT("VERIFY_SNAPSHOT_FAILED");
+			Job.ErrorMessage = TEXT("The tool returned success, but authoritative verification could not complete");
+		}
+		else if (!bVerificationPolicySatisfied)
+		{
+			Job.Outcome = TEXT("failed");
+		}
+		else
+		{
+			Job.Outcome = Job.bCancelRequested ? TEXT("completed_after_cancel_request") : TEXT("succeeded");
+		}
+
+		if (Job.bUnexpectedSave || Job.bUnexpectedDirty)
+		{
+			// The more specific persistence result was assigned with the boundary violation above.
+		}
+		else if (Job.Packages.IsEmpty())
+		{
+			Job.Persistence = TEXT("not_applicable");
+		}
+		else
+		{
+			Job.DirtyPackages.Reset();
+			for (const FString& PackageName : Job.Packages)
+			{
+				if (UPackage* Package = FindPackage(nullptr, *PackageName); Package && Package->IsDirty())
+					Job.DirtyPackages.Add(PackageName);
+			}
+			Job.DirtyPackages.Sort();
+			Job.Persistence = Job.DirtyPackages.IsEmpty() ? TEXT("clean")
+				: (!Job.PreexistingDirtyPackages.IsEmpty() && !Job.bAllowPreexistingDirtySave
+					? TEXT("dirty_preexisting_not_saved") : TEXT("dirty_not_saved"));
+		}
+
+		if ((Job.Outcome == TEXT("succeeded") || Job.Outcome == TEXT("completed_after_cancel_request"))
+			&& Job.Effect == TEXT("changed")
+			&& Job.Verification == TEXT("verified")
+			&& Job.Persistence == TEXT("dirty_not_saved")
+			&& Job.FaultInjection != TEXT("before_receipt"))
+		{
+			Job.SaveToken = IssueSaveToken(Job, Job.DirtyPackages);
+		}
+		if (Job.FaultInjection == TEXT("before_receipt"))
+		{
+			Job.SaveToken.Reset();
+			Job.bReceiptInterrupted = true;
+			Job.Outcome = TEXT("result_unknown");
+			Job.ErrorCode = TEXT("FAULT_BEFORE_RECEIPT");
+			Job.ErrorMessage = TEXT("Injected interruption before immutable receipt creation; run ueagent_recover");
+			Transition(Job, TEXT("receipt_interrupted"), Job.ErrorMessage);
+			Queue.Remove(Job.CommandId);
+			if (ActiveJobId == Job.CommandId) ReleaseActive();
+			WriteStateFile();
+			return;
+		}
+		Finalize(Job);
+	}
+
+	void TickPerformance(FJob& Job)
+	{
+		if (Job.State == TEXT("terminal")) return;
+		if (Job.bCancelRequested || FPlatformTime::Seconds() > Job.DeadlineSeconds)
+		{
+			UEAgentReliable::FManagedMutationScope Managed;
+			Job.RawResult = UPerformanceService::StopMonitor(TEXT("ueagent_profile_cancelled"), false);
+			Job.Outcome = Job.bCancelRequested ? TEXT("cancelled") : TEXT("failed");
+			Job.Effect = TEXT("none");
+			Job.Verification = TEXT("not_run");
+			Job.Persistence = TEXT("not_applicable");
+			Job.ErrorCode = Job.bCancelRequested ? TEXT("CANCELLED") : TEXT("DEADLINE_EXCEEDED");
+			Job.ErrorMessage = Job.bCancelRequested
+				? TEXT("Performance profile cancelled and its native monitor stopped")
+				: TEXT("Performance profile deadline exceeded and its native monitor stopped");
+			Finalize(Job);
+			return;
+		}
+		if (++Job.ElapsedProfileFrames == Job.WarmupFrames + 1)
+		{
+			UEAgentReliable::FManagedMutationScope Managed;
+			Job.ProfileCaptureResult = UPerformanceService::CaptureGPUProfile();
+			Transition(Job, TEXT("running"), TEXT("warmup complete; native ProfileGPU capture queued"));
+		}
+		if (Job.ElapsedProfileFrames < Job.WarmupFrames + Job.SampleFrames) return;
+
+		FString StopResult;
+		{
+			UEAgentReliable::FManagedMutationScope Managed;
+			StopResult = UPerformanceService::StopMonitor(
+				TEXT("ueagent_profile_") + Job.CommandId.Left(8), true);
+		}
+		TSharedPtr<FJsonObject> Profile = MakeShared<FJsonObject>();
+		Profile->SetNumberField(TEXT("warmup_frames"), Job.WarmupFrames);
+		Profile->SetNumberField(TEXT("sample_frames"), Job.SampleFrames);
+		Profile->SetNumberField(TEXT("target_fps"), Job.TargetFPS);
+		Profile->SetNumberField(TEXT("hitch_threshold_ms"), Job.HitchThresholdMs);
+		Profile->SetStringField(TEXT("monitor_start"), Job.ProfileStartResult);
+		Profile->SetStringField(TEXT("profile_gpu_capture"), Job.ProfileCaptureResult);
+		Profile->SetStringField(TEXT("monitor_stop"), StopResult);
+		Profile->SetBoolField(TEXT("performance_freeze"), true);
+		FString Error;
+		FString Normalized;
+		const bool bSuccess = UEAgentReliable::ResultIndicatesSuccess(StopResult, Normalized, Error);
+		Job.Scopes.Reset();
+		Complete(Job, bSuccess, UEAgentReliable::CanonicalJson(Profile),
+			bSuccess ? FString() : TEXT("PROFILE_STOP_FAILED"), Error);
+	}
+
+	void FailBeforeEffect(FJob& Job, const FString& Code, const FString& Message)
+	{
+		Job.Outcome = TEXT("failed");
+		Job.Effect = TEXT("none");
+		if (Job.Verification == TEXT("pending")) Job.Verification = TEXT("not_run");
+		Job.Persistence = TEXT("not_applicable");
+		Job.ErrorCode = Code;
+		Job.ErrorMessage = Message;
+		Finalize(Job);
+	}
+
+	void Finalize(FJob& Job)
+	{
+		const FString CommandId = Job.CommandId;
+		TSharedPtr<FJob> KeepAlive = Jobs.FindRef(CommandId);
+		Job.State = TEXT("terminal");
+		Job.FinishedAt = FDateTime::UtcNow();
+		Transition(Job, TEXT("terminal"), Job.ErrorMessage.IsEmpty() ? Job.Outcome : Job.ErrorMessage);
+		TSharedPtr<FJsonObject> Receipt = ReceiptJson(Job);
+		if (!WriteObjectAtomic(ReceiptPath(CommandId), Receipt, false))
+		{
+			if (!Job.SaveToken.IsEmpty()) SaveTokens.Remove(Job.SaveToken);
+			Job.SaveToken.Reset();
+			Job.bReceiptInterrupted = true;
+			Job.Outcome = TEXT("result_unknown");
+			Job.ErrorCode = TEXT("RECEIPT_WRITE_FAILED");
+			Job.ErrorMessage = TEXT("The mutation ended, but its immutable receipt could not be written; run ueagent_recover");
+			Transition(Job, TEXT("receipt_interrupted"), Job.ErrorMessage);
+			Queue.Remove(CommandId);
+			if (ActiveJobId == CommandId) ReleaseActive();
+			WriteStateFile();
+			return;
+		}
+		LastReceiptId = CommandId;
+		Queue.Remove(CommandId);
+		if (ActiveJobId == CommandId)
+		{
+			ReleaseActive();
+		}
+		Jobs.Remove(CommandId);
+		WriteStateFile();
+	}
+
+	void ReleaseActive()
+	{
+		ActiveLeases.Reset();
+		ActiveJobId.Reset();
+		bMutationActive.Store(false);
+		bPerformanceFrozen.Store(false);
+	}
+
+	FSnapshot CaptureSnapshot(const FString& Scope, bool bIncludeValues) const
+	{
+		FSnapshot Snapshot;
+		Snapshot.Scope = Scope;
+		Snapshot.Data = MakeShared<FJsonObject>();
+		Snapshot.Data->SetStringField(TEXT("scope"), Scope);
+		auto Finish = [&Snapshot, bIncludeValues]()
+		{
+			if (!Snapshot.Error.IsEmpty()) return;
+			Snapshot.Data->SetNumberField(TEXT("property_count"), Snapshot.PropertyCount);
+			const FString Canonical = UEAgentReliable::CanonicalJson(Snapshot.Data);
+			const FTCHARToUTF8 Utf8(*Canonical);
+			Snapshot.Bytes = Utf8.Length();
+			if (Snapshot.Bytes > UEAgentReliable::MaxSnapshotBytes)
+			{
+				Snapshot.Error = TEXT("authoritative snapshot exceeds 8 MiB: ") + Snapshot.Scope;
+				return;
+			}
+			Snapshot.Hash = UEAgentReliable::Sha256String(Canonical);
+			if (!bIncludeValues) Snapshot.Data->RemoveField(TEXT("properties"));
+			Snapshot.Data->SetStringField(TEXT("sha256"), Snapshot.Hash);
+			Snapshot.Data->SetNumberField(TEXT("snapshot_bytes"), Snapshot.Bytes);
+		};
+
+		if (Scope.StartsWith(TEXT("editor:"), ESearchCase::IgnoreCase))
+		{
+			CaptureEditorSnapshot(Scope.ToLower(), Snapshot);
+			Finish();
+			return Snapshot;
+		}
+
+		Snapshot.PackageName = UEAgentReliable::NormalizePackageScope(Scope);
+		if (Snapshot.PackageName.IsEmpty())
+		{
+			Snapshot.Error = TEXT("invalid package/object scope: ") + Scope;
+			return Snapshot;
+		}
+		Snapshot.ObjectPath = UEAgentReliable::ObjectPathForScope(Scope, Snapshot.PackageName);
+		UPackage* Package = FindPackage(nullptr, *Snapshot.PackageName);
+		if (!Package) Package = LoadPackage(nullptr, *Snapshot.PackageName, LOAD_NoWarn);
+		if (!Package)
+		{
+			Snapshot.SaveGeneration = PackageSaveGenerations.FindRef(Snapshot.PackageName);
+			Snapshot.Data->SetStringField(TEXT("package"), Snapshot.PackageName);
+			Snapshot.Data->SetStringField(TEXT("object"), Snapshot.ObjectPath);
+			Snapshot.Data->SetBoolField(TEXT("exists"), false);
+			Snapshot.Data->SetBoolField(TEXT("dirty"), false);
+			Snapshot.Data->SetNumberField(TEXT("save_generation"), static_cast<double>(Snapshot.SaveGeneration));
+			Finish();
+			return Snapshot;
+		}
+		UObject* Object = StaticFindObject(UObject::StaticClass(), nullptr, *Snapshot.ObjectPath);
+		if (!Object) Object = Package->FindAssetInPackage();
+		if (!Object)
+		{
+			Snapshot.bDirty = Package->IsDirty();
+			Snapshot.SaveGeneration = PackageSaveGenerations.FindRef(Snapshot.PackageName);
+			Snapshot.Data->SetStringField(TEXT("package"), Snapshot.PackageName);
+			Snapshot.Data->SetStringField(TEXT("object"), Snapshot.ObjectPath);
+			Snapshot.Data->SetBoolField(TEXT("exists"), false);
+			Snapshot.Data->SetBoolField(TEXT("dirty"), Snapshot.bDirty);
+			Snapshot.Data->SetNumberField(TEXT("save_generation"), static_cast<double>(Snapshot.SaveGeneration));
+			Finish();
+			return Snapshot;
+		}
+
+		Snapshot.ObjectPath = Object->GetPathName();
+		Snapshot.bDirty = Package->IsDirty();
+		Snapshot.SaveGeneration = PackageSaveGenerations.FindRef(Snapshot.PackageName);
+		Snapshot.Data->SetStringField(TEXT("package"), Snapshot.PackageName);
+		Snapshot.Data->SetStringField(TEXT("object"), Snapshot.ObjectPath);
+		Snapshot.Data->SetBoolField(TEXT("exists"), true);
+		Snapshot.Data->SetStringField(TEXT("class"), Object->GetClass()->GetPathName());
+		Snapshot.Data->SetBoolField(TEXT("dirty"), Snapshot.bDirty);
+		Snapshot.Data->SetNumberField(TEXT("save_generation"), static_cast<double>(Snapshot.SaveGeneration));
+
+		FString Filename;
+		if (FPackageName::DoesPackageExist(Snapshot.PackageName, &Filename))
+		{
+			Snapshot.Data->SetNumberField(TEXT("file_size"), static_cast<double>(IFileManager::Get().FileSize(*Filename)));
+			Snapshot.Data->SetStringField(TEXT("file_timestamp"), IFileManager::Get().GetTimeStamp(*Filename).ToIso8601());
+		}
+
+		TSharedPtr<FJsonObject> Properties = MakeShared<FJsonObject>();
+		int32 TotalCharacters = 0;
+		TArray<FProperty*> SortedProperties;
+		for (TFieldIterator<FProperty> It(Object->GetClass(), EFieldIteratorFlags::IncludeSuper); It; ++It)
+		{
+			FProperty* Property = *It;
+			if (!Property || Property->HasAnyPropertyFlags(CPF_Transient | CPF_DuplicateTransient | CPF_Deprecated)) continue;
+			SortedProperties.Add(Property);
+		}
+		SortedProperties.Sort([](const FProperty& Left, const FProperty& Right)
+		{
+			return Left.GetName() < Right.GetName();
+		});
+		for (FProperty* Property : SortedProperties)
+		{
+			FString Value;
+			Property->ExportText_InContainer(0, Value, Object, Object, Object, PPF_Copy);
+			TotalCharacters += Property->GetName().Len() + Value.Len();
+			if (TotalCharacters * sizeof(TCHAR) > UEAgentReliable::MaxSnapshotBytes)
+			{
+				Snapshot.Error = TEXT("authoritative snapshot exceeds 8 MiB: ") + Scope;
+				return Snapshot;
+			}
+			Properties->SetStringField(Property->GetName(), Value);
+			++Snapshot.PropertyCount;
+		}
+		Snapshot.Data->SetObjectField(TEXT("properties"), Properties);
+		Finish();
+		return Snapshot;
+	}
+
+	void CaptureEditorSnapshot(const FString& Scope, FSnapshot& Snapshot) const
+	{
+		if (Scope == TEXT("editor:world"))
+		{
+			UWorld* World = GEditor ? GEditor->GetEditorWorldContext().World() : nullptr;
+			if (!World) { Snapshot.Error = TEXT("editor world unavailable"); return; }
+			TArray<FString> ActorPaths;
+			for (TActorIterator<AActor> It(World); It && ActorPaths.Num() < 100000; ++It) ActorPaths.Add(It->GetPathName());
+			ActorPaths.Sort();
+			TArray<TSharedPtr<FJsonValue>> Actors;
+			for (const FString& Path : ActorPaths) Actors.Add(MakeShared<FJsonValueString>(Path));
+			Snapshot.Data->SetStringField(TEXT("world"), World->GetPathName());
+			Snapshot.Data->SetArrayField(TEXT("actors"), Actors);
+			Snapshot.PackageName = World->GetOutermost()->GetName();
+			Snapshot.bDirty = World->GetOutermost()->IsDirty();
+			Snapshot.Data->SetBoolField(TEXT("dirty"), Snapshot.bDirty);
+			return;
+		}
+		if (Scope == TEXT("editor:selection"))
+		{
+			TArray<FString> Paths;
+			if (GEditor && GEditor->GetSelectedActors())
+			{
+				for (FSelectionIterator It(*GEditor->GetSelectedActors()); It; ++It)
+					if (UObject* Object = Cast<UObject>(*It)) Paths.Add(Object->GetPathName());
+			}
+			Paths.Sort();
+			TArray<TSharedPtr<FJsonValue>> Values;
+			for (const FString& Path : Paths) Values.Add(MakeShared<FJsonValueString>(Path));
+			Snapshot.Data->SetArrayField(TEXT("selected"), Values);
+			return;
+		}
+		if (Scope == TEXT("editor:viewport"))
+		{
+			if (!GCurrentLevelEditingViewportClient) { Snapshot.Error = TEXT("level viewport unavailable"); return; }
+			const FVector Location = GCurrentLevelEditingViewportClient->GetViewLocation();
+			const FRotator Rotation = GCurrentLevelEditingViewportClient->GetViewRotation();
+			Snapshot.Data->SetStringField(TEXT("location"), Location.ToString());
+			Snapshot.Data->SetStringField(TEXT("rotation"), Rotation.ToString());
+			Snapshot.Data->SetBoolField(TEXT("realtime"), GCurrentLevelEditingViewportClient->IsRealtime());
+			return;
+		}
+		Snapshot.Error = TEXT("unsupported editor scope: ") + Scope;
+	}
+
+	TSharedPtr<FJsonObject> SnapshotRequest(const TSharedPtr<FJsonObject>& Parameters) const
+	{
+		if (bMutationActive.Load())
+			return UEAgentReliable::Error(TEXT("EDITOR_BUSY"), TEXT("authoritative snapshots are unavailable while a mutation owns the editor"));
+		const TArray<FString> Scopes = UEAgentReliable::JsonStringArray(Parameters, TEXT("scopes"));
+		if (Scopes.IsEmpty() || Scopes.Num() > UEAgentReliable::MaxBatchItems)
+			return UEAgentReliable::Error(TEXT("INVALID_SCOPES"), TEXT("provide 1-64 scopes"));
+		bool bIncludeValues = false;
+		if (Parameters.IsValid()) Parameters->TryGetBoolField(TEXT("include_values"), bIncludeValues);
+		TSharedPtr<FJsonObject> Result = UEAgentReliable::Ok();
+		Result->SetStringField(TEXT("editor_epoch"), EditorEpoch);
+		TArray<TSharedPtr<FJsonValue>> Values;
+		for (const FString& Scope : Scopes)
+		{
+			FSnapshot Snapshot = CaptureSnapshot(Scope, bIncludeValues);
+			if (!Snapshot.Error.IsEmpty())
+			{
+				TSharedPtr<FJsonObject> Failure = UEAgentReliable::Error(TEXT("SNAPSHOT_FAILED"), Snapshot.Error);
+				Failure->SetStringField(TEXT("scope"), Scope);
+				Values.Add(MakeShared<FJsonValueObject>(Failure));
+			}
+			else Values.Add(MakeShared<FJsonValueObject>(Snapshot.Data));
+		}
+		Result->SetArrayField(TEXT("snapshots"), Values);
+		return Result;
+	}
+
+	TSharedPtr<FJsonObject> BatchRead(const TSharedPtr<FJsonObject>& Parameters) const
+	{
+		const TArray<TSharedPtr<FJsonValue>>* Requests = nullptr;
+		if (!Parameters.IsValid() || !Parameters->TryGetArrayField(TEXT("requests"), Requests)
+			|| !Requests || Requests->IsEmpty() || Requests->Num() > UEAgentReliable::MaxBatchItems)
+		{
+			return UEAgentReliable::Error(TEXT("INVALID_BATCH"), TEXT("requests must contain 1-64 bounded read requests"));
+		}
+		TSharedPtr<FJsonObject> Result = UEAgentReliable::Ok();
+		Result->SetStringField(TEXT("editor_epoch"), EditorEpoch);
+		TArray<TSharedPtr<FJsonValue>> Results;
+		int32 ApproximateBytes = 0;
+		for (const TSharedPtr<FJsonValue>& Value : *Requests)
+		{
+			if (!Value.IsValid() || Value->Type != EJson::Object)
+			{
+				Results.Add(MakeShared<FJsonValueObject>(UEAgentReliable::Error(TEXT("INVALID_READ"), TEXT("request must be an object"))));
+				continue;
+			}
+			const TSharedPtr<FJsonObject> Request = Value->AsObject();
+			const FString Kind = UEAgentReliable::JsonStringField(Request, TEXT("kind")).ToLower();
+			TSharedPtr<FJsonObject> Item;
+			if (Kind == TEXT("snapshot")) Item = SnapshotRequest(Request);
+			else if (Kind == TEXT("job")) Item = GetJob(Request);
+			else if (Kind == TEXT("receipt")) Item = GetReceipt(Request);
+			else if (Kind == TEXT("state")) Item = State();
+			else Item = UEAgentReliable::Error(TEXT("READ_KIND_DENIED"), TEXT("kind must be snapshot, job, receipt, or state"));
+			const FTCHARToUTF8 ItemUtf8(*UEAgentReliable::CanonicalJson(Item));
+			ApproximateBytes += ItemUtf8.Length();
+			if (ApproximateBytes > UEAgentReliable::MaxSnapshotBytes)
+			{
+				Results.Add(MakeShared<FJsonValueObject>(UEAgentReliable::Error(TEXT("BATCH_LIMIT"), TEXT("batch response exceeded 8 MiB"))));
+				break;
+			}
+			Results.Add(MakeShared<FJsonValueObject>(Item));
+		}
+		Result->SetArrayField(TEXT("results"), Results);
+		return Result;
+	}
+
+	TSharedPtr<FJsonObject> GetJob(const TSharedPtr<FJsonObject>& Parameters) const
+	{
+		const FString CommandId = UEAgentReliable::JsonStringField(Parameters, TEXT("command_id")).ToLower();
+		if (const TSharedPtr<FJob>* Job = Jobs.Find(CommandId)) return JobJson(*(*Job));
+		if (FPaths::FileExists(ReceiptPath(CommandId))) return GetReceipt(Parameters);
+		return UEAgentReliable::Error(TEXT("JOB_NOT_FOUND"), CommandId);
+	}
+
+	TSharedPtr<FJsonObject> GetReceipt(const TSharedPtr<FJsonObject>& Parameters) const
+	{
+		const FString CommandId = UEAgentReliable::JsonStringField(Parameters, TEXT("command_id")).ToLower();
+		TSharedPtr<FJsonObject> Receipt = LoadObjectFile(ReceiptPath(CommandId));
+		return Receipt.IsValid() ? Receipt : UEAgentReliable::Error(TEXT("RECEIPT_NOT_FOUND"), CommandId);
+	}
+
+	TSharedPtr<FJsonObject> Cancel(const TSharedPtr<FJsonObject>& Parameters)
+	{
+		const FString CommandId = UEAgentReliable::JsonStringField(Parameters, TEXT("command_id")).ToLower();
+		TSharedPtr<FJob>* Found = Jobs.Find(CommandId);
+		if (!Found) return UEAgentReliable::Error(TEXT("JOB_NOT_FOUND"), CommandId);
+		FJob& Job = *(*Found);
+		if (Job.State == TEXT("terminal")) return JobJson(Job);
+		if (Queue.Remove(CommandId) > 0)
+		{
+			Job.Outcome = TEXT("cancelled");
+			Job.Effect = TEXT("none");
+			Job.Verification = TEXT("not_run");
+			Job.Persistence = TEXT("not_applicable");
+			Finalize(Job);
+			return GetReceipt(Parameters);
+		}
+		Job.bCancelRequested = true;
+		Job.State = TEXT("cancelling");
+		Transition(Job, TEXT("cancelling"), TEXT("underlying tool has no universal cancellation contract; lease remains until completion"));
+		return JobJson(Job);
+	}
+
+	FString IssueSaveToken(FJob& Job, const TArray<FString>& AuthorizedPackages)
+	{
+		for (auto It = SaveTokens.CreateIterator(); It; ++It)
+		{
+			if (!It.Value().bUsed && FDateTime::UtcNow() > It.Value().ExpiresAt) It.RemoveCurrent();
+		}
+		FSaveToken Record;
+		Record.CommandId = Job.CommandId;
+		Record.ExpiresAt = FDateTime::UtcNow() + FTimespan::FromSeconds(SaveTokenLifetimeSeconds);
+		Record.Packages = AuthorizedPackages;
+		for (const auto& Pair : Job.AfterSnapshots) Record.ScopeHashes.Add(Pair.Key, Pair.Value.Hash);
+		for (const FString& Package : Record.Packages) Record.PackageGenerations.Add(Package, PackageSaveGenerations.FindRef(Package));
+
+		TSharedPtr<FJsonObject> Payload = MakeShared<FJsonObject>();
+		Payload->SetStringField(TEXT("command_id"), Job.CommandId);
+		Payload->SetStringField(TEXT("editor_epoch"), EditorEpoch);
+		Payload->SetStringField(TEXT("expires_at"), Record.ExpiresAt.ToIso8601());
+		Payload->SetStringField(TEXT("nonce"), FGuid::NewGuid().ToString(EGuidFormats::Digits));
+		TArray<TSharedPtr<FJsonValue>> Packages;
+		for (const FString& Package : Record.Packages) Packages.Add(MakeShared<FJsonValueString>(Package));
+		Payload->SetArrayField(TEXT("packages"), Packages);
+		const FString PayloadJson = UEAgentReliable::CanonicalJson(Payload);
+		FString Encoded = FBase64::Encode(PayloadJson);
+		Encoded.ReplaceInline(TEXT("+"), TEXT("-"));
+		Encoded.ReplaceInline(TEXT("/"), TEXT("_"));
+		Encoded.ReplaceInline(TEXT("="), TEXT(""));
+		Record.Token = Encoded + TEXT(".") + UEAgentReliable::HmacSha1(TokenSecret, Encoded);
+		SaveTokens.Add(Record.Token, Record);
+		return Record.Token;
+	}
+
+	TSharedPtr<FJsonObject> Save(const TSharedPtr<FJsonObject>& Parameters)
+	{
+		if (IsPerformanceFrozen()) return UEAgentReliable::Error(TEXT("PERFORMANCE_FROZEN"), TEXT("saving would contaminate the active profile"));
+		if (bMutationActive.Load()) return UEAgentReliable::Error(TEXT("EDITOR_BUSY"), TEXT("saving cannot overlap an active mutation"));
+		const FString Token = UEAgentReliable::JsonStringField(Parameters, TEXT("save_token"));
+		FSaveToken* Record = SaveTokens.Find(Token);
+		if (!Record) return UEAgentReliable::Error(TEXT("INVALID_SAVE_TOKEN"), TEXT("unknown, tampered, or previous-epoch token"));
+		int32 Dot = INDEX_NONE;
+		if (!Token.FindLastChar(TEXT('.'), Dot)
+			|| !UEAgentReliable::ConstantTimeEquals(Token.Mid(Dot + 1), UEAgentReliable::HmacSha1(TokenSecret, Token.Left(Dot))))
+			return UEAgentReliable::Error(TEXT("INVALID_SAVE_TOKEN"), TEXT("signature mismatch"));
+		if (Record->bUsed)
+		{
+			TSharedPtr<FJsonObject> Previous = LoadObjectFile(Record->ReceiptPath);
+			if (!Previous.IsValid()) return UEAgentReliable::Error(TEXT("SAVE_RESULT_UNKNOWN"), TEXT("the token was consumed but its immutable receipt is unavailable"));
+			Previous->SetBoolField(TEXT("replayed"), true);
+			return Previous;
+		}
+		if (FDateTime::UtcNow() > Record->ExpiresAt) return UEAgentReliable::Error(TEXT("SAVE_TOKEN_EXPIRED"), Record->CommandId);
+
+		TArray<FString> RequestedPackages = UEAgentReliable::JsonStringArray(Parameters, TEXT("packages"));
+		RequestedPackages.Sort();
+		if (!RequestedPackages.IsEmpty() && RequestedPackages != Record->Packages)
+			return UEAgentReliable::Error(TEXT("PACKAGE_SET_MISMATCH"), TEXT("packages must exactly match the token"));
+		for (const auto& Pair : Record->PackageGenerations)
+		{
+			if (PackageSaveGenerations.FindRef(Pair.Key) != Pair.Value)
+				return UEAgentReliable::Error(TEXT("OUT_OF_BAND_SAVE"), Pair.Key);
+		}
+		for (const auto& Pair : Record->ScopeHashes)
+		{
+			const FSnapshot Current = CaptureSnapshot(Pair.Key, false);
+			if (!Current.Error.IsEmpty() || !UEAgentReliable::ConstantTimeEquals(Current.Hash, Pair.Value))
+				return UEAgentReliable::Error(TEXT("SAVE_SNAPSHOT_CONFLICT"), Pair.Key);
+		}
+
+		TArray<UPackage*> Packages;
+		for (const FString& Name : Record->Packages)
+		{
+			UPackage* Package = FindPackage(nullptr, *Name);
+			if (!Package) return UEAgentReliable::Error(TEXT("PACKAGE_NOT_LOADED"), Name);
+			if (!Package->IsDirty()) return UEAgentReliable::Error(TEXT("PACKAGE_NOT_DIRTY"), Name);
+			Packages.Add(Package);
+		}
+
+		Record->bUsed = true;
+		bManagedSave = true;
+		ManagedSavePackages = TSet<FString>(Record->Packages);
+		UnexpectedManagedSavePackages.Reset();
+		bool bSaved = UEditorLoadingAndSavingUtils::SavePackages(Packages, false);
+		bManagedSave = false;
+		ManagedSavePackages.Reset();
+		TArray<FString> UnexpectedPackages;
+		for (const FString& Name : UnexpectedManagedSavePackages) UnexpectedPackages.Add(Name);
+		UnexpectedPackages.Sort();
+		UnexpectedManagedSavePackages.Reset();
+		bool bAllClean = true;
+		for (UPackage* Package : Packages) bAllClean &= Package && !Package->IsDirty();
+		bSaved = bSaved && bAllClean && UnexpectedPackages.IsEmpty();
+
+		TSharedPtr<FJsonObject> Receipt;
+		if (bSaved)
+		{
+			Receipt = UEAgentReliable::Ok();
+		}
+		else if (!UnexpectedPackages.IsEmpty())
+		{
+			Receipt = UEAgentReliable::Error(TEXT("SAVE_SCOPE_VIOLATION"), TEXT("saving the authorized package set also saved undeclared packages"));
+		}
+		else
+		{
+			Receipt = UEAgentReliable::Error(TEXT("SAVE_RESULT_UNKNOWN"), TEXT("the native save did not confirm every authorized package as clean"));
+		}
+		Receipt->SetStringField(TEXT("receipt_type"), TEXT("save"));
+		Receipt->SetStringField(TEXT("command_id"), Record->CommandId);
+		Receipt->SetStringField(TEXT("editor_epoch"), EditorEpoch);
+		Receipt->SetStringField(TEXT("saved_at"), FDateTime::UtcNow().ToIso8601());
+		Receipt->SetStringField(TEXT("outcome"), bSaved ? TEXT("succeeded") : TEXT("result_unknown"));
+		Receipt->SetStringField(TEXT("verification"), bSaved ? TEXT("verified") : TEXT("failed"));
+		Receipt->SetStringField(TEXT("persistence"), bSaved ? TEXT("saved") : TEXT("unknown"));
+		TArray<TSharedPtr<FJsonValue>> PackageValues;
+		for (const FString& Name : Record->Packages) PackageValues.Add(MakeShared<FJsonValueString>(Name));
+		Receipt->SetArrayField(TEXT("packages"), PackageValues);
+		TArray<TSharedPtr<FJsonValue>> UnexpectedValues;
+		for (const FString& Name : UnexpectedPackages) UnexpectedValues.Add(MakeShared<FJsonValueString>(Name));
+		Receipt->SetArrayField(TEXT("unexpected_saved_packages"), UnexpectedValues);
+		Receipt->SetStringField(TEXT("mutation_receipt"), ReceiptPath(Record->CommandId));
+		Record->ReceiptPath = OperationsDir / FString::Printf(
+			TEXT("%s.save.%s.receipt.json"), *Record->CommandId, *FGuid::NewGuid().ToString(EGuidFormats::Digits).Left(12));
+		Receipt->SetStringField(TEXT("receipt_path"), Record->ReceiptPath);
+		if (!WriteObjectAtomic(Record->ReceiptPath, Receipt, false))
+		{
+			TSharedPtr<FJsonObject> Failure = UEAgentReliable::Error(TEXT("SAVE_RECEIPT_WRITE_FAILED"), TEXT("save may have completed, but its immutable receipt could not be written"));
+			Failure->SetStringField(TEXT("command_id"), Record->CommandId);
+			Failure->SetStringField(TEXT("outcome"), TEXT("result_unknown"));
+			Failure->SetStringField(TEXT("persistence"), TEXT("unknown"));
+			return Failure;
+		}
+		return Receipt;
+	}
+
+	void HandlePackageSaved(const FString&, UPackage* Package, FObjectPostSaveContext SaveContext)
+	{
+		if (!Package || !SaveContext.SaveSucceeded() || SaveContext.IsCooking() || SaveContext.IsProceduralSave()) return;
+		const FString Name = Package->GetName();
+		PackageSaveGenerations.FindOrAdd(Name)++;
+		if (bManagedSave)
+		{
+			if (!ManagedSavePackages.Contains(Name)) UnexpectedManagedSavePackages.Add(Name);
+			return;
+		}
+		if (!ActiveJobId.IsEmpty())
+		{
+			if (TSharedPtr<FJob>* Job = Jobs.Find(ActiveJobId))
+			{
+				(*Job)->bUnexpectedSave = true;
+				(*Job)->UnexpectedSavedPackages.AddUnique(Name);
+				Transition(*(*Job), (*Job)->State, TEXT("detected save outside ueagent_save"));
+			}
+		}
+	}
+
+	void HandlePackageDirty(UPackage* Package)
+	{
+		if (!Package || !Package->IsDirty() || ActiveJobId.IsEmpty()
+			|| Package == GetTransientPackage() || Package->HasAnyPackageFlags(PKG_CompiledIn)) return;
+		TSharedPtr<FJob>* Job = Jobs.Find(ActiveJobId);
+		if (!Job) return;
+		const FString Name = Package->GetName();
+		if ((*Job)->Packages.Contains(Name)) return;
+		(*Job)->bUnexpectedDirty = true;
+		if (!(*Job)->UnexpectedDirtyPackages.Contains(Name))
+		{
+			(*Job)->UnexpectedDirtyPackages.Add(Name);
+			Transition(*(*Job), (*Job)->State, TEXT("detected dirty package outside declared write scopes"));
+		}
+	}
+
+	TSharedPtr<FJsonObject> RecoverIncomplete(bool bAutomatic)
+	{
+		TArray<FString> Files;
+		IFileManager::Get().FindFiles(Files, *(OperationsDir / TEXT("*.journal.ndjson")), true, false);
+		TArray<TSharedPtr<FJsonValue>> Recovered;
+		for (const FString& File : Files)
+		{
+			FString CommandId = File;
+			CommandId.RemoveFromEnd(TEXT(".journal.ndjson"));
+			if (FPaths::FileExists(ReceiptPath(CommandId))) continue;
+			if (const TSharedPtr<FJob>* LiveJob = Jobs.Find(CommandId);
+				LiveJob && !(*LiveJob)->bReceiptInterrupted) continue;
+
+			TSharedPtr<FJsonObject> Accepted;
+			FString Journal;
+			TArray<FString> Lines;
+			if (FFileHelper::LoadFileToString(Journal, *(OperationsDir / File)))
+			{
+				Journal.ParseIntoArrayLines(Lines, true);
+				for (const FString& Line : Lines)
+				{
+					if (UEAgentReliable::ParseObject(Line, Accepted)) break;
+				}
+			}
+			TSharedPtr<FJsonObject> Receipt = UEAgentReliable::Ok();
+			Receipt->SetStringField(TEXT("receipt_type"), TEXT("mutation"));
+			Receipt->SetStringField(TEXT("command_id"), CommandId);
+			Receipt->SetStringField(TEXT("editor_epoch"), Accepted.IsValid()
+				? UEAgentReliable::JsonStringField(Accepted, TEXT("editor_epoch")) : TEXT("unknown"));
+			Receipt->SetStringField(TEXT("recovered_by_editor_epoch"), EditorEpoch);
+			if (Accepted.IsValid())
+			{
+				for (const TCHAR* Field : { TEXT("protocol_version"), TEXT("command_digest"), TEXT("target_type"), TEXT("toolset_name"), TEXT("tool_name") })
+				{
+					const FString Value = UEAgentReliable::JsonStringField(Accepted, Field);
+					if (!Value.IsEmpty()) Receipt->SetStringField(Field, Value);
+				}
+			}
+			Receipt->SetStringField(TEXT("state"), TEXT("terminal"));
+			Receipt->SetStringField(TEXT("outcome"), TEXT("result_unknown"));
+			Receipt->SetStringField(TEXT("effect"), TEXT("unknown"));
+			Receipt->SetStringField(TEXT("verification"), TEXT("not_run"));
+			Receipt->SetStringField(TEXT("persistence"), TEXT("unknown"));
+			Receipt->SetStringField(TEXT("error_code"), TEXT("RECOVERED_INCOMPLETE_JOURNAL"));
+			Receipt->SetStringField(TEXT("error"), TEXT("Editor epoch ended without an immutable terminal receipt; no exactly-once claim is possible"));
+			Receipt->SetStringField(TEXT("recovered_at"), FDateTime::UtcNow().ToIso8601());
+			if (WriteObjectAtomic(ReceiptPath(CommandId), Receipt, false))
+			{
+				Recovered.Add(MakeShared<FJsonValueString>(CommandId));
+				Jobs.Remove(CommandId);
+				Queue.Remove(CommandId);
+				LastReceiptId = CommandId;
+			}
+		}
+		if (!Recovered.IsEmpty()) WriteStateFile();
+		TSharedPtr<FJsonObject> Result = UEAgentReliable::Ok();
+		Result->SetBoolField(TEXT("automatic"), bAutomatic);
+		Result->SetStringField(TEXT("editor_epoch"), EditorEpoch);
+		Result->SetArrayField(TEXT("recovered_command_ids"), Recovered);
+		return Result;
+	}
+
+	TSharedPtr<FJsonObject> JobJson(const FJob& Job) const
+	{
+		TSharedPtr<FJsonObject> Result = UEAgentReliable::Ok();
+		Result->SetStringField(TEXT("command_id"), Job.CommandId);
+		Result->SetStringField(TEXT("command_digest"), Job.Digest);
+		Result->SetStringField(TEXT("editor_epoch"), EditorEpoch);
+		Result->SetStringField(TEXT("state"), Job.State);
+		Result->SetStringField(TEXT("outcome"), Job.Outcome);
+		Result->SetBoolField(TEXT("command_succeeded"), Job.Outcome == TEXT("succeeded") || Job.Outcome == TEXT("completed_after_cancel_request"));
+		Result->SetStringField(TEXT("effect"), Job.Effect);
+		Result->SetStringField(TEXT("verification"), Job.Verification);
+		Result->SetStringField(TEXT("persistence"), Job.Persistence);
+		if (!Job.ErrorCode.IsEmpty()) Result->SetStringField(TEXT("error_code"), Job.ErrorCode);
+		if (!Job.ErrorMessage.IsEmpty()) Result->SetStringField(TEXT("error"), Job.ErrorMessage);
+		if (!Job.SaveToken.IsEmpty()) Result->SetStringField(TEXT("save_token"), Job.SaveToken);
+		Result->SetStringField(TEXT("accepted_at"), Job.AcceptedAt.ToIso8601());
+		if (Job.StartedAt.GetTicks() > 0) Result->SetStringField(TEXT("started_at"), Job.StartedAt.ToIso8601());
+		if (Job.FinishedAt.GetTicks() > 0) Result->SetStringField(TEXT("finished_at"), Job.FinishedAt.ToIso8601());
+		return Result;
+	}
+
+	TSharedPtr<FJsonObject> ReceiptJson(const FJob& Job)
+	{
+		TSharedPtr<FJsonObject> Receipt = JobJson(Job);
+		Receipt->SetStringField(TEXT("receipt_type"), TEXT("mutation"));
+		Receipt->SetStringField(TEXT("target_type"), Job.TargetType);
+		Receipt->SetStringField(TEXT("toolset_name"), Job.ToolsetName);
+		Receipt->SetStringField(TEXT("tool_name"), Job.ToolName);
+		Receipt->SetStringField(TEXT("lease_mode"), Job.LeaseMode);
+		Receipt->SetStringField(TEXT("verify_mode"), Job.VerifyMode);
+		Receipt->SetBoolField(TEXT("allow_preexisting_dirty_save"), Job.bAllowPreexistingDirtySave);
+		if (!Job.FaultInjection.IsEmpty()) Receipt->SetStringField(TEXT("fault_injection"), Job.FaultInjection);
+
+		TSharedPtr<FJsonObject> Before = MakeShared<FJsonObject>();
+		for (const auto& Pair : Job.BeforeSnapshots) Before->SetStringField(Pair.Key, Pair.Value.Hash);
+		TSharedPtr<FJsonObject> After = MakeShared<FJsonObject>();
+		for (const auto& Pair : Job.AfterSnapshots) After->SetStringField(Pair.Key, Pair.Value.Hash);
+		Receipt->SetObjectField(TEXT("before_snapshots"), Before);
+		Receipt->SetObjectField(TEXT("after_snapshots"), After);
+
+		TArray<TSharedPtr<FJsonValue>> Packages;
+		for (const FString& Package : Job.Packages) Packages.Add(MakeShared<FJsonValueString>(Package));
+		Receipt->SetArrayField(TEXT("packages"), Packages);
+		TArray<TSharedPtr<FJsonValue>> DirtyPackages;
+		for (const FString& Package : Job.DirtyPackages) DirtyPackages.Add(MakeShared<FJsonValueString>(Package));
+		Receipt->SetArrayField(TEXT("dirty_packages"), DirtyPackages);
+		TArray<TSharedPtr<FJsonValue>> PreexistingDirty;
+		for (const FString& Package : Job.PreexistingDirtyPackages) PreexistingDirty.Add(MakeShared<FJsonValueString>(Package));
+		Receipt->SetArrayField(TEXT("preexisting_dirty_packages"), PreexistingDirty);
+		TArray<TSharedPtr<FJsonValue>> Unexpected;
+		for (const FString& Package : Job.UnexpectedSavedPackages) Unexpected.Add(MakeShared<FJsonValueString>(Package));
+		Receipt->SetArrayField(TEXT("unexpected_saved_packages"), Unexpected);
+		TArray<TSharedPtr<FJsonValue>> UnexpectedDirty;
+		for (const FString& Package : Job.UnexpectedDirtyPackages) UnexpectedDirty.Add(MakeShared<FJsonValueString>(Package));
+		Receipt->SetArrayField(TEXT("unexpected_dirty_packages"), UnexpectedDirty);
+
+		if (!Job.RawResult.IsEmpty())
+		{
+			const FTCHARToUTF8 Utf8(*Job.RawResult);
+			if (Utf8.Length() <= UEAgentReliable::MaxInlineResultBytes)
+			{
+				Receipt->SetStringField(TEXT("result"), Job.RawResult);
+			}
+			else
+			{
+				const FString EvidencePath = EvidenceDir / (Job.CommandId + TEXT(".result.json"));
+				FFileHelper::SaveStringToFile(Job.RawResult, *EvidencePath, FFileHelper::EEncodingOptions::ForceUTF8WithoutBOM);
+				TSharedPtr<FJsonObject> Evidence = MakeShared<FJsonObject>();
+				Evidence->SetStringField(TEXT("path"), EvidencePath);
+				Evidence->SetStringField(TEXT("sha256"), UEAgentReliable::Sha256String(Job.RawResult));
+				Evidence->SetNumberField(TEXT("bytes"), Utf8.Length());
+				Receipt->SetObjectField(TEXT("result_evidence"), Evidence);
+			}
+		}
+		return Receipt;
+	}
+
+	void Transition(FJob& Job, const FString& State, const FString& Message, bool bIncludeIdentity = false)
+	{
+		Job.State = State;
+		TSharedPtr<FJsonObject> Entry = MakeShared<FJsonObject>();
+		Entry->SetStringField(TEXT("command_id"), Job.CommandId);
+		Entry->SetStringField(TEXT("command_digest"), Job.Digest);
+		Entry->SetStringField(TEXT("editor_epoch"), EditorEpoch);
+		Entry->SetNumberField(TEXT("sequence"), ++Job.Sequence);
+		Entry->SetStringField(TEXT("timestamp"), FDateTime::UtcNow().ToIso8601());
+		Entry->SetStringField(TEXT("state"), State);
+		Entry->SetStringField(TEXT("message"), Message);
+		if (bIncludeIdentity)
+		{
+			Entry->SetStringField(TEXT("protocol_version"), UEAgentReliable::ProtocolVersion);
+			Entry->SetStringField(TEXT("target_type"), Job.TargetType);
+			Entry->SetStringField(TEXT("toolset_name"), Job.ToolsetName);
+			Entry->SetStringField(TEXT("tool_name"), Job.ToolName);
+		}
+		FFileHelper::SaveStringToFile(
+			UEAgentReliable::CanonicalJson(Entry) + LINE_TERMINATOR,
+			*JournalPath(Job.CommandId),
+			FFileHelper::EEncodingOptions::ForceUTF8WithoutBOM,
+			&IFileManager::Get(), FILEWRITE_Append);
+	}
+
+	FString JournalPath(const FString& CommandId) const { return OperationsDir / (CommandId + TEXT(".journal.ndjson")); }
+	FString ReceiptPath(const FString& CommandId) const { return OperationsDir / (CommandId + TEXT(".receipt.json")); }
+
+	bool WriteObjectAtomic(const FString& Path, const TSharedPtr<FJsonObject>& Object, bool bReplace) const
+	{
+		if (!bReplace && FPaths::FileExists(Path)) return false;
+		const FString Temp = Path + TEXT(".tmp.") + FGuid::NewGuid().ToString(EGuidFormats::Digits);
+		if (!FFileHelper::SaveStringToFile(UEAgentReliable::CanonicalJson(Object), *Temp,
+			FFileHelper::EEncodingOptions::ForceUTF8WithoutBOM)) return false;
+		if (!IFileManager::Get().Move(*Path, *Temp, bReplace, true, false, true))
+		{
+			IFileManager::Get().Delete(*Temp, false, true);
+			return false;
+		}
+		return true;
+	}
+
+	TSharedPtr<FJsonObject> LoadObjectFile(const FString& Path) const
+	{
+		FString Json;
+		TSharedPtr<FJsonObject> Object;
+		return FFileHelper::LoadFileToString(Json, *Path) && UEAgentReliable::ParseObject(Json, Object) ? Object : nullptr;
+	}
+
+	void WriteStateFile() const
+	{
+		WriteObjectAtomic(FPaths::ProjectSavedDir() / TEXT("UEAgent/state.json"), State(), true);
+	}
+
+private:
+	TAtomic<bool> bInitialized{ false };
+	TAtomic<bool> bEnabled{ false };
+	TAtomic<bool> bMutationActive{ false };
+	TAtomic<bool> bPerformanceFrozen{ false };
+	bool bFaultInjectionEnabled = false;
+	bool bManagedSave = false;
+	int32 SaveTokenLifetimeSeconds = 300;
+	FString EditorEpoch;
+	FString TokenSecret;
+	FString OperationsDir;
+	FString EvidenceDir;
+	FString InboxDir;
+	FString ActiveJobId;
+	FString LastReceiptId;
+	TArray<FString> Queue;
+	TMap<FString, TSharedPtr<FJob>> Jobs;
+	TMap<FString, FString> ActiveLeases;
+	TMap<FString, int64> PackageSaveGenerations;
+	TMap<FString, FSaveToken> SaveTokens;
+	TSet<FString> ManagedSavePackages;
+	TSet<FString> UnexpectedManagedSavePackages;
+	TSet<FString> ReadOnlyTools;
+	FTSTicker::FDelegateHandle TickerHandle;
+	FDelegateHandle PackageSavedHandle;
+	FDelegateHandle PackageDirtyHandle;
+};
