+static bool TickPerformanceMonitor(float)
+{
+	if (!GMonitorActive) return false;
+	if (!IsPIERunning())
+	{
+		GMonitorActive = false;
+		GMonitorContextLost = true;
+		return false;
+	}
+	if (GMonitorWarmupRemaining > 0)
+	{
+		--GMonitorWarmupRemaining;
+		++GMonitorWarmupSkipped;
+		return true;
+	}
+	if (GMonitorSuppressFrames > 0)
+	{
+		--GMonitorSuppressFrames;
+		++GMonitorInstrumentationSkipped;
+		return true;
+	}
+
+	FPerfMonitorSample Sample;
+	Sample.Timing.TimeSeconds = FPlatformTime::Seconds() - GMonitorStartSeconds;
+	Sample.Timing.GameMs = FPlatformTime::ToMilliseconds(GGameThreadTime);
+	Sample.Timing.RenderMs = FPlatformTime::ToMilliseconds(GRenderThreadTime);
+	Sample.Timing.RhiMs = FPlatformTime::ToMilliseconds(GRHIThreadTime);
+	Sample.Timing.GpuMs = FPlatformTime::ToMilliseconds(RHIGetGPUFrameCycles());
+	Sample.Timing.bRhiAvailable = Sample.Timing.RhiMs > 0.0;
+	Sample.Timing.bGpuAvailable = Sample.Timing.GpuMs > 0.0;
+	Sample.Timing.FrameMs = FMath::Max(
+		FMath::Max3(Sample.Timing.GameMs, Sample.Timing.RenderMs, Sample.Timing.GpuMs),
+		Sample.Timing.RhiMs);
+	if (!FMath::IsFinite(Sample.Timing.FrameMs)
+		|| Sample.Timing.FrameMs <= 0.0
+		|| Sample.Timing.FrameMs > 120000.0)
+	{
+		++GMonitorInvalidSkipped;
+		return true;
+	}
+
+	FRHIMemoryStats Vram;
+	RHIGetMemoryStats(Vram);
+	if (Vram.BudgetLocal > 0)
+	{
+		Sample.Timing.VramUsedBytes = Vram.UsedLocal;
+		Sample.Timing.VramBudgetBytes = Vram.BudgetLocal;
+		Sample.Timing.VramAvailableBytes = Vram.AvailableLocal;
+		Sample.Timing.VramDemotedBytes = Vram.DemotedLocal;
+		Sample.Timing.bVramAvailable = true;
+	}
+
+	if (UWorld* World = GetMonitorWorld())
+	{
+		if (APlayerController* Controller = World->GetFirstPlayerController())
+		{
+			Controller->GetPlayerViewPoint(Sample.ViewLocation, Sample.ViewRotation);
+			Sample.bHasViewpoint = true;
+		}
+	}
+
+	if (GMonitorSamples.Num() < GMonitorMaxSamples)
+	{
+		GMonitorSamples.Add(Sample);
+	}
+	else
+	{
+		GMonitorSamples[GMonitorNextIndex] = Sample;
+		GMonitorNextIndex = (GMonitorNextIndex + 1) % GMonitorMaxSamples;
+	}
+	++GMonitorTotalSamples;
+	return true;
+}
