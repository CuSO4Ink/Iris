  <RK_Hediff_FakeEar.label>假耳朵</RK_Hediff_FakeEar.label>
  <!-- EN: An installed fake ear. -->
  <RK_Hediff_FakeEar.description>一隻已安裝的假耳朵。</RK_Hediff_FakeEar.description>
  <!-- EN: a fake ear -->
  <RK_Hediff_FakeEar.labelNoun>假耳朵</RK_Hediff_FakeEar.labelNoun>
  
  <!-- EN: fake tail -->
  <RK_Hediff_FakeTail.label>假尾巴</RK_Hediff_FakeTail.label>
  <!-- EN: An installed fake tail. -->
  <RK_Hediff_FakeTail.description>一條已安裝的假尾巴。</RK_Hediff_FakeTail.description>
  <!-- EN: a fake tail -->
  <RK_Hediff_FakeTail.labelNoun>假尾巴</RK_Hediff_FakeTail.labelNoun>
  
