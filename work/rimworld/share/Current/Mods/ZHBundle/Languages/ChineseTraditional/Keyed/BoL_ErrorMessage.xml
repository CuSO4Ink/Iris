<LanguageData>
	<!--== "Propose" == -->
	<BoL_DoPropose>求婚</BoL_DoPropose>

	<!--== "Propose to your partner by whispering words of love to him/her." == -->
	<BoL_ProposeText>向對方柔聲說一句情話並鼓起勇氣求婚。</BoL_ProposeText>

	<!--== "You are already married to the subject." == -->
	<BoL_AlreadyMaarried>對方已經結婚了。</BoL_AlreadyMaarried>
