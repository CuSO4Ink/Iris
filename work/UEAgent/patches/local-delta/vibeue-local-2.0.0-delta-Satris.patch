+	if (!CommitEditing(AssetPath, Source))
+	{
+		return Fail(FString::Printf(TEXT("DisconnectPin: SaveAsset failed for '%s'"), *AssetPath));
+	}
+	return Succeed(AssetPath, FString::Printf(TEXT("Disconnected %s.%s"), *NodeId, *InputName));
