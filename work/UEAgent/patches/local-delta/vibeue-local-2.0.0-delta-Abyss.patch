+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FVibePerfMonitorSummaryTest,
+	"VibeUE.Performance.Monitor.Summary", kPerfTestFlags)
+bool FVibePerfMonitorSummaryTest::RunTest(const FString&)
+{
+	using namespace PerformanceVerdict;
+	TArray<FTimingSample> Samples;
+	auto Add = [&Samples](double Game, double Render, double Gpu, uint64 VramUsedMB)
+	{
+		constexpr uint64 MB = 1024ull * 1024ull;
+		FTimingSample Sample;
+		Sample.TimeSeconds = Samples.Num();
+		Sample.GameMs = Game;
+		Sample.RenderMs = Render;
+		Sample.GpuMs = Gpu;
+		Sample.FrameMs = FMath::Max3(Game, Render, Gpu);
+		Sample.bGpuAvailable = true;
+		Sample.VramUsedBytes = VramUsedMB * MB;
+		Sample.VramBudgetBytes = 100ull * MB;
+		Sample.VramAvailableBytes = VramUsedMB < 100 ? (100 - VramUsedMB) * MB : 0;
+		Sample.VramDemotedBytes = VramUsedMB > 100 ? (VramUsedMB - 100) * MB : 0;
+		Sample.bVramAvailable = true;
+		Samples.Add(Sample);
+	};
+	Add(20.0, 10.0, 8.0, 80);
+	Add(25.0, 9.0, 8.0, 90);
+	Add(8.0, 9.0, 30.0, 120);
+	Samples.AddDefaulted(); // no timing: ignored rather than becoming a false pass
+
+	const FMonitorSummary S = SummarizeMonitor(Samples, 60.0f, 25.0f);
+	TestEqual(TEXT("valid samples"), S.SampleCount, 3);
+	TestEqual(TEXT("all frames exceed 60fps budget"), S.OverBudgetCount, 3);
+	TestEqual(TEXT("two frames meet hitch threshold"), S.HitchCount, 2);
+	TestEqual(TEXT("game wins two of three"), S.DominantBound, FString(TEXT("GameThread")));
+	TestEqual(TEXT("game bound count"), S.BoundCounts.FindRef(TEXT("GameThread")), 2);
+	TestEqual(TEXT("gpu bound count"), S.BoundCounts.FindRef(TEXT("GPU")), 1);
+	TestEqual(TEXT("frame p50"), S.Frame.P50Ms, 25.0, 1e-6);
+	TestEqual(TEXT("frame p95"), S.Frame.P95Ms, 30.0, 1e-6);
+	TestEqual(TEXT("unavailable RHI excluded"), S.Rhi.SampleCount, 0);
+	TestEqual(TEXT("VRAM samples"), S.VramUsed.SampleCount, 3);
+	TestEqual(TEXT("VRAM peak MB"), S.VramUsed.MaxMs, 120.0, 1e-6);
+	TestEqual(TEXT("VRAM peak percent"), S.VramUsage.MaxMs, 120.0, 1e-6);
+	TestEqual(TEXT("VRAM current MB"), S.VramCurrentUsedMB, 120.0, 1e-6);
+	TestEqual(TEXT("VRAM peak time"), S.VramPeakTimeSeconds, 2.0, 1e-6);
+	TestEqual(TEXT("VRAM over-budget frames"), S.VramOverBudgetCount, 1);
+	TestTrue(TEXT("VRAM current over budget"), S.bVramCurrentOverBudget);
+	return true;
+}
