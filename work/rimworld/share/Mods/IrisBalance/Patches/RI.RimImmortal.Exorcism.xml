      <li Class="PatchOperationConditional">
        <xpath>Defs/GeneDef[defName=&quot;RI_ZombieGene_BoneScale&quot;]/statOffsets/ArmorRating_Heat</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/GeneDef[defName=&quot;RI_ZombieGene_BoneScale&quot;]/statOffsets/ArmorRating_Heat</xpath>
          <value>
