<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: 날개안정분리소이탄 -->
  <Miho_APFSDSRounds.label>尾翼穩定脫殼穿甲彈</Miho_APFSDSRounds.label>
  <!-- EN: 물리적 타격력이 줄어드는 대신, 압도적인 관통력과 사거리, 장거리 명중률을 얻은 탄 입니다. -->
  <Miho_APFSDSRounds.description>此武器發射特殊的尾翼穩定脫殼穿甲彈藥，以犧牲傷害為代價換來了更出色的穿甲能力、射程和遠距離精度。</Miho_APFSDSRounds.description>
  <!-- EN: 날개달린 -->
  <Miho_APFSDSRounds.traitAdjectives.0>穿甲</Miho_APFSDSRounds.traitAdjectives.0>
  <!-- EN: 꿰뚫는 -->
  <Miho_APFSDSRounds.traitAdjectives.1>貫通</Miho_APFSDSRounds.traitAdjectives.1>
  <!-- EN: 안정적인 -->
  <Miho_APFSDSRounds.traitAdjectives.2>穩定</Miho_APFSDSRounds.traitAdjectives.2>
  <!-- EN: 멀리가는 -->
  <Miho_APFSDSRounds.traitAdjectives.3>遠射</Miho_APFSDSRounds.traitAdjectives.3>
  
  <!-- EN: 불타는 플라즈마 -->
  <Miho_FieryPlasma.label>燃燒等離子彈</Miho_FieryPlasma.label>
  <!-- EN: 이 플라즈마 혼합물은 주변을 쉽게 연소시키는 특징을 가지고 있습니다. -->
  <Miho_FieryPlasma.description>此武器采用燃燒等離子電池作為彈藥，命中時有幾率點燃目標。</Miho_FieryPlasma.description>
  <!-- EN: 불타는 -->
  <Miho_FieryPlasma.traitAdjectives.0>爆燃</Miho_FieryPlasma.traitAdjectives.0>
  <!-- EN: 소각하는 -->
  <Miho_FieryPlasma.traitAdjectives.1>燒卻</Miho_FieryPlasma.traitAdjectives.1>
  <!-- EN: 태우는 -->
  <Miho_FieryPlasma.traitAdjectives.2>燒焦</Miho_FieryPlasma.traitAdjectives.2>
  
  <!-- EN: 메카나이트-아케인탄 -->
  <Miho_FoxfireRounds.label>秘靈彈</Miho_FoxfireRounds.label>
  <!-- EN: 여우들의 마법이 담긴 메카나이트 탄환을 발사합니다. -->
  <Miho_FoxfireRounds.description>此武器發射註入了機械分子和美狐族心靈能量的彈藥。</Miho_FoxfireRounds.description>
  <!-- EN: 여우의 -->
  <Miho_FoxfireRounds.traitAdjectives.0>美狐</Miho_FoxfireRounds.traitAdjectives.0>
  <!-- EN: 요정의 -->
  <Miho_FoxfireRounds.traitAdjectives.1>秘靈</Miho_FoxfireRounds.traitAdjectives.1>
  <!-- EN: 마법의 -->
  <Miho_FoxfireRounds.traitAdjectives.2>法術</Miho_FoxfireRounds.traitAdjectives.2>
  <!-- EN: 초능력 -->
  <Miho_FoxfireRounds.traitAdjectives.3>靈能</Miho_FoxfireRounds.traitAdjectives.3>
  
  <!-- EN: 고에너지 플라즈마 -->
  <Miho_HeavyPlasma.label>高能等離子彈</Miho_HeavyPlasma.label>
  <!-- EN: 에너지가 높다는건 더욱 치명적이란것을 의미합니다. -->
  <Miho_HeavyPlasma.description>此武器采用高能等離子電池作為彈藥，以增加遠程冷卻時間為代價，換來更高的傷害與精度。</Miho_HeavyPlasma.description>
  <!-- EN: 무거운 -->
  <Miho_HeavyPlasma.traitAdjectives.0>重擊</Miho_HeavyPlasma.traitAdjectives.0>
  <!-- EN: 고열량의 -->
  <Miho_HeavyPlasma.traitAdjectives.1>高能</Miho_HeavyPlasma.traitAdjectives.1>
  <!-- EN: 중금속 -->
  <Miho_HeavyPlasma.traitAdjectives.2>重金屬</Miho_HeavyPlasma.traitAdjectives.2>
  
  <!-- EN: 말랑 플라즈마 -->
  <Miho_MeltyPlasma.label>強蝕等離子彈</Miho_MeltyPlasma.label>
