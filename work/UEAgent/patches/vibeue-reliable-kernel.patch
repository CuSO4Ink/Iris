+#if WITH_AUTOMATION_TESTS
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(
+	FUEAgentReliableSnapshotIdentityTest,
+	"VibeUE.UEAgentReliable.SnapshotIdentity",
+	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FUEAgentReliableSnapshotIdentityTest::RunTest(const FString&)
+{
+	const FString PackageName = TEXT("/Game/__UEAgentTests/Snapshot_") + FGuid::NewGuid().ToString(EGuidFormats::Digits);
+	UPackage* Package = CreatePackage(*PackageName);
+	UCurveFloat* Asset = NewObject<UCurveFloat>(Package, TEXT("MainAsset"), RF_Public | RF_Standalone);
+	UObject* Child = NewObject<UCurveFloat>(Asset, TEXT("Child"), RF_Transient);
+	ON_SCOPE_EXIT
+	{
+		Asset->ClearFlags(RF_Public | RF_Standalone);
+		Package->SetDirtyFlag(false);
+		Asset->MarkAsGarbage();
+		Package->MarkAsGarbage();
+	};
+	if (!TestEqual(TEXT("fixture has a primary asset for the regression"), Package->FindAssetInPackage(), static_cast<UObject*>(Asset))) return false;
+	const FString CdoPath = GetDefault<UCurveFloat>()->GetPathName();
+	const TArray<FString> Scopes = {
+		PackageName,
+		TEXT("object:") + Asset->GetPathName(),
+		TEXT("object:") + Child->GetPathName(),
+		TEXT("object:") + PackageName + TEXT(".Missing"),
+		TEXT("object:") + Asset->GetPathName() + TEXT(":MissingChild"),
+		TEXT("object:") + CdoPath,
+	};
+	TArray<TSharedPtr<FJsonValue>> Values;
+	for (const FString& Scope : Scopes) Values.Add(MakeShared<FJsonValueString>(Scope));
+	TSharedPtr<FJsonObject> Parameters = MakeShared<FJsonObject>();
+	Parameters->SetArrayField(TEXT("scopes"), Values);
+    const auto Identity = FUEAgentReliableKernel::Get().Invoke(TEXT("ueagent_state"), MakeShared<FJsonObject>());
+    Parameters->SetStringField(TEXT("expected_project"), Identity->GetStringField(TEXT("project_file")));
+    Parameters->SetStringField(TEXT("editor_epoch"), Identity->GetStringField(TEXT("editor_epoch")));
+	const TSharedPtr<FJsonObject> Result = FUEAgentReliableKernel::Get().Invoke(TEXT("ueagent_snapshot"), Parameters);
+	const TArray<TSharedPtr<FJsonValue>>* Snapshots = nullptr;
+	if (!TestTrue(TEXT("snapshot result is present"), Result->TryGetArrayField(TEXT("snapshots"), Snapshots) && Snapshots && Snapshots->Num() == Scopes.Num())) return false;
+	TestEqual(TEXT("package scope retains primary-asset resolution"), (*Snapshots)[0]->AsObject()->GetStringField(TEXT("object")), Asset->GetPathName());
+	TestEqual(TEXT("explicit asset resolves exactly"), (*Snapshots)[1]->AsObject()->GetStringField(TEXT("object")), Asset->GetPathName());
+	TestEqual(TEXT("explicit child resolves exactly"), (*Snapshots)[2]->AsObject()->GetStringField(TEXT("object")), Child->GetPathName());
+	for (int32 Index : { 3, 4 })
+	{
+		const TSharedPtr<FJsonObject> Missing = (*Snapshots)[Index]->AsObject();
+		TestFalse(TEXT("missing object does not resolve to the primary asset"), Missing->GetBoolField(TEXT("exists")));
+		TestEqual(TEXT("missing object keeps the requested identity"), Missing->GetStringField(TEXT("object")), Scopes[Index].RightChop(7));
+		TestFalse(TEXT("missing object does not inherit another object's class"), Missing->HasField(TEXT("class")));
+	}
+	TestTrue(TEXT("CDO exists"), (*Snapshots)[5]->AsObject()->GetBoolField(TEXT("exists")));
+	TestEqual(TEXT("CDO resolves exactly"), (*Snapshots)[5]->AsObject()->GetStringField(TEXT("object")), CdoPath);
+	return true;
+}
+
