    <!-- EN: {0} was remove from the pool of melee weapon stats -->
  <SK_WeaponMastery_MessageDisabledMeleeStat>{0}已被從近戰武器的屬性池中移除</SK_WeaponMastery_MessageDisabledMeleeStat>
