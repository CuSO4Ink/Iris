          <xpath>Defs/ThingDef[defName="Kiiro_ValorTiara"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;Kiiro_Spear&quot;]/statBases/AccuracyTouch</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;Kiiro_Spear&quot;]/statBases/AccuracyTouch</xpath>
          <value>
            <AccuracyTouch>1.00</AccuracyTouch>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Kiiro_Spear"]/statBases</xpath>
