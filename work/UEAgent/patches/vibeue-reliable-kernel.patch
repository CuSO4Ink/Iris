+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FUEAgentMinimalVerificationTest,
+    "VibeUE.UEAgentReliable.TargetedVerification", EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+bool FUEAgentMinimalVerificationTest::RunTest(const FString&)
+{
+    using namespace UEAgentReliable;
+    TestTrue(TEXT("targeted subset"), Matches(ParseValue(TEXT("{\"count\":40,\"other\":2}")), ParseValue(TEXT("{\"count\":40}"))));
+    TestFalse(TEXT("wrong value fails"), Matches(ParseValue(TEXT("{\"count\":24}")), ParseValue(TEXT("{\"count\":40}"))));
+    TestFalse(TEXT("missing null is not an observed null"), Matches(ParseValue(TEXT("{}")), ParseValue(TEXT("{\"value\":null}"))));
+    TestFalse(TEXT("array order matters"), Matches(ParseValue(TEXT("[1,2]")), ParseValue(TEXT("[2,1]"))));
+    TestTrue(TEXT("false is preserved"), Matches(ParseValue(TEXT("false")), ParseValue(TEXT("false"))));
+    TestEqual(TEXT("canonical object order"), CanonicalJson(ParseValue(TEXT("{\"b\":2,\"a\":1}"))), CanonicalJson(ParseValue(TEXT("{\"a\":1,\"b\":2}"))));
+    return true;
+}
