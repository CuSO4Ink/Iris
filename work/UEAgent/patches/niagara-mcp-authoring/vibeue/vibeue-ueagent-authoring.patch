+FNiagaraScratchResult UNiagaraScratchPadService::RegisterScratchModuleForEmitter(
+	const FString& SystemPath,
+	const FString& EmitterName,
+	const FString& ModuleName)
+{
+	FNiagaraScratchResult R;
+	UNiagaraSystem* System = LoadSystem(SystemPath);
+	if (!System) { R.Message = TEXT("System not found"); return R; }
+	FNiagaraEmitterHandle* Handle = FindEmitterHandle(System, EmitterName);
+	if (!Handle) { R.Message = TEXT("Emitter not found"); return R; }
+	FVersionedNiagaraEmitterData* EmitterData = Handle->GetEmitterData();
+	if (!EmitterData) { R.Message = TEXT("Emitter has no editable data"); return R; }
+	UNiagaraNodeFunctionCall* Call = FindModuleNodeOnEmitter(EmitterData, ModuleName);
+	if (!Call || !Call->FunctionScript) { R.Message = TEXT("Module not found"); return R; }
+	UNiagaraScratchPadContainer* Container = GetOrCreateScratchContainer(Handle, EmitterData);
+	if (!Container) { R.Message = TEXT("Could not access scratch-pad container"); return R; }
+	if (Container->FindIndexForScript(Call->FunctionScript) != INDEX_NONE)
+	{
+		R.bSuccess = true;
+		R.Message = TEXT("already registered");
+		return R;
+	}
+	Container->Modify();
+	Container->Scripts.Add(Call->FunctionScript);
+	System->MarkPackageDirty();
+	R.bSuccess = true;
+	R.Message = TEXT("registered");
+	return R;
+}
