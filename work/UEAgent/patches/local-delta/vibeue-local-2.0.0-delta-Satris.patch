-		{
-			PropInput->Expression = NewExpression;
-		}
-	}
-	
-	// Delete old expression
-	UMaterialEditingLibrary::DeleteMaterialExpression(Material, OldExpression);
-	
-	RefreshMaterialGraph(Material);
-	
-	return BuildExpressionInfo(NewExpression);
-}
