          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RI_RangeWeapon_DetainGhostFlag"]/statBases</xpath>
          <value>
            <AccuracyLong>0.75</AccuracyLong>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/GeneDef[defName=&quot;Nzflm_Ev_RippingClaws&quot;]/statOffsets/MeleeDamageFactor</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/GeneDef[defName=&quot;Nzflm_Ev_RippingClaws&quot;]/statOffsets/MeleeDamageFactor</xpath>
          <value>
            <MeleeDamageFactor>0.75</MeleeDamageFactor>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/GeneDef[defName="Nzflm_Ev_RippingClaws"]/statOffsets</xpath>
          <value>
            <MeleeDamageFactor>0.75</MeleeDamageFactor>
