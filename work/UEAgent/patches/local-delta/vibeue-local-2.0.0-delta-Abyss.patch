+void FModule::HandleAssetPackageSaved(
+	const FString& PackageFileName,
+	UPackage* Package,
+	FObjectPostSaveContext SaveContext)
+{
+	if (!MaterialAICache::IsEnabled()
+		|| !Package
+		|| !SaveContext.SaveSucceeded()
+		|| SaveContext.IsCooking()
+		|| SaveContext.IsProceduralSave()
+		|| SaveContext.IsFromAutoSave()
+		|| (!Cast<UMaterial>(Package->FindAssetInPackage())
+			&& !Cast<UMaterialFunction>(Package->FindAssetInPackage())
+			&& !Cast<UMaterialInstanceConstant>(Package->FindAssetInPackage())
+			&& !Cast<UBlueprint>(Package->FindAssetInPackage())
+			&& !Cast<UNiagaraSystem>(Package->FindAssetInPackage())))
+	{
+		return;
+	}
+
+	FString OutputPath;
+	FString Error;
+	if (MaterialAICache::Write(Package->GetName(), PackageFileName, OutputPath, Error))
+	{
+		UE_LOG(LogTemp, Display, TEXT("VibeUE: refreshed AI cache %s"), *OutputPath);
+	}
+	else
+	{
+		UE_LOG(LogTemp, Warning, TEXT("VibeUE: AI cache failed for %s: %s"), *Package->GetName(), *Error);
+	}
+}
