+static TSharedPtr<FJsonObject> BuildMonitorSnapshot(const FString& Status)
+{
+	TArray<PerformanceVerdict::FTimingSample> Timings;
+	Timings.Reserve(GMonitorSamples.Num());
+	for (const FPerfMonitorSample& Sample : GMonitorSamples) Timings.Add(Sample.Timing);
+	const PerformanceVerdict::FMonitorSummary Summary = PerformanceVerdict::SummarizeMonitor(
+		Timings,
+		GMonitorTargetFps,
+		GMonitorHitchThresholdMs);
+
+	double WindowStart = TNumericLimits<double>::Max();
+	double WindowEnd = 0.0;
+	for (const FPerfMonitorSample& Sample : GMonitorSamples)
+	{
+		WindowStart = FMath::Min(WindowStart, Sample.Timing.TimeSeconds);
+		WindowEnd = FMath::Max(WindowEnd, Sample.Timing.TimeSeconds);
+	}
+	const double WindowSeconds = GMonitorSamples.Num() > 1 ? FMath::Max(0.0, WindowEnd - WindowStart) : 0.0;
+	const double SampleDenominator = FMath::Max(1, Summary.SampleCount);
+
+	TSharedPtr<FJsonObject> Budget = MakeShared<FJsonObject>();
+	Budget->SetNumberField(TEXT("target_fps"), RoundPerf(Summary.TargetFps));
+	Budget->SetNumberField(TEXT("budget_ms"), RoundPerf(Summary.BudgetMs));
+	Budget->SetNumberField(TEXT("hitch_threshold_ms"), RoundPerf(Summary.HitchThresholdMs));
+	Budget->SetNumberField(TEXT("over_budget_frames"), Summary.OverBudgetCount);
+	Budget->SetNumberField(TEXT("over_budget_pct"), RoundPerf(100.0 * Summary.OverBudgetCount / SampleDenominator));
