+static FString BuildSuccessJson(const TSharedRef<FJsonObject>& Data)
+{
+	FString Out;
+	TSharedRef<TJsonWriter<>> Writer = TJsonWriterFactory<>::Create(&Out);
+	FJsonSerializer::Serialize(Data, Writer);
+	return Out;
+}
