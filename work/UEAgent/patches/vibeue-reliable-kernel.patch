+
+FString FUEAgentReliableKernel::GetControlToolDescription(const FString& ToolName)
+{
+	if (ToolName == TEXT("ueagent_state")) return TEXT("Read the reliable editor epoch, queue and dirty packages.");
+	if (ToolName == TEXT("ueagent_submit")) return TEXT("Execute one typed task with optional targeted readback and exact save. Gateway waits locally for its result.");
+	if (ToolName == TEXT("ueagent_get_job")) return TEXT("Read a reliable command's current job state or immutable terminal receipt.");
+	if (ToolName == TEXT("ueagent_cancel")) return TEXT("Cancel a queued job or request cancellation of an active job without releasing an uncertain lease early.");
+	if (ToolName == TEXT("ueagent_snapshot")) return TEXT("Read bounded live-editor diagnostic snapshots for package, object, world, selection, or viewport scopes.");
+	if (ToolName == TEXT("ueagent_batch_read")) return TEXT("Execute up to 64 bounded state/snapshot/job/receipt reads in one MCP round trip.");
+	if (ToolName == TEXT("ueagent_save")) return TEXT("Validate a mutation-issued task record, recheck snapshots and package generations, then save exactly the authorized packages.");
+	if (ToolName == TEXT("ueagent_recover")) return TEXT("Scan durable journals and issue honest RESULT_UNKNOWN receipts for commands left incomplete by a previous editor epoch.");
+	return TEXT("UEAgent reliable editor control tool.");
+}
