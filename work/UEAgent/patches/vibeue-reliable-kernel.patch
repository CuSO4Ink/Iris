+		virtual FString GetDescription() const override { return Description; }
+		virtual TSharedPtr<FJsonObject> GetInputJsonSchema() const override { return InputSchema; }
+
+		virtual void RunAsync(
+			const FModelContextProtocolToolRequestId&,
+			const TSharedPtr<FJsonObject>& Params,
+			const FResultCallback& OnComplete) override
+		{
+			auto Execute = [ToolName = Name, Params, OnComplete]()
+			{
+				TSharedPtr<FJsonObject> Result = FUEAgentReliableKernel::Get().Invoke(ToolName, Params);
+				bool bSuccess = false;
+				if (!Result.IsValid() || !Result->TryGetBoolField(TEXT("success"), bSuccess))
+				{
+					OnComplete(UE::ModelContextProtocol::MakeErrorResult(TEXT("UEAgent reliable kernel returned an invalid result")));
+					return;
+				}
+				if (!bSuccess)
+				{
+					FString Json;
+					const TSharedRef<TJsonWriter<TCHAR, TCondensedJsonPrintPolicy<TCHAR>>> Writer =
+						TJsonWriterFactory<TCHAR, TCondensedJsonPrintPolicy<TCHAR>>::Create(&Json);
+					FJsonSerializer::Serialize(Result.ToSharedRef(), Writer);
+					OnComplete(UE::ModelContextProtocol::MakeErrorResult(Json));
+					return;
+				}
+				TSharedPtr<FJsonValue> Structured = MakeShared<FJsonValueObject>(Result);
+				OnComplete(UE::ModelContextProtocol::MakeStructuredContentResult(Structured));
+			};
+
+			if (IsInGameThread()) Execute();
+			else AsyncTask(ENamedThreads::GameThread, MoveTemp(Execute));
+		}
+
+	private:
+		FString Name;
+		FString Description;
+		TSharedPtr<FJsonObject> InputSchema;
+	};
