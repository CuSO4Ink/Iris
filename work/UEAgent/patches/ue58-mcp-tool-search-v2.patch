+			}
+			FString Name;
+			Tool->TryGetStringField(TEXT("name"), Name);
+			const bool bMatches = ToolName.IsEmpty()
+				|| Name.Equals(ToolName, ESearchCase::IgnoreCase)
+				|| Name.EndsWith(TEXT(".") + ToolName, ESearchCase::IgnoreCase);
+			if (!bMatches)
