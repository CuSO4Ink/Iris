+static FString GetTerrainBaseUrl()
+{
+	FString Url = TEXT("https://www.vibeue.com");
+	GConfig->GetString(TEXT("VibeUE.Terrain"), TEXT("ApiBaseUrl"), Url, GEngineIni);
+	return Url;
+}
