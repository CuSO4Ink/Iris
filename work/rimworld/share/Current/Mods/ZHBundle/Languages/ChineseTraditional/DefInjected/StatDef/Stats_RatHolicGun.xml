<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: ranged cooldown reduction -->
  <RK_Stat_RangeCoolDown.label>遠程冷卻時間縮減</RK_Stat_RangeCoolDown.label>
  <!-- EN: Reduces the cooldown time of ranged weapons. This stat is used by RatHolic Gun spooling effect. -->
  <RK_Stat_RangeCoolDown.description>遠程武器冷卻時間會根據此項的值降低。此屬性供鼠族吱特林機槍的預熱效果使用。</RK_Stat_RangeCoolDown.description>
  <!-- EN: {0} s -->
  <RK_Stat_RangeCoolDown.formatString>{0}秒</RK_Stat_RangeCoolDown.formatString>
  
  <!-- EN: ranged cooldown multiplier -->
  <RK_Stat_RangeCoolDownMultiplier.label>遠程冷卻時間乘數</RK_Stat_RangeCoolDownMultiplier.label>
  <!-- EN: Multiplies the cooldown time of ranged weapons. This stat is used by RatHolic Gun spooling effect with statFactors. -->
  <RK_Stat_RangeCoolDownMultiplier.description>遠程武器冷卻時間會乘以此項的值。此屬性供鼠族吱特林機槍的預熱效果使用。</RK_Stat_RangeCoolDownMultiplier.description>
  <!-- EN: {0}× -->
  <RK_Stat_RangeCoolDownMultiplier.formatString>{0}×</RK_Stat_RangeCoolDownMultiplier.formatString>
  
</LanguageData>