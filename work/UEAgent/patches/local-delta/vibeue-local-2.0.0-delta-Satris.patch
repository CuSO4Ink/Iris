-		FFoliageInfo* FoliageInfo = IFA->FindInfo(FoliageType);
-		if (FoliageInfo)
-		{
-			TArray<const FFoliageInstance*> InstancePtrs;
-			InstancePtrs.Reserve(NewInstances.Num());
-			for (const FFoliageInstance& Inst : NewInstances)
