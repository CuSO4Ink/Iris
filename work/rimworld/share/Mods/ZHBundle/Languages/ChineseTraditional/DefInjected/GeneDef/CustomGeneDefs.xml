  <!-- EN: nimble -->
  <RK_Gene_Nimble.label>反應靈敏</RK_Gene_Nimble.label>
  <!-- EN: Carriers of this gene have heightened sensory receptor sensitivity, allowing them to better detect nearby threats and evade close-range attacks more effectively. -->
  <RK_Gene_Nimble.description>基因擁有者有著非常敏銳的感知能力，能更好地偵測周圍威脅並提高近戰閃避率。</RK_Gene_Nimble.description>
  <!-- EN: nimble -->
  <RK_Gene_Nimble.labelShortAdj>反應靈敏</RK_Gene_Nimble.labelShortAdj>
  
  <!-- EN: poor eyesight -->
  <RK_Gene_PoorEyesight.label>弱視</RK_Gene_PoorEyesight.label>
  <!-- EN: Carriers of this gene have difficulty with precision aiming, resulting in slower aim time and research speed. -->
  <RK_Gene_PoorEyesight.description>基因擁有者視力不佳，這會影響其射擊精度、瞄準時間和研究速度。</RK_Gene_PoorEyesight.description>
  <!-- EN: poor eyesight -->
  <RK_Gene_PoorEyesight.labelShortAdj>弱視</RK_Gene_PoorEyesight.labelShortAdj>
  
  <!-- EN: small body -->
  <RK_Gene_SmallBody.label>嬌小身軀</RK_Gene_SmallBody.label>
  <!-- EN: Small, compact body that dodges better but hits weaker and carries less. -->
  <RK_Gene_SmallBody.description>基因擁有者有著嬌小緊湊的身軀，雖然非常靈巧，但近戰命中率和攜帶能力較差。</RK_Gene_SmallBody.description>
  <!-- EN: small-bodied -->
  <RK_Gene_SmallBody.labelShortAdj>嬌小身軀</RK_Gene_SmallBody.labelShortAdj>
  
  <!-- EN: thin tail -->
  <RK_Gene_ThinTail.label>細長尾巴</RK_Gene_ThinTail.label>
