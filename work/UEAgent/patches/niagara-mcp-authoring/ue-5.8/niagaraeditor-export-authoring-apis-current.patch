+void UNiagaraExternalEditUtilities::GetUserParameterHierarchy(UNiagaraSystem* System, FNiagaraExt_UserParameterHierarchy& OutHierarchy, FNiagaraExternalEditContext& Context)
+{
+	if (!Context.CheckSystem(System))
+	{
+		return;
+	}
+
+	UHierarchyRoot* Root = nullptr;
+	if (UNiagaraSystemEditorData* EditorData = Cast<UNiagaraSystemEditorData>(System->GetEditorData()))
+	{
+		Root = EditorData->UserParameterHierarchy;
+	}
+
+	TMap<FString, int32> CategoryIndex;
+	auto BucketFor = [&OutHierarchy, &CategoryIndex](const FString& CategoryName) -> FNiagaraExt_UserParameterCategory&
+	{
+		if (int32* Found = CategoryIndex.Find(CategoryName))
+		{
+			return OutHierarchy.Categories[*Found];
+		}
+		FNiagaraExt_UserParameterCategory NewEntry;
+		NewEntry.Category = CategoryName;
+		CategoryIndex.Add(CategoryName, OutHierarchy.Categories.Add(NewEntry));
+		return OutHierarchy.Categories.Last();
+	};
+
+	if (Root != nullptr)
+	{
+		for (const TObjectPtr<UHierarchyElement>& Child : Root->GetChildren())
+		{
+			if (const UHierarchyCategory* Category = Cast<UHierarchyCategory>(Child))
+			{
+				FNiagaraExt_UserParameterCategory& Bucket = BucketFor(Category->GetCategoryName().ToString());
+				for (const TObjectPtr<UHierarchyElement>& CatChild : Category->GetChildren())
+				{
+					if (CatChild->IsA<UNiagaraHierarchyUserParameter>())
+					{
+						Bucket.ParameterNames.Add(CatChild->ToString());
+					}
+				}
+			}
+			else if (Child->IsA<UNiagaraHierarchyUserParameter>())
+			{
+				BucketFor(TEXT("")).ParameterNames.Add(Child->ToString());
+			}
+		}
+	}
+
+	TArray<FNiagaraVariable> UserParameters;
+	System->GetExposedParameters().GetUserParameters(UserParameters);
+	for (const FNiagaraVariable& UserParameter : UserParameters)
+	{
+		const FString RawName = UserParameter.GetName().ToString();
+		FString ShortName = RawName;
+		ShortName.RemoveFromStart(TEXT("User."));
+		bool bFound = false;
+		for (const FNiagaraExt_UserParameterCategory& Entry : OutHierarchy.Categories)
+		{
+			for (const FString& Existing : Entry.ParameterNames)
+			{
+				FString ExistingShort = Existing;
+				ExistingShort.RemoveFromStart(TEXT("User."));
+				if (ExistingShort == ShortName)
+				{
+					bFound = true;
+					break;
+				}
+			}
+			if (bFound)
+			{
+				break;
+			}
+		}
+		if (!bFound)
+		{
+			BucketFor(TEXT("")).ParameterNames.Add(RawName.StartsWith(TEXT("User.")) ? RawName : TEXT("User.") + RawName);
+		}
+	}
+}
