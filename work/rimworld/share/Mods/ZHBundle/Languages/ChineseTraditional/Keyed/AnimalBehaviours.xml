	<!-- Mod options -->
	
	<!-- EN: These animal behaviours options will affect all animal mods that share code from the Vanilla Expanded Framework -->
  <VCE_AffectsAllAnimalMods>這些動物行為選項將影響所有使用原版擴展框架的動物Mod</VCE_AffectsAllAnimalMods>
	<!-- EN: Allow corpse decaying mechanics (for example, Helixien slug's effect) -->
  <VCE_CorpseDecayingEffectOption>允許尸體腐爛機制（例如腐尸蛞蝓）</VCE_CorpseDecayingEffectOption>
	<!-- EN: Allow digging when hungry mechanics (for example, Frostmites digging corpses) -->
  <VCE_DigWhenHungryOption>允許動物饑餓時挖掘食物的機制（例如霜蟎挖掘屍體）</VCE_DigWhenHungryOption>
	<!-- EN: Allows animals digging for things periodically -->
  <VCE_DigPeriodicallyOption>允許動物定期挖掘物品</VCE_DigPeriodicallyOption>
	<!-- EN: Allow animal particles (gas and filth) -->
  <VCE_AnimalParticlesOption>允許動物產生粒子效果（例如氣體和污物）</VCE_AnimalParticlesOption>
	<!-- EN: Allow asexual reproduction -->
  <VCE_AsexualReproductionOption>允許無性繁殖</VCE_AsexualReproductionOption>
	<!-- EN: Asexual reproduction disabled via mod options -->
  <VFE_AsexualReproductionDisabled>通過Mod選項禁用無性繁殖</VFE_AsexualReproductionDisabled>
	<!-- EN: Allow "blink" mechanics (for example, Skiphounds) -->
  <VCE_BlinkMechanicsOption>允許“閃現”機制（例如閃現獵犬）</VCE_BlinkMechanicsOption>
	<!-- EN: Allow animals building things (for example, beavers building dams) -->
  <VCE_BuildPeriodicallyOption>允許動物建造物品（例如海貍建壩）</VCE_BuildPeriodicallyOption>	
	<!-- EN: Allow animals recharging nearby batteries or refueling -->
  <VCE_ChargeBatteriesOption>允許動物為附近的蓄電池充電或為設備補充燃料</VCE_ChargeBatteriesOption>
	<!-- EN: Allow animals' eggs that explode (such as dragons') -->
  <VCE_ExplodingEggsOption>允許動物的蛋爆炸</VCE_ExplodingEggsOption>
	<!-- EN: Allow animals "hovering", ignoring terrain movement costs and waterstriding -->
  <VCE_HoveringOption>允許動物通過“懸浮”來免受地形帶來的移動速度懲罰</VCE_HoveringOption>
	<!-- EN: Allow animals changing graphics (for example, Chameleon Yak) -->
  <VCE_GraphicChangingOption>允許動物改變自身貼圖（例如變色牦牛）</VCE_GraphicChangingOption>
	<!-- EN: Allows animals causing hediffs, mental states or thoughts -->
  <VCE_EffecterOption>允許動物造成健康狀態、心理狀態或想法方面的影響</VCE_EffecterOption>
	<!-- EN: Allow health regeneration (active and passive) -->
  <VCE_RegenerationOption>允許動物再生能力（主動或被動）</VCE_RegenerationOption>
	<!-- EN: Allow animals to auto-resurrect (for example Phoenix Owlcat) -->
  <VCE_ResurrectionOption>允許動物自動復活（例如鳳凰貓）</VCE_ResurrectionOption>
	<!-- EN: Allow some animals to be untameable -->
  <VCE_UntameableOption>允許部分動物無法被馴服</VCE_UntameableOption>
