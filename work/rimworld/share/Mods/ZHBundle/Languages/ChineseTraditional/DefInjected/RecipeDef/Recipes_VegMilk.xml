<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: extract milk from almonds -->
  <VCE_MilkFromAlmonds.label>用杏仁制奶</VCE_MilkFromAlmonds.label>
  <!-- EN: Extract vegetable milk from almonds. This milk can be used in any recipe that asks for milk.\n\nVegetable milks are generally inefficient, as a lot of nutrition is lost in the process. -->
  <VCE_MilkFromAlmonds.description>從杏仁里提取植物乳。所產出的奶可以像普通牛奶一樣使用。\n\n植物乳的性價比不高，因為大量營養在提取過程中被浪費了。</VCE_MilkFromAlmonds.description>
  <!-- EN: Extracting milk from almonds. -->
  <VCE_MilkFromAlmonds.jobString>正在用杏仁制奶</VCE_MilkFromAlmonds.jobString>
  
