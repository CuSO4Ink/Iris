<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>MelonDove.WolfeinRace</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;W_Bullet_Missile&quot;]/projectile/damageAmountBase</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;W_Bullet_Missile&quot;]/projectile/damageAmountBase</xpath>
          <value>
            <damageAmountBase>60</damageAmountBase>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="W_Bullet_Missile"]/projectile</xpath>
          <value>
            <damageAmountBase>60</damageAmountBase>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;W_Weapon_Melee_AIPTChainSaw&quot;]/tools/li[1]/power</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;W_Weapon_Melee_AIPTChainSaw&quot;]/tools/li[1]/power</xpath>
          <value>
            <power>11.2</power>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="W_Weapon_Melee_AIPTChainSaw"]/tools/li[1]</xpath>
          <value>
            <power>11.2</power>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;W_Weapon_Melee_PrototypeGunlance&quot;]/tools/li[2]/power</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;W_Weapon_Melee_PrototypeGunlance&quot;]/tools/li[2]/power</xpath>
          <value>
            <power>33.6</power>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="W_Weapon_Melee_PrototypeGunlance"]/tools/li[2]</xpath>
          <value>
            <power>33.6</power>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;Wolfein_RedCombatHelmet&quot;]/statBases/ArmorRating_Sharp</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;Wolfein_RedCombatHelmet&quot;]/statBases/ArmorRating_Sharp</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Wolfein_RedCombatHelmet"]/statBases</xpath>
          <value>
            <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          </value>
        </nomatch>
      </li>
      </operations>
    </match>
  </Operation>
</Patch>
