<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>BreadMo.Cinders</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;Cinder_Bullet_RPG&quot;]/projectile/damageAmountBase</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;Cinder_Bullet_RPG&quot;]/projectile/damageAmountBase</xpath>
          <value>
            <damageAmountBase>60</damageAmountBase>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Cinder_Bullet_RPG"]/projectile</xpath>
          <value>
            <damageAmountBase>60</damageAmountBase>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;Cinder_Bullet_RPG&quot;]/projectile/armorPenetrationBase</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;Cinder_Bullet_RPG&quot;]/projectile/armorPenetrationBase</xpath>
          <value>
            <armorPenetrationBase>0.9</armorPenetrationBase>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Cinder_Bullet_RPG"]/projectile</xpath>
          <value>
            <armorPenetrationBase>0.9</armorPenetrationBase>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;Cinder_FumeGreatswordM&quot;]/tools/li[1]/power</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;Cinder_FumeGreatswordM&quot;]/tools/li[1]/power</xpath>
          <value>
            <power>14.0</power>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Cinder_FumeGreatswordM"]/tools/li[1]</xpath>
          <value>
            <power>14.0</power>
          </value>
        </nomatch>
      </li>
      </operations>
    </match>
  </Operation>
</Patch>
