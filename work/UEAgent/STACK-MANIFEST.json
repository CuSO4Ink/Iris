{
  "schema": "ueagent-stack-v1",
  "engine": {
    "family": "UnrealEngine",
    "major": 5,
    "minor": 8,
    "patch": 1,
    "compatible_changelist": 55116800,
    "source_required_for_engine_patches": true
  },
  "profiles": {
    "default": {
      "name": "compact-mcp",
      "apply": [
        "patches/ue58-mcp-tool-search.patch"
      ],
      "install_scope": "engine"
    },
    "base": {
      "apply": [
        "patches/vibeue-ueagent.patch",
        "patches/vibeue-performance-monitor.patch",
        "patches/vibeue-mcp-shutdown-guard.patch",
        "patches/vibeue-reliable-kernel.patch",
        "patches/vibeue-material-diagnostic-doc.patch"
      ],
      "vibeue_ref": "6a0617cfb05aaced82d6613e88b1572fe7452eaa",
      "vibeue_fetch_ref": "6a0617cfb05aaced82d6613e88b1572fe7452eaa",
      "vibeue_merge_base_ref": "271f48771d077179fb597dc285ab5b898c5e8038",
      "install_scope": "engine",
      "source_engine_required": true
    },
    "niagara-authoring": {
      "apply": [
        "patches/ue58-niagara-toolsets.patch",
        "patches/niagara-mcp-authoring/ue-5.8/niagaraeditor-export-authoring-apis-current.patch",
        "patches/niagara-mcp-authoring/vibeue/vibeue-ueagent-authoring.patch",
        "patches/niagara-mcp-authoring/vibeue/vibeue-refresh-module-call-nodes.patch",
        "patches/vibeue-performance-monitor.patch",
        "patches/vibeue-mcp-shutdown-guard.patch",
        "patches/vibeue-reliable-kernel.patch",
        "patches/vibeue-material-diagnostic-doc.patch"
      ],
      "install_scope": "engine",
      "status": "package_verified",
      "target_activation": "smoke_required",
      "warning": "This replaces the core VibeUE patch; never apply both profiles together."
    },
    "engine-extensions": {
      "apply": [
        "patches/ue58-engine-extensions.patch"
      ],
      "install_scope": "engine",
      "status": "package_verified"
    }
  },
  "project_profiles": {
    "abyss": {
      "name": "abyss-project",
      "project_name": "Abyss",
      "vibeue_compatibility_patch": "patches/vibeue-abyss-compatibility.patch",
      "external_plugins": [
        {
          "name": "GaussianSplattingForUnrealEngine",
          "descriptor": "Plugins/GaussianSplattingForUnrealEngine/GaussianSplattingForUnrealEngine.uplugin",
          "version": 1,
          "versionName": "0.1-reconstruction"
        },
        {
          "name": "GaussianVolume",
          "descriptor": "Plugins/GaussianVolume/GaussianVolume.uplugin",
          "version": 1,
          "versionName": "0.1"
        },
        {
          "name": "KawaiiPhysics",
          "descriptor": "Plugins/KawaiiPhysics/KawaiiPhysics.uplugin",
          "version": 1,
          "versionName": "1.21.0"
        },
        {
          "name": "NeuralVolumeProxy",
          "descriptor": "Plugins/NeuralVolumeProxy/NeuralVolumeProxy.uplugin",
          "version": 2,
          "versionName": "0.2.0"
        },
        {
          "name": "SideFX_Labs",
          "descriptor": "Plugins/SideFX_Labs/SideFX_Labs.uplugin",
          "version": 21,
          "versionName": "21.0"
        },
        {
          "name": "UsfLoader",
          "descriptor": "Plugins/UsfLoader/UsfLoader.uplugin",
          "version": 1,
          "versionName": "1.0"
        },
        {
          "name": "VRM4U",
          "descriptor": "Plugins/VRM4U/VRM4U.uplugin",
          "version": 1,
          "versionName": "1.0"
        }
      ],
      "project_settings": {
        "r.VolumetricCloud.ConservativeDensity.SDFMaxStep": 32
      }
    }
  },
  "runtime": {
    "endpoint": "http://127.0.0.1:8000/mcp",
    "required_engine_plugins": [
      "ModelContextProtocol",
      "EditorToolset",
      "VibeUE"
    ],
    "vibeue_engine_path": "Engine/Plugins/AI/VibeUE",
    "mcp_engine_config": "Engine/Config/BaseEditorPerProjectUserSettings.ini",
    "reliable_protocol": "3.0.0",
    "mutation_transport": "ueagent-command-queue",
    "control_tools": [
      "ueagent_state",
      "ueagent_submit",
      "ueagent_get_job",
      "ueagent_cancel",
      "ueagent_snapshot",
      "ueagent_batch_read",
      "ueagent_save",
      "ueagent_recover"
    ],
    "persistence": {
      "state": "Saved/UEAgent/state.json",
      "operations": "Saved/UEAgent/Operations",
      "inbox": "Saved/UEAgent/Inbox",
      "evidence": "Saved/UEAgent/Evidence"
    },
    "save_policy": "targeted readback -> exact task package set -> checked save result by command_id",
    "gateway": "scripts/mcp_gateway.ps1",
    "projection_profiles": [
      "identity",
      "topology",
      "logic",
      "runtime",
      "hlsl",
      "changed"
    ],
    "cache_lifecycle": "scripts/reflect_cache.ps1 -Action reconcile",
    "daemon": {
      "script": "scripts/mcp_gateway_daemon.ps1",
      "auto_start": false,
      "defaults": {
        "idle_ttl_sec": 900,
        "max_request_bytes": 8388608,
        "max_response_bytes": 67108864
      }
    }
  },
  "verification": {
    "install_engine": "scripts/install_engine.ps1 -EngineRoot <UE_ROOT> -Profile <base|niagara-authoring>",
    "check_engine": "scripts/install_engine.ps1 -EngineRoot <UE_ROOT> -Profile <base|niagara-authoring> -CheckOnly",
    "bootstrap": "scripts/bootstrap.ps1 -UProject <PROJECT> -EngineRoot <UE_ROOT>",
    "bootstrap_profile": "scripts/bootstrap.ps1 -UProject <PROJECT> -EngineRoot <UE_ROOT> -Profile <PROFILE>",
    "reliable_profile": "tests/test_reliable_profile.ps1 -VibeUEPath <UE_ROOT>/Engine/Plugins/AI/VibeUE -EngineRoot <UE_ROOT>",
    "static": "scripts/bootstrap.ps1 -UProject <PROJECT> -EngineRoot <UE_ROOT> -CheckOnly",
    "doctor": "scripts/doctor.ps1 -RouteFile <PROJECT>/Saved/UEAgent/route.json",
    "route": "scripts/compact_context.ps1 -RouteFile <PROJECT>/Saved/UEAgent/route.json"
  }
}
