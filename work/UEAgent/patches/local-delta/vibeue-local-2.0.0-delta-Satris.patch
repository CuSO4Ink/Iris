-
-	if (!HttpResult.bSuccess)
-		return BuildErrorJson(TEXT("HTTP_ERROR"), HttpResult.ErrorMessage);
-
-	if (HttpResult.ResponseCode != 200)
-	{
-		FString ErrMsg;
-		if (HttpResult.Content.Num() > 0)
-		{
-			TArray<uint8> ContentCopy = HttpResult.Content;
-			ContentCopy.Add(0);
