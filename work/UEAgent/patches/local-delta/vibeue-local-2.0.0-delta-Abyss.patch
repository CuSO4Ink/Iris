diff --git a/Source/VibeUE/Private/PythonAPI/PerformanceVerdict.h b/Source/VibeUE/Private/PythonAPI/PerformanceVerdict.h
index e4c558b..525c38b 100644
--- a/Source/VibeUE/Private/PythonAPI/PerformanceVerdict.h
+++ b/Source/VibeUE/Private/PythonAPI/PerformanceVerdict.h
@@ -89,6 +89,192 @@ namespace PerformanceVerdict
 		return B;
 	}
 
+	struct FDistribution
+	{
+		int32 SampleCount = 0;
+		double MeanMs = 0.0;
+		double P50Ms = 0.0;
+		double P95Ms = 0.0;
+		double P99Ms = 0.0;
+		double MaxMs = 0.0;
+	};
+
+	inline FDistribution SummarizeDistribution(TArray<double> Values)
+	{
+		Values.RemoveAll([](double Value) { return !FMath::IsFinite(Value) || Value < 0.0; });
+		FDistribution Result;
+		Result.SampleCount = Values.Num();
+		if (Values.IsEmpty()) return Result;
+
+		double Total = 0.0;
+		for (double Value : Values) Total += Value;
+		Values.Sort();
+		auto Percentile = [&Values](double Quantile)
+		{
+			const int32 Index = FMath::Clamp(FMath::CeilToInt(Quantile * Values.Num()) - 1, 0, Values.Num() - 1);
+			return Values[Index];
+		};
+
+		Result.MeanMs = Total / Values.Num();
+		Result.P50Ms = Percentile(0.50);
+		Result.P95Ms = Percentile(0.95);
+		Result.P99Ms = Percentile(0.99);
+		Result.MaxMs = Values.Last();
+		return Result;
+	}
+
+	struct FTimingSample
+	{
+		double TimeSeconds = 0.0;
+		double GameMs = 0.0;
+		double RenderMs = 0.0;
+		double RhiMs = 0.0;
+		double GpuMs = 0.0;
+		double FrameMs = 0.0;
+		uint64 VramUsedBytes = 0;
+		uint64 VramBudgetBytes = 0;
+		uint64 VramAvailableBytes = 0;
+		uint64 VramDemotedBytes = 0;
+		bool bRhiAvailable = false;
+		bool bGpuAvailable = false;
+		bool bVramAvailable = false;
+	};
+
+	struct FMonitorSummary
+	{
+		int32 SampleCount = 0;
+		int32 OverBudgetCount = 0;
+		int32 HitchCount = 0;
+		int32 ContestedCount = 0;
+		double TargetFps = 60.0;
+		double BudgetMs = 1000.0 / 60.0;
+		double HitchThresholdMs = 50.0;
+		FDistribution Game;
+		FDistribution Render;
+		FDistribution Rhi;
+		FDistribution Gpu;
+		FDistribution Frame;
+		FDistribution VramUsed;
+		FDistribution VramUsage;
+		int32 VramOverBudgetCount = 0;
+		double VramCurrentTimeSeconds = 0.0;
+		double VramCurrentUsedMB = 0.0;
+		double VramCurrentBudgetMB = 0.0;
+		double VramCurrentAvailableMB = 0.0;
+		double VramCurrentDemotedMB = 0.0;
+		double VramPeakTimeSeconds = 0.0;
+		bool bVramCurrentOverBudget = false;
+		TMap<FString, int32> BoundCounts;
+		FString DominantBound;
+	};
+
+	inline FMonitorSummary SummarizeMonitor(
+		const TArray<FTimingSample>& Samples,
+		float TargetFPS,
+		float HitchThresholdMs)
+	{
+		FMonitorSummary Result;
+		Result.TargetFps = SafeTargetFps(TargetFPS);
+		Result.BudgetMs = 1000.0 / Result.TargetFps;
+		Result.HitchThresholdMs = FMath::IsFinite(HitchThresholdMs) && HitchThresholdMs > 0.0f
+			? HitchThresholdMs
+			: FMath::Max(50.0, Result.BudgetMs * 2.0);
+
+		TArray<double> GameValues;
+		TArray<double> RenderValues;
+		TArray<double> RhiValues;
+		TArray<double> GpuValues;
+		TArray<double> FrameValues;
+		TArray<double> VramUsedValues;
+		TArray<double> VramUsageValues;
+		GameValues.Reserve(Samples.Num());
+		RenderValues.Reserve(Samples.Num());
+		RhiValues.Reserve(Samples.Num());
+		GpuValues.Reserve(Samples.Num());
+		FrameValues.Reserve(Samples.Num());
+		VramUsedValues.Reserve(Samples.Num());
+		VramUsageValues.Reserve(Samples.Num());
+		double PeakVramUsedMB = -1.0;
+		bool bHasCurrentVram = false;
+
+		for (const FTimingSample& Sample : Samples)
+		{
+			if (!FMath::IsFinite(Sample.FrameMs) || Sample.FrameMs <= 0.0) continue;
+			GameValues.Add(Sample.GameMs);
+			RenderValues.Add(Sample.RenderMs);
+			if (Sample.bRhiAvailable) RhiValues.Add(Sample.RhiMs);
+			if (Sample.bGpuAvailable) GpuValues.Add(Sample.GpuMs);
+			FrameValues.Add(Sample.FrameMs);
+			Result.OverBudgetCount += Sample.FrameMs > Result.BudgetMs ? 1 : 0;
+			Result.HitchCount += Sample.FrameMs >= Result.HitchThresholdMs ? 1 : 0;
+
+			if (Sample.bVramAvailable && Sample.VramBudgetBytes > 0)
+			{
+				constexpr double BytesPerMB = 1024.0 * 1024.0;
+				const double UsedMB = Sample.VramUsedBytes / BytesPerMB;
+				const double UsagePct = 100.0 * Sample.VramUsedBytes / Sample.VramBudgetBytes;
+				const bool bOverBudget = Sample.VramDemotedBytes > 0
+					|| Sample.VramUsedBytes > Sample.VramBudgetBytes;
+				VramUsedValues.Add(UsedMB);
+				VramUsageValues.Add(UsagePct);
+				Result.VramOverBudgetCount += bOverBudget ? 1 : 0;
+				if (!bHasCurrentVram || Sample.TimeSeconds >= Result.VramCurrentTimeSeconds)
+				{
+					bHasCurrentVram = true;
+					Result.VramCurrentTimeSeconds = Sample.TimeSeconds;
+					Result.VramCurrentUsedMB = UsedMB;
+					Result.VramCurrentBudgetMB = Sample.VramBudgetBytes / BytesPerMB;
+					Result.VramCurrentAvailableMB = Sample.VramAvailableBytes / BytesPerMB;
+					Result.VramCurrentDemotedMB = Sample.VramDemotedBytes / BytesPerMB;
+					Result.bVramCurrentOverBudget = bOverBudget;
+				}
+				if (UsedMB > PeakVramUsedMB)
+				{
+					PeakVramUsedMB = UsedMB;
+					Result.VramPeakTimeSeconds = Sample.TimeSeconds;
+				}
+			}
+
+			const FVerdict Verdict = Classify(
+				Sample.GameMs,
+				Sample.RenderMs,
+				Sample.RhiMs,
+				Sample.GpuMs,
+				Sample.bRhiAvailable,
+				Sample.bGpuAvailable);
+			Result.BoundCounts.FindOrAdd(Verdict.Bound)++;
+			Result.ContestedCount += Verdict.bContested ? 1 : 0;
+		}
+
+		Result.SampleCount = FrameValues.Num();
+		Result.Game = SummarizeDistribution(MoveTemp(GameValues));
+		Result.Render = SummarizeDistribution(MoveTemp(RenderValues));
+		Result.Rhi = SummarizeDistribution(MoveTemp(RhiValues));
+		Result.Gpu = SummarizeDistribution(MoveTemp(GpuValues));
+		Result.Frame = SummarizeDistribution(MoveTemp(FrameValues));
+		Result.VramUsed = SummarizeDistribution(MoveTemp(VramUsedValues));
+		Result.VramUsage = SummarizeDistribution(MoveTemp(VramUsageValues));
+
+		int32 TopCount = 0;
+		bool bTie = false;
+		for (const TCHAR* Name : { TEXT("GameThread"), TEXT("RenderThread"), TEXT("RHIThread"), TEXT("GPU") })
+		{
+			const int32 Count = Result.BoundCounts.FindRef(Name);
+			if (Count > TopCount)
+			{
+				TopCount = Count;
+				Result.DominantBound = Name;
+				bTie = false;
+			}
+			else if (Count > 0 && Count == TopCount)
+			{
+				bTie = true;
+			}
+		}
+		if (bTie) Result.DominantBound = TEXT("Mixed");
+		return Result;
+	}
