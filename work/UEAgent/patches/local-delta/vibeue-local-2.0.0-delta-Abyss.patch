+FNiagaraScratchResult UNiagaraScratchPadService::CreateSimulationStage(
+	const FString& SystemPath,
+	const FString& EmitterName,
+	const FString& StageName)
+{
+	FNiagaraScratchResult Result;
+	UNiagaraSystem* System = LoadSystem(SystemPath);
+	if (!System) { Result.Message = TEXT("System not found"); return Result; }
+
+	FNiagaraEmitterHandle* Handle = FindEmitterHandle(System, EmitterName);
+	if (!Handle) { Result.Message = TEXT("Emitter not found"); return Result; }
+
+	FVersionedNiagaraEmitterData* EmitterData = Handle->GetEmitterData();
+	UNiagaraEmitter* Emitter = Handle->GetInstance().Emitter;
+	UNiagaraScriptSource* Source = EmitterData ? Cast<UNiagaraScriptSource>(EmitterData->GraphSource) : nullptr;
+	UNiagaraGraph* Graph = Source ? Source->NodeGraph : nullptr;
+	if (!EmitterData || !Emitter || !Source || !Graph)
+	{
+		Result.Message = TEXT("Emitter graph unavailable");
+		return Result;
+	}
+
+	const FName RequestedName = StageName.IsEmpty() ? FName(TEXT("Simulation Stage")) : FName(*StageName);
+	for (UNiagaraSimulationStageBase* ExistingStage : EmitterData->GetSimulationStages())
+	{
+		if (ExistingStage && ExistingStage->SimulationStageName == RequestedName)
+		{
+			Result.bSuccess = true;
+			Result.Message = TEXT("Simulation stage already exists");
+			Result.ModuleName = ExistingStage->SimulationStageName.ToString();
+			Result.ScriptPath = ExistingStage->Script ? ExistingStage->Script->GetPathName() : FString();
+			Result.NodeId = ExistingStage->Script ? ExistingStage->Script->GetUsageId().ToString() : FString();
+			return Result;
+		}
+	}
+
+	System->Modify();
+	Emitter->Modify();
+	Graph->Modify();
+
+	UNiagaraSimulationStageGeneric* NewStage = NewObject<UNiagaraSimulationStageGeneric>(
+		Emitter,
+		UNiagaraSimulationStageGeneric::StaticClass(),
+		NAME_None,
+		RF_Transactional);
+	if (!NewStage)
+	{
+		Result.Message = TEXT("Failed to create simulation stage");
+		return Result;
+	}
+
+	NewStage->SimulationStageName = RequestedName;
+	NewStage->IterationSource = ENiagaraIterationSource::Particles;
+	NewStage->Script = NewObject<UNiagaraScript>(
+		NewStage,
+		MakeUniqueObjectName(NewStage, UNiagaraScript::StaticClass(), TEXT("SimulationStage")),
+		RF_Transactional);
+	if (!NewStage->Script)
+	{
+		Result.Message = TEXT("Failed to create simulation stage script");
+		return Result;
+	}
+
+	NewStage->Script->SetUsage(ENiagaraScriptUsage::ParticleSimulationStageScript);
+	NewStage->Script->SetUsageId(NewStage->GetMergeId());
+	NewStage->Script->SetLatestSource(Source);
+	Emitter->AddSimulationStage(NewStage, Handle->GetInstance().Version);
+	if (!CreateEmptyStageOutput(
+		Graph,
+		ENiagaraScriptUsage::ParticleSimulationStageScript,
+		NewStage->Script->GetUsageId()))
+	{
+		Result.Message = TEXT("Failed to create simulation stage graph output");
+		return Result;
+	}
+
+	System->MarkPackageDirty();
+	System->RequestCompile(false);
+	System->WaitForCompilationComplete();
+
+	Result.bSuccess = true;
+	Result.Message = TEXT("Particle-iteration simulation stage created");
+	Result.ModuleName = NewStage->SimulationStageName.ToString();
+	Result.ScriptPath = NewStage->Script->GetPathName();
+	Result.NodeId = NewStage->Script->GetUsageId().ToString();
+	return Result;
+}
+
+FNiagaraScratchResult UNiagaraScratchPadService::ConfigureGrid2DSimulationStage(
+	const FString& SystemPath,
+	const FString& EmitterName,
+	const FString& StageName,
+	const FString& DataInterfaceVariable)
+{
+	FNiagaraScratchResult Result;
+	UNiagaraSystem* System = LoadSystem(SystemPath);
+	if (!System) { Result.Message = TEXT("System not found"); return Result; }
+
+	FNiagaraEmitterHandle* Handle = FindEmitterHandle(System, EmitterName);
+	if (!Handle) { Result.Message = TEXT("Emitter not found"); return Result; }
+
+	FVersionedNiagaraEmitterData* EmitterData = Handle->GetEmitterData();
+	if (!EmitterData) { Result.Message = TEXT("Emitter data unavailable"); return Result; }
+	if (DataInterfaceVariable.IsEmpty())
+	{
+		Result.Message = TEXT("Data interface variable is empty");
+		return Result;
+	}
+
+	UNiagaraSimulationStageGeneric* TargetStage = nullptr;
+	for (UNiagaraSimulationStageBase* Stage : EmitterData->GetSimulationStages())
+	{
+		if (Stage
+			&& Stage->SimulationStageName.ToString().Equals(StageName, ESearchCase::IgnoreCase))
+		{
+			TargetStage = Cast<UNiagaraSimulationStageGeneric>(Stage);
+			break;
+		}
+	}
+	if (!TargetStage)
+	{
+		Result.Message = TEXT("Generic simulation stage not found");
+		return Result;
+	}
+
+	System->Modify();
+	TargetStage->Modify();
+	TargetStage->IterationSource = ENiagaraIterationSource::DataInterface;
+	TargetStage->DataInterface.BoundVariable = FNiagaraVariable(
+		FNiagaraTypeDefinition(UNiagaraDataInterfaceGrid2DCollection::StaticClass()),
+		FName(*DataInterfaceVariable));
+
+	System->MarkPackageDirty();
+	System->RequestCompile(false);
+	System->WaitForCompilationComplete();
+
+	Result.bSuccess = true;
+	Result.Message = TEXT("Grid2D data-interface iteration configured");
+	Result.ModuleName = TargetStage->SimulationStageName.ToString();
+	Result.ScriptPath = TargetStage->Script ? TargetStage->Script->GetPathName() : FString();
+	Result.NodeId = TargetStage->Script ? TargetStage->Script->GetUsageId().ToString() : FString();
+	return Result;
+}
+
+FNiagaraScratchResult UNiagaraScratchPadService::CreateInternalRenderTarget2DUserParameter(
+	const FString& SystemPath,
+	const FString& VariableName,
+	int32 SizeX,
+	int32 SizeY)
+{
+	FNiagaraScratchResult Result;
+	UNiagaraSystem* System = LoadSystem(SystemPath);
+	if (!System) { Result.Message = TEXT("System not found"); return Result; }
+	if (VariableName.IsEmpty())
+	{
+		Result.Message = TEXT("Variable name is empty");
+		return Result;
+	}
+
+	const FName ParameterName(*VariableName);
+	const FName ObjectName(*FString::Printf(TEXT("%s_InternalDI"), *ParameterName.ToString().Replace(TEXT("."), TEXT("_"))));
+	UNiagaraDataInterfaceRenderTarget2D* RenderTargetDI =
+		FindObject<UNiagaraDataInterfaceRenderTarget2D>(System, *ObjectName.ToString());
+	if (!RenderTargetDI)
+	{
+		RenderTargetDI = NewObject<UNiagaraDataInterfaceRenderTarget2D>(
+			System,
+			UNiagaraDataInterfaceRenderTarget2D::StaticClass(),
+			ObjectName,
+			RF_Transactional);
+	}
+	if (!RenderTargetDI)
+	{
+		Result.Message = TEXT("Failed to create RenderTarget2D data interface");
+		return Result;
+	}
+
+	const FIntPoint RequestedSize(FMath::Max(SizeX, 1), FMath::Max(SizeY, 1));
+	auto ConfigureRenderTargetDI = [&RequestedSize](UNiagaraDataInterfaceRenderTarget2D* TargetDI)
+	{
+		if (!TargetDI) return;
+		TargetDI->Modify();
+		TargetDI->Size = RequestedSize;
+		TargetDI->bInheritUserParameterSettings = false;
+		TargetDI->bOverrideFormat = true;
+		TargetDI->OverrideRenderTargetFormat = ETextureRenderTargetFormat::RTF_RGBA16f;
+		TargetDI->OverrideRenderTargetFilter = TextureFilter::TF_Bilinear;
+#if WITH_EDITORONLY_DATA
+		TargetDI->bPreviewRenderTarget = true;
+#endif
+	};
+
+	System->Modify();
+	ConfigureRenderTargetDI(RenderTargetDI);
+
+	const FNiagaraVariable Variable(
+		FNiagaraTypeDefinition(UNiagaraDataInterfaceRenderTarget2D::StaticClass()),
+		ParameterName);
+	FNiagaraUserRedirectionParameterStore& ExposedParameters = System->GetExposedParameters();
+	int32 ParameterOffset = ExposedParameters.IndexOf(Variable);
+	if (ParameterOffset == INDEX_NONE)
+	{
+		ExposedParameters.AddParameter(Variable, false, true, &ParameterOffset);
+	}
+	UNiagaraDataInterfaceRenderTarget2D* StoredRenderTargetDI =
+		Cast<UNiagaraDataInterfaceRenderTarget2D>(
+			ExposedParameters.GetDataInterface(ParameterOffset));
+	if (!StoredRenderTargetDI)
+	{
+		ExposedParameters.SetDataInterface(RenderTargetDI, ParameterOffset);
+		StoredRenderTargetDI = RenderTargetDI;
+	}
+	ConfigureRenderTargetDI(StoredRenderTargetDI);
+
+	FPropertyChangedEvent PropertyChangedEvent(nullptr, EPropertyChangeType::ValueSet);
+	System->PostEditChangeProperty(PropertyChangedEvent);
+	System->MarkPackageDirty();
+	System->RequestCompile(false);
+	System->WaitForCompilationComplete();
+
+	Result.bSuccess = true;
+	Result.Message = TEXT("Internal RenderTarget2D user parameter created");
+	Result.ModuleName = ParameterName.ToString();
+	Result.ScriptPath = StoredRenderTargetDI
+		? StoredRenderTargetDI->GetPathName()
+		: RenderTargetDI->GetPathName();
+	return Result;
+}
+
+FNiagaraScratchResult UNiagaraScratchPadService::CreateRasterizationGrid3DUserParameter(
+	const FString& SystemPath,
+	const FString& VariableName,
+	int32 SizeX,
+	int32 SizeY,
+	int32 SizeZ,
+	int32 NumAttributes,
