      "bootstrap_switch": "-ApplyEngineNiagaraPatch",
      "requires": ["niagara-authoring"],
      "required_plugins": ["NiagaraToolsets"],
      "warning": "Not self-sufficient: the toolset wrappers call UNiagaraExternalEditUtilities::GetUserParameterHierarchy/SetUserParameterCategory, which ship in patches/niagara-mcp-authoring/ue-5.8/niagaraeditor-export-authoring-apis-current.patch. Apply that patch too or the engine will not compile. No target currently uses this profile alone."
    },
    "niagara-authoring": {
      "kind": "core",
      "capability": "niagara-authoring",
      "apply": [
        "patches/ue58-mcp-authorization-gate.patch",
        "patches/ue58-niagara-toolsets.patch",
        "patches/niagara-mcp-authoring/ue-5.8/niagaraeditor-export-authoring-apis-current.patch",
