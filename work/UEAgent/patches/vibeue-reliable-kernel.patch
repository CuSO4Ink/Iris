diff --git a/Source/VibeUE/Public/Core/UEAgentReliableKernel.h b/Source/VibeUE/Public/Core/UEAgentReliableKernel.h
new file mode 100644
index 0000000..4c88487
--- /dev/null
+++ b/Source/VibeUE/Public/Core/UEAgentReliableKernel.h
@@ -0,0 +1,62 @@
+// Copyright Buckley Builds LLC 2026 All Rights Reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+
+class FJsonObject;
+
+/**
+ * Editor-local reliable execution kernel used by UEAgent's MCP tools.
+ *
+ * The kernel is intentionally hosted inside VibeUE: Epic's MCP server remains the only transport,
+ * ToolsetRegistry remains the typed domain dispatcher, and every mutation still executes on the
+ * editor game thread. This class adds the missing durable command, OCC, lease, receipt, recovery,
+ * and validated-save boundaries without introducing a second server or broker.
+ */
+class VIBEUE_API FUEAgentReliableKernel
+{
+public:
+	static FUEAgentReliableKernel& Get();
+
+	void Initialize();
+	void Shutdown();
+
+	/** Invoke one of the ueagent_* MCP control operations and return structured JSON. */
+	TSharedPtr<FJsonObject> Invoke(
+		const FString& Operation,
+		const TSharedPtr<FJsonObject>& Parameters);
+
+	/** Process-wide MCP gate bound through IModelContextProtocolModule. */
+	bool AuthorizeMCPCall(
+		const FString& ToolName,
+		const TSharedPtr<FJsonObject>& Arguments,
+		FString& OutError) const;
+
+	bool IsEnabled() const;
+	bool IsPerformanceFrozen() const;
+
+	/** True while a command owned by the reliable kernel is executing. */
+	static bool IsManagedMutation();
+
+	/** Existing domain services use this to leave packages dirty instead of saving mid-command. */
+	static bool ShouldDeferDirectSave();
+
+	/** Names registered as top-level MCP control tools. */
+	static const TArray<FString>& GetControlToolNames();
+
+	/** Human-readable MCP description for a control tool. */
+	static FString GetControlToolDescription(const FString& ToolName);
+
+	/** Input schema for a control tool. */
+	static TSharedPtr<FJsonObject> GetControlToolSchema(const FString& ToolName);
+
+private:
+	FUEAgentReliableKernel();
+	~FUEAgentReliableKernel();
+	FUEAgentReliableKernel(const FUEAgentReliableKernel&) = delete;
+	FUEAgentReliableKernel& operator=(const FUEAgentReliableKernel&) = delete;
+
+	class FImpl;
+	TUniquePtr<FImpl> Impl;
+};
