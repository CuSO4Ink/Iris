<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>HenTaiLoliTeam.Axolotl</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;Axolotl_Flame_VermilionBird_Machete&quot;]/tools/li[1]/armorPenetration</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;Axolotl_Flame_VermilionBird_Machete&quot;]/tools/li[1]/armorPenetration</xpath>
          <value>
            <armorPenetration>0.9</armorPenetration>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Axolotl_Flame_VermilionBird_Machete"]/tools/li[1]</xpath>
          <value>
            <armorPenetration>0.9</armorPenetration>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;Axolotl_WindWrappingSword&quot;]/tools/li[2]/power</xpath>
