+	TSharedPtr<FJsonValue> ProjectJsonValue(const TSharedPtr<FJsonValue>& Value, const FJsonProjection& Projection, const FString& Path)
+	{
+		if (!Value.IsValid())
+		{
+			return Value;
+		}
+
+		if (Value->Type == EJson::Object)
+		{
+			TSharedRef<FJsonObject> Source = Value->AsObject().ToSharedRef();
+			TSharedRef<FJsonObject> Result = MakeShared<FJsonObject>();
+			for (const TPair<FString, TSharedPtr<FJsonValue>>& Pair : Source->Values)
