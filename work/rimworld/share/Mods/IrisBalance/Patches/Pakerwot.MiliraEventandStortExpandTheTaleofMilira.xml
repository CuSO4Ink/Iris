<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Pakerwot.MiliraEventandStortExpandTheTaleofMilira</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;Milira_StarSword&quot;]/tools/li[1]/power</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;Milira_StarSword&quot;]/tools/li[1]/power</xpath>
          <value>
            <power>25.0</power>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Milira_StarSword"]/tools/li[1]</xpath>
          <value>
            <power>25.0</power>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;Milira_StarSword&quot;]/tools/li[1]/armorPenetration</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;Milira_StarSword&quot;]/tools/li[1]/armorPenetration</xpath>
          <value>
            <armorPenetration>0.9</armorPenetration>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Milira_StarSword"]/tools/li[1]</xpath>
          <value>
            <armorPenetration>0.9</armorPenetration>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;Milira_BishopScepterMS&quot;]/tools/li[2]/power</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;Milira_BishopScepterMS&quot;]/tools/li[2]/power</xpath>
          <value>
            <power>5.0</power>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Milira_BishopScepterMS"]/tools/li[2]</xpath>
          <value>
            <power>5.0</power>
          </value>
        </nomatch>
      </li>
      </operations>
    </match>
  </Operation>
</Patch>
