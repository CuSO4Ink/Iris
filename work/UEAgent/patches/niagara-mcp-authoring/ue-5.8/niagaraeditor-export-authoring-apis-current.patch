+void UNiagaraExternalEditUtilities::SetUserParameterCategory(UNiagaraSystem* System, const TArray<FString>& ParameterNames, const FString& Category, FNiagaraExternalEditContext& Context)
+{
+	if (!Context.CheckSystem(System))
+	{
+		return;
+	}
+
+	UNiagaraSystemEditorData* EditorData = Cast<UNiagaraSystemEditorData>(System->GetEditorData());
+	if (EditorData == nullptr)
+	{
+		Context.Error(LOCTEXT("SetCategoryNoEditorData", "SetUserParameterCategory: system has no UNiagaraSystemEditorData."));
+		return;
+	}
+
+	const FScopedTransaction Transaction(LOCTEXT("ExternalSetUserParameterCategory", "External System Set User Parameter Category"));
+	System->Modify();
+	EditorData->Modify();
+
+	if (EditorData->UserParameterHierarchy == nullptr)
+	{
+		EditorData->UserParameterHierarchy = NewObject<UHierarchyRoot>(EditorData, TEXT("UserParameterHierarchyRoot"), RF_Transactional);
+	}
+	UHierarchyRoot* Root = EditorData->UserParameterHierarchy;
+	Root->Modify();
+
+	UHierarchyElement* TargetParent = Root;
+	if (!Category.IsEmpty())
+	{
+		UHierarchyCategory* Found = nullptr;
+		for (const TObjectPtr<UHierarchyElement>& Child : Root->GetChildren())
+		{
+			UHierarchyCategory* Candidate = Cast<UHierarchyCategory>(Child);
+			if (Candidate != nullptr && Candidate->GetCategoryName().ToString() == Category)
+			{
+				Found = Candidate;
+				break;
+			}
+		}
+		if (Found == nullptr)
+		{
+			Found = Root->AddChild<UHierarchyCategory>();
+			Found->SetCategoryName(FName(*Category));
+			Found->SetIdentity(UHierarchyCategory::ConstructIdentity());
+			Found->Modify();
+		}
+		TargetParent = Found;
+	}
+
+	TArray<UNiagaraHierarchyUserParameter*> AllElements;
+	Root->GetChildrenOfType<UNiagaraHierarchyUserParameter>(AllElements, true);
+
+	for (const FString& NameRaw : ParameterNames)
+	{
+		FString ShortName = NameRaw;
+		ShortName.RemoveFromStart(TEXT("User."));
+
+		UNiagaraHierarchyUserParameter* Existing = nullptr;
+		for (UNiagaraHierarchyUserParameter* Element : AllElements)
+		{
+			FString ElementShort = Element->ToString();
+			ElementShort.RemoveFromStart(TEXT("User."));
+			if (ElementShort == ShortName)
+			{
+				Existing = Element;
+				break;
+			}
+		}
+
+		if (Existing != nullptr)
+		{
+			if (Existing->GetOuter() != TargetParent)
+			{
+				if (UHierarchyElement* OldParent = Cast<UHierarchyElement>(Existing->GetOuter()))
+				{
+					OldParent->Modify();
+					OldParent->GetChildrenMutable().Remove(Existing);
+				}
+				TargetParent->Modify();
+				TargetParent->GetChildrenMutable().Add(Existing);
+				Existing->Rename(nullptr, TargetParent, REN_DoNotDirty | REN_DontCreateRedirectors);
+			}
+			continue;
+		}
+
+		FNiagaraVariable FoundVar;
+		bool bFoundVar = false;
+		TArray<FNiagaraVariable> UserParameters;
+		System->GetExposedParameters().GetUserParameters(UserParameters);
+		for (const FNiagaraVariable& Candidate : UserParameters)
+		{
+			FString CandidateShort = Candidate.GetName().ToString();
+			CandidateShort.RemoveFromStart(TEXT("User."));
+			if (CandidateShort == ShortName)
+			{
+				FoundVar = Candidate;
+				bFoundVar = true;
+				break;
+			}
+		}
+		if (!bFoundVar)
+		{
+			Context.Error(FText::Format(LOCTEXT("SetCategoryUnknownParam", "SetUserParameterCategory: no user parameter named '{0}'."), FText::FromString(NameRaw)));
+			continue;
+		}
+
+		UNiagaraScriptVariable* ScriptVariable = FNiagaraEditorUtilities::UserParameters::GetScriptVariableForUserParameter(FoundVar, *System);
+		if (ScriptVariable == nullptr)
+		{
+			Context.Error(FText::Format(LOCTEXT("SetCategoryNoScriptVar", "SetUserParameterCategory: no script variable for '{0}'."), FText::FromString(NameRaw)));
+			continue;
+		}
+
+		TargetParent->Modify();
+		UNiagaraHierarchyUserParameter* NewElement = TargetParent->AddChild<UNiagaraHierarchyUserParameter>();
+		NewElement->SetFlags(RF_Transactional);
+		NewElement->Initialize(*ScriptVariable);
+		NewElement->Modify();
+	}
+
+	FPropertyChangedEvent PropertyChangedEvent(nullptr, EPropertyChangeType::ValueSet);
+	System->PostEditChangeProperty(PropertyChangedEvent);
+}
