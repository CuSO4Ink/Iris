+	UNiagaraNodeCustomHlsl* FindSingleCustomHlslNode(const UNiagaraScript* Script, FString& OutError)
+	{
+		const UNiagaraScriptSource* Source = Script ? Cast<UNiagaraScriptSource>(Script->GetLatestSource()) : nullptr;
+		if (Source == nullptr || Source->NodeGraph == nullptr)
+		{
+			OutError = TEXT("Script has no readable Niagara graph.");
+			return nullptr;
+		}
+
+		TArray<UNiagaraNodeCustomHlsl*> Nodes;
+		Source->NodeGraph->GetNodesOfClass(Nodes);
+		if (Nodes.Num() != 1)
+		{
+			OutError = FString::Printf(TEXT("Expected exactly one Custom HLSL node, found %d."), Nodes.Num());
+			return nullptr;
+		}
+		return Nodes[0];
+	}
+
+	FStrProperty* FindCustomHlslProperty(FString& OutError)
+	{
+		// UNiagaraNodeCustomHlsl is MinimalAPI, so its native Get/Set methods are not linkable here.
+		FStrProperty* Property = FindFProperty<FStrProperty>(UNiagaraNodeCustomHlsl::StaticClass(), TEXT("CustomHlsl"));
+		if (Property == nullptr)
+		{
+			OutError = TEXT("UNiagaraNodeCustomHlsl.CustomHlsl property was not found.");
+		}
+		return Property;
+	}
+
+	UNiagaraScript* ResolveScript(const FNiagaraExt_StackItemReference& Ref, FString& OutError)
+	{
+		if (Ref.System == nullptr)
+		{
+			OutError = TEXT("System is required.");
+			return nullptr;
+		}
+		if (Ref.EmitterName == NAME_None)
+		{
+			if (Ref.ScriptName == TEXT("SystemSpawnScript")) return Ref.System->GetSystemSpawnScript();
+			if (Ref.ScriptName == TEXT("SystemUpdateScript")) return Ref.System->GetSystemUpdateScript();
+			OutError = TEXT("System script must be SystemSpawnScript or SystemUpdateScript.");
+			return nullptr;
+		}
+
+		const FNiagaraEmitterHandle* Handle = Ref.System->GetEmitterHandles().FindByPredicate(
+			[&Ref](const FNiagaraEmitterHandle& Candidate) { return Candidate.GetName() == Ref.EmitterName; });
+		FVersionedNiagaraEmitterData* EmitterData = Handle ? Handle->GetInstance().GetEmitterData() : nullptr;
+		if (EmitterData == nullptr)
+		{
+			OutError = FString::Printf(TEXT("Emitter '%s' was not found."), *Ref.EmitterName.ToString());
+			return nullptr;
+		}
+		if (Ref.ScriptName == TEXT("GPUComputeScript")) return EmitterData->GetGPUComputeScript();
+
+		ENiagaraScriptUsage Usage;
+		if (Ref.ScriptName == TEXT("EmitterSpawnScript")) Usage = ENiagaraScriptUsage::EmitterSpawnScript;
+		else if (Ref.ScriptName == TEXT("EmitterUpdateScript")) Usage = ENiagaraScriptUsage::EmitterUpdateScript;
+		else if (Ref.ScriptName == TEXT("ParticleSpawnScript")) Usage = ENiagaraScriptUsage::ParticleSpawnScript;
+		else if (Ref.ScriptName == TEXT("ParticleUpdateScript")) Usage = ENiagaraScriptUsage::ParticleUpdateScript;
+		else
+		{
+			OutError = TEXT("Emitter script must be EmitterSpawnScript, EmitterUpdateScript, ParticleSpawnScript, ParticleUpdateScript, or GPUComputeScript.");
+			return nullptr;
+		}
+		return EmitterData->GetScript(Usage, FGuid());
+	}
+}
+
+FString UNiagaraToolset_System::GetScriptCustomHlsl(const UNiagaraScript* Script)
+{
+	FString ErrorText;
+	UNiagaraNodeCustomHlsl* Node = FindSingleCustomHlslNode(Script, ErrorText);
+	FStrProperty* Property = FindCustomHlslProperty(ErrorText);
+	if (Node == nullptr || Property == nullptr)
+	{
+		Error(ErrorText);
+		return {};
+	}
+	return Property->GetPropertyValue_InContainer(Node);
+}
+
+FString UNiagaraToolset_System::GetScriptRapidIterationParameters(const FNiagaraExt_StackItemReference& ScriptRef)
+{
+	FString ErrorText;
+	UNiagaraScript* Script = ResolveScript(ScriptRef, ErrorText);
+	if (Script == nullptr)
+	{
+		Error(ErrorText);
+		return {};
+	}
+
+	FNiagaraEditorModule& EditorModule = FModuleManager::GetModuleChecked<FNiagaraEditorModule>(TEXT("NiagaraEditor"));
+	TArray<FNiagaraVariable> Variables;
+	Script->RapidIterationParameters.GetParameters(Variables);
+	TArray<TSharedPtr<FJsonValue>> Rows;
+	for (const FNiagaraVariable& Variable : Variables)
+	{
+		FString Value = TEXT("(unsupported)");
+		TSharedPtr<INiagaraEditorTypeUtilities, ESPMode::ThreadSafe> TypeUtilities = EditorModule.GetTypeUtilities(Variable.GetType());
+		if (TypeUtilities.IsValid() && TypeUtilities->CanHandlePinDefaults())
+		{
+			FNiagaraVariable VariableWithValue = Variable;
+			VariableWithValue.SetData(Script->RapidIterationParameters.GetParameterData(Variable));
+			Value = TypeUtilities->GetPinDefaultStringFromValue(VariableWithValue);
+		}
+
+		TSharedRef<FJsonObject> Row = MakeShared<FJsonObject>();
+		Row->SetStringField(TEXT("name"), Variable.GetName().ToString());
+		Row->SetStringField(TEXT("type"), Variable.GetType().GetName());
+		Row->SetStringField(TEXT("value"), Value);
+		Rows.Add(MakeShared<FJsonValueObject>(Row));
+	}
+
+	FString Json;
+	TSharedRef<TJsonWriter<>> Writer = TJsonWriterFactory<>::Create(&Json);
+	FJsonSerializer::Serialize(Rows, Writer);
+	return Json;
+}
