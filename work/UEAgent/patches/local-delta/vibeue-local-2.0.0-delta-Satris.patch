+
+	Builder->DisconnectNodeInput(InHandle, R);
+	if (R != EMetaSoundBuilderResult::Succeeded)
+	{
+		return Fail(FString::Printf(TEXT("DisconnectPin: pin '%s' was not connected"), *InputName));
