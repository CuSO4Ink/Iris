+static FString ProjectRelativePath(const FString& Path)
+{
+	if (Path.IsEmpty()) return Path;
+
+	FString FullPath = FPaths::ConvertRelativePathToFull(Path);
+	FPaths::NormalizeFilename(FullPath);
+	FString ProjectRoot = FPaths::ConvertRelativePathToFull(FPaths::ProjectDir());
+	FPaths::NormalizeDirectoryName(ProjectRoot);
+	const FString ProjectRootWithSlash = ProjectRoot + TEXT("/");
+	if (!FullPath.StartsWith(ProjectRootWithSlash, ESearchCase::IgnoreCase)) return FullPath;
+
+	FString RelativePath = FullPath;
+	FPaths::MakePathRelativeTo(RelativePath, *ProjectRootWithSlash);
+	FPaths::NormalizeFilename(RelativePath);
+	return RelativePath;
+}
+
+static FString ResolveProjectPath(const FString& Path)
+{
+	if (Path.IsEmpty() || !FPaths::IsRelative(Path)) return Path;
+	return FPaths::ConvertRelativePathToFull(FPaths::ProjectDir() / Path);
+}
+
+static FString BuildTraceFilePath(const FString& Name)
+{
+	return PerformanceOutputDirAbs(TEXT("Traces")) / Name;
+}
