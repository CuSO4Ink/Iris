+		Scripts.Add(Script);
+		UNiagaraScriptSource* Source = NewObject<UNiagaraScriptSource>(Script);
+		Source->NodeGraph = NewObject<UNiagaraGraph>(Source);
+		Script->SetLatestSource(Source);
+		return Script;
+	};
+	UNiagaraGraph* CallerGraph = NewObject<UNiagaraGraph>(OwnerPackage);
+	UNiagaraNodeFunctionCall* Call = NewObject<UNiagaraNodeFunctionCall>(CallerGraph);
