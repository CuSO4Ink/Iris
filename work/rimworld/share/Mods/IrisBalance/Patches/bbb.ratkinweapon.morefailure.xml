<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>bbb.ratkinweapon.morefailure</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;Bullet_RK_AntiTank&quot;]/projectile/armorPenetrationBase</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;Bullet_RK_AntiTank&quot;]/projectile/armorPenetrationBase</xpath>
          <value>
            <armorPenetrationBase>0.9</armorPenetrationBase>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Bullet_RK_AntiTank"]/projectile</xpath>
          <value>
            <armorPenetrationBase>0.9</armorPenetrationBase>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName=&quot;Bullet_RK_ChargedRifleBullet&quot;]/projectile/damageAmountBase</xpath>
        <match Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName=&quot;Bullet_RK_ChargedRifleBullet&quot;]/projectile/damageAmountBase</xpath>
          <value>
            <damageAmountBase>11</damageAmountBase>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Bullet_RK_ChargedRifleBullet"]/projectile</xpath>
          <value>
            <damageAmountBase>11</damageAmountBase>
          </value>
        </nomatch>
      </li>
      </operations>
    </match>
  </Operation>
</Patch>
