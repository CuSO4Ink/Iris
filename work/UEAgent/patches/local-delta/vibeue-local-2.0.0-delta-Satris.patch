+TArray<FMetaSoundNodeInfo> UMetaSoundService::ListNodes(const FString& AssetPath)
+{
+	TArray<FMetaSoundNodeInfo> Result;
+
+	FString LoadError;
+	UMetaSoundSource* Source = nullptr;
