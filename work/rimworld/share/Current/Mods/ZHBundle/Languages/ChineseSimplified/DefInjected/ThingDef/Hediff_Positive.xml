  <!-- EN: 태양화 담배 -->
  <Miho_PositiveFlower_Pipe.label>曜阳烟</Miho_PositiveFlower_Pipe.label>
  <!-- EN: 태양화를 말려 만든 담배입니다. 흡연시 빠르게 양기를 보충해주며 기분이 좋아집니다. -->
