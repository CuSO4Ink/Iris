+				}
+				Result->SetField(Pair.Key, ProjectJsonValue(Pair.Value, Projection, ChildPath));
+			}
+			return MakeShared<FJsonValueObject>(Result);
+		}
+
+		if (Value->Type == EJson::Array)
+		{
+			const TArray<TSharedPtr<FJsonValue>>& Source = Value->AsArray();
+			TArray<TSharedPtr<FJsonValue>> Result;
+			const int32 Count = Projection.MaxItems > 0 ? FMath::Min(Projection.MaxItems, Source.Num()) : Source.Num();
+			Result.Reserve(Count);
+			for (int32 Index = 0; Index < Count; ++Index)
+			{
