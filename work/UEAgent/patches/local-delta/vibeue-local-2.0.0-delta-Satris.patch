+				TEXT("SetAttenuation: '%s' is not a SoundAttenuation asset"), *AttenuationAssetPath);
+			return false;
+		}
+		SoundCue->AttenuationSettings = Att;
+	}
+
+	SoundCue->MarkPackageDirty();
+	return true;
+}
