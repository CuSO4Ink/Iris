+	FString CompactClassName(FString Title)
+	{
+		int32 Index = INDEX_NONE;
+		if (Title.FindChar(TEXT('@'), Index)) Title = Title.RightChop(Index + 1);
+		if (Title.FindLastChar(TEXT('.'), Index)) Title = Title.RightChop(Index + 1);
+		return Title.IsEmpty() ? TEXT("Object") : Title;
+	}
+
+	FString CompactSchemaType(const TSharedPtr<FJsonObject>& Schema, const FString& Label)
+	{
+		if (!Schema.IsValid()) return TEXT("json");
+		const TArray<TSharedPtr<FJsonValue>>* UnionValues = nullptr;
+		if ((!Schema->TryGetArrayField(TEXT("anyOf"), UnionValues) || !UnionValues) && Schema->TryGetArrayField(TEXT("oneOf"), UnionValues) && UnionValues)
+		{
+			TArray<FString> Types;
+			for (const TSharedPtr<FJsonValue>& Value : *UnionValues)
+			{
+				if (Value.IsValid() && Value->Type == EJson::Object)
+				{
+					const FString Type = CompactSchemaType(Value->AsObject(), Label);
+					if (!Type.IsEmpty() && Type != TEXT("null") && !Types.Contains(Type)) Types.Add(Type);
+				}
+			}
+			Types.Sort();
+			if (Types.Num() > 1)
+			{
+				TArray<FString> ReferenceTypes;
+				for (const FString& Type : Types)
+				{
+					if (Type.StartsWith(TEXT("ue_ref<")) && Type.EndsWith(TEXT(">"))) ReferenceTypes.Add(Type.Mid(7, Type.Len() - 8));
+				}
+				if (ReferenceTypes.Num() == Types.Num()) return TEXT("ue_ref<") + FString::Join(ReferenceTypes, TEXT("|")) + TEXT(">");
+			}
+			return Types.Num() == 0 ? TEXT("json") : FString::Join(Types, TEXT("|"));
+		}
+
+		FString Type;
+		Schema->TryGetStringField(TEXT("type"), Type);
+		if (Type.Equals(TEXT("array"), ESearchCase::IgnoreCase))
+		{
+			const TSharedPtr<FJsonObject>* Items = nullptr;
+			return Schema->TryGetObjectField(TEXT("items"), Items) && Items
+				? CompactSchemaType(*Items, Label) + TEXT("[]") : TEXT("json[]");
+		}
+		FString Title;
+		if (Schema->TryGetStringField(TEXT("title"), Title) && !Title.IsEmpty())
+		{
+			return TEXT("ue_ref<") + CompactClassName(Title) + TEXT(">");
+		}
+		if (Type.Equals(TEXT("object"), ESearchCase::IgnoreCase))
+		{
+			const TSharedPtr<FJsonObject>* Properties = nullptr;
+			if (Schema->TryGetObjectField(TEXT("properties"), Properties) && Properties && (*Properties)->HasField(TEXT("refPath")))
+			{
+				const FString LowerLabel = Label.ToLower();
+				if (LowerLabel.Contains(TEXT("material")) && (LowerLabel.Contains(TEXT("function")) || LowerLabel.Contains(TEXT("or"))))
+					return TEXT("ue_ref<Material|MaterialFunction>");
+				return TEXT("ue_ref<Object>");
+			}
+			return TEXT("object");
+		}
+		return Type.IsEmpty() ? TEXT("json") : Type;
+	}
+
+	FString CompactToolName(const FString& ToolsetName, const FString& FullToolName)
+	{
+		FString ToolsetLeaf = ToolsetName;
+		int32 Index = INDEX_NONE;
+		if (ToolsetLeaf.FindLastChar(TEXT('.'), Index)) ToolsetLeaf = ToolsetLeaf.RightChop(Index + 1);
+		FString ToolLeaf = FullToolName;
+		const FString Prefix = ToolsetName + TEXT(".");
+		if (ToolLeaf.StartsWith(Prefix, ESearchCase::IgnoreCase)) ToolLeaf = ToolLeaf.RightChop(Prefix.Len());
+		else if (ToolLeaf.FindLastChar(TEXT('.'), Index)) ToolLeaf = ToolLeaf.RightChop(Index + 1);
+		return ToolsetLeaf + TEXT(".") + ToolLeaf;
+	}
+
+	FString ClassifyEffect(const FString& Name, const FString& Description)
+	{
+		FString LeafName = Name;
+		int32 DotIndex = INDEX_NONE;
+		if (LeafName.FindLastChar(TEXT('.'), DotIndex)) LeafName = LeafName.RightChop(DotIndex + 1);
+		FString Lower = (LeafName + TEXT(" ") + Description).ToLower();
+		if (Lower.Contains(TEXT("save"))) return TEXT("save");
+		for (const TCHAR* Word : { TEXT("create"), TEXT("add"), TEXT("delete"), TEXT("remove"), TEXT("update"), TEXT("set_"), TEXT("write"), TEXT("modify"), TEXT("edit"), TEXT("rename"), TEXT("move"), TEXT("execute") })
+		{
+			if (Lower.StartsWith(Word) || Lower.Contains(FString(TEXT(" ")) + Word) || Lower.Contains(FString(TEXT("_")) + Word) || Lower.Contains(FString(TEXT(".")) + Word)) return TEXT("write");
+		}
+		for (const TCHAR* Word : { TEXT("get"), TEXT("list"), TEXT("find"), TEXT("read"), TEXT("describe"), TEXT("inspect"), TEXT("query"), TEXT("search"), TEXT("check"), TEXT("validate"), TEXT("discover") })
+		{
+			if (Lower.StartsWith(Word) || Lower.Contains(FString(TEXT(" ")) + Word) || Lower.Contains(FString(TEXT("_")) + Word) || Lower.Contains(FString(TEXT(".")) + Word)) return TEXT("read");
+		}
+		return TEXT("unknown");
+	}
