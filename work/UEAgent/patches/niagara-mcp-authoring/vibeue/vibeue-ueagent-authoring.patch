+	TestNull(TEXT("public library graph is excluded from scratch healing"), GetScratchGraphFromCall(Call));
+	Call->FunctionScript = CreateScript(OtherPackage, TEXT("PrivateForeign"), RF_Transactional);
+	TestNull(TEXT("foreign private graph cannot be edited through the caller"), GetScratchGraphFromCall(Call));
+	return true;
+}
+#endif
