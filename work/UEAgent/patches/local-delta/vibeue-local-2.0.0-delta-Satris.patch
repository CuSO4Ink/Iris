+	{
+		UE_LOG(LogTemp, Error, TEXT("UAnimMontageService::SetSectionStartTime: Time %.2f is out of range"), NewStartTime);
+		return false;
+	}
+
+	Montage->Modify();
+
+	const FName SectionFName(*SectionName);
+	for (FCompositeSection& Section : Montage->CompositeSections)
