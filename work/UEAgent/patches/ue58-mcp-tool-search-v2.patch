+
+	FJsonProjection ReadProjection(const TSharedPtr<FJsonObject>& Object)
+	{
+		FJsonProjection Projection;
+		if (!Object.IsValid())
+		{
+			return Projection;
+		}
+
+		const TArray<TSharedPtr<FJsonValue>>* Values = nullptr;
+		if (Object->TryGetArrayField(TEXT("fields"), Values) && Values)
+		{
+			for (const TSharedPtr<FJsonValue>& Value : *Values)
+			{
+				FString Path;
+				if (Value.IsValid() && Value->TryGetString(Path) && !Path.IsEmpty())
+				{
+					Projection.Fields.Add(Path);
+				}
+			}
+		}
+		if (Object->TryGetArrayField(TEXT("exclude"), Values) && Values)
+		{
+			for (const TSharedPtr<FJsonValue>& Value : *Values)
+			{
+				FString Path;
+				if (Value.IsValid() && Value->TryGetString(Path) && !Path.IsEmpty())
+				{
+					Projection.Excluded.Add(Path);
+				}
+			}
+		}
+
+		double MaxItems = 0.0;
+		if (Object->TryGetNumberField(TEXT("max_items"), MaxItems))
+		{
+			Projection.MaxItems = FMath::Clamp(static_cast<int32>(MaxItems), 1, 4096);
+		}
+		Object->TryGetBoolField(TEXT("structured"), Projection.bStructured);
+		Object->TryGetBoolField(TEXT("include_text"), Projection.bIncludeText);
+		return Projection;
+	}
+
+	bool IsIncludedPath(const FJsonProjection& Projection, const FString& Path)
+	{
+		if (Projection.Fields.Num() == 0 || Path.IsEmpty())
+		{
+			return true;
+		}
+		for (const FString& Field : Projection.Fields)
+		{
+			if (Path == Field || Path.StartsWith(Field + TEXT(".")) || Field.StartsWith(Path + TEXT(".")))
+			{
+				return true;
+			}
+		}
+		return false;
+	}
+
+	bool IsExcludedPath(const FJsonProjection& Projection, const FString& Path)
+	{
+		for (const FString& Excluded : Projection.Excluded)
+		{
+			if (Path == Excluded || Path.StartsWith(Excluded + TEXT(".")))
+			{
+				return true;
+			}
+		}
+		return false;
+	}
+
+	TSharedPtr<FJsonValue> ProjectJsonValue(const TSharedPtr<FJsonValue>& Value, const FJsonProjection& Projection, const FString& Path)
+	{
+		if (!Value.IsValid())
+		{
+			return Value;
+		}
+
+		if (Value->Type == EJson::Object)
+		{
+			TSharedRef<FJsonObject> Source = Value->AsObject().ToSharedRef();
+			TSharedRef<FJsonObject> Result = MakeShared<FJsonObject>();
+			for (const TPair<FString, TSharedPtr<FJsonValue>>& Pair : Source->Values)
+			{
