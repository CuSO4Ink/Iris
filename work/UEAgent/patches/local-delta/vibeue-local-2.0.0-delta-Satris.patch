+		if (Section.SectionName == SectionFName)
+		{
+			Section.SetTime(NewStartTime);
+			MarkMontageModified(Montage);
+			return true;
+		}
+	}
+
+	UE_LOG(LogTemp, Warning, TEXT("UAnimMontageService::SetSectionStartTime: Section '%s' not found"), *SectionName);
+	return false;
+}
