+
+	bool Authorize(const FString& ToolName, const TSharedPtr<FJsonObject>& Arguments, FString& OutError) const
+	{
+		if (!bEnabled.Load()) return true;
+		if (!bInitialized.Load())
+		{
+			OutError = TEXT("UEAgent reliable profile is enabled but its editor kernel is unavailable");
+			return false;
+		}
+
+		const FString LowerTool = ToolName.ToLower();
+		const bool bControlTool = LowerTool.StartsWith(TEXT("ueagent_"));
+		if (IsPerformanceFrozen())
+		{
+			const bool bFreezeSafe = LowerTool == TEXT("ueagent_state")
+				|| LowerTool == TEXT("ueagent_get_job")
+				|| LowerTool == TEXT("ueagent_cancel");
+			if (!bFreezeSafe)
+			{
+				OutError = TEXT("PERFORMANCE_FROZEN: a deterministic GPU profile owns the editor; poll or cancel that job");
+				return false;
+			}
+		}
+		if (bControlTool) return true;
+		if (LowerTool == TEXT("list_toolsets") || LowerTool == TEXT("describe_toolset")) return true;
+		if (bMutationActive.Load())
+		{
+			OutError = TEXT("EDITOR_BUSY: authoritative domain reads are paused while a mutation owns the editor; use ueagent_state or poll its job");
+			return false;
+		}
+
+		FString EffectiveName = ToolName;
+		if (LowerTool == TEXT("call_tool") && Arguments.IsValid())
+		{
+			const FString NestedTool = UEAgentReliable::JsonStringField(Arguments, TEXT("tool_name"));
+			const FString Toolset = UEAgentReliable::JsonStringField(Arguments, TEXT("toolset_name"));
+			EffectiveName = Toolset.IsEmpty() ? NestedTool : Toolset + TEXT(".") + NestedTool;
+			const FString NestedLower = EffectiveName.ToLower();
+			if (NestedLower.StartsWith(TEXT("ueagent_"))
+				|| NestedLower == TEXT("list_toolsets")
+				|| NestedLower == TEXT("describe_toolset"))
+			{
+				return true;
+			}
+		}
+
+		if (ReadOnlyTools.Contains(EffectiveName.ToLower())) return true;
+		OutError = FString::Printf(
+			TEXT("RELIABLE_COMMAND_REQUIRED: '%s' is not an explicitly read-only tool. Submit it through ueagent_submit with command_id, scopes, and OCC expectations; saves require ueagent_save."),
+			*EffectiveName);
+		return false;
+	}
+
+	TSharedPtr<FJsonObject> Invoke(const FString& Operation, const TSharedPtr<FJsonObject>& Parameters)
+	{
+		if (Operation == TEXT("ueagent_state")) return State();
+		if (!bEnabled.Load()) return UEAgentReliable::Error(TEXT("RELIABLE_PROFILE_DISABLED"), TEXT("Enable [UEAgent.Reliable] Enabled=True in DefaultEditor.ini"));
+		if (Operation == TEXT("ueagent_submit")) return Submit(Parameters, false);
+		if (Operation == TEXT("ueagent_profile_gpu")) return Submit(Parameters, true);
+		if (Operation == TEXT("ueagent_get_job")) return GetJob(Parameters);
+		if (Operation == TEXT("ueagent_cancel")) return Cancel(Parameters);
+		if (Operation == TEXT("ueagent_snapshot")) return SnapshotRequest(Parameters);
+		if (Operation == TEXT("ueagent_batch_read")) return BatchRead(Parameters);
+		if (Operation == TEXT("ueagent_save")) return Save(Parameters);
+		if (Operation == TEXT("ueagent_recover")) return RecoverIncomplete(false);
+		return UEAgentReliable::Error(TEXT("UNKNOWN_OPERATION"), Operation);
+	}
