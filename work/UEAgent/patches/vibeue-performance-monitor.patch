+static TSharedPtr<FJsonObject> DistributionJson(
+	const PerformanceVerdict::FDistribution& Distribution,
+	const TCHAR* Unit = TEXT("ms"))
+{
+	TSharedPtr<FJsonObject> Result = MakeShared<FJsonObject>();
+	Result->SetNumberField(TEXT("samples"), Distribution.SampleCount);
+	Result->SetBoolField(TEXT("available"), Distribution.SampleCount > 0);
+	if (Distribution.SampleCount > 0)
+	{
+		Result->SetNumberField(FString::Printf(TEXT("mean_%s"), Unit), RoundPerf(Distribution.MeanMs));
+		Result->SetNumberField(FString::Printf(TEXT("p50_%s"), Unit), RoundPerf(Distribution.P50Ms));
+		Result->SetNumberField(FString::Printf(TEXT("p95_%s"), Unit), RoundPerf(Distribution.P95Ms));
+		Result->SetNumberField(FString::Printf(TEXT("p99_%s"), Unit), RoundPerf(Distribution.P99Ms));
+		Result->SetNumberField(FString::Printf(TEXT("max_%s"), Unit), RoundPerf(Distribution.MaxMs));
+	}
+	return Result;
+}
