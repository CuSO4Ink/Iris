+	/**
+	 * Minimal exported-API equivalent of FNiagaraStackGraphUtilities::ResetGraphForOutput.
+	 * ResetGraphForOutput itself is public in the header but is not exported from NiagaraEditor.
+	 */
+	UNiagaraNodeOutput* CreateEmptyStageOutput(
+		UNiagaraGraph* Graph,
+		ENiagaraScriptUsage Usage,
+		const FGuid& UsageId)
+	{
+		if (!Graph) return nullptr;
+
+		Graph->Modify();
+		UNiagaraNodeOutput* OutputNode = NewObject<UNiagaraNodeOutput>(
+			Graph, UNiagaraNodeOutput::StaticClass(), NAME_None, RF_Transactional);
+		if (!OutputNode) return nullptr;
+		Graph->AddNode(OutputNode, false, false);
+		OutputNode->CreateNewGuid();
+		OutputNode->PostPlacedNewNode();
+		OutputNode->SetUsage(Usage);
+		OutputNode->SetUsageId(UsageId);
+		OutputNode->Outputs.Add(FNiagaraVariable(FNiagaraTypeDefinition::GetParameterMapDef(), TEXT("Out")));
+		OutputNode->AllocateDefaultPins();
+		OutputNode->NodePosX = 400;
+		OutputNode->NodePosY = 0;
+
+		UNiagaraNodeInput* InputNode = NewObject<UNiagaraNodeInput>(
+			Graph, UNiagaraNodeInput::StaticClass(), NAME_None, RF_Transactional);
+		if (!InputNode) return nullptr;
+		Graph->AddNode(InputNode, false, false);
+		InputNode->CreateNewGuid();
+		InputNode->PostPlacedNewNode();
+		InputNode->Input = FNiagaraVariable(FNiagaraTypeDefinition::GetParameterMapDef(), TEXT("InputMap"));
+		InputNode->Usage = ENiagaraInputNodeUsage::Parameter;
+		InputNode->AllocateDefaultPins();
+		InputNode->NodePosX = 0;
+		InputNode->NodePosY = 0;
+
+		UEdGraphPin* OutputInputPin = nullptr;
+		for (UEdGraphPin* Pin : OutputNode->Pins)
+		{
+			if (Pin && Pin->Direction == EGPD_Input)
+			{
+				OutputInputPin = Pin;
+				break;
+			}
+		}
+		UEdGraphPin* InputOutputPin = nullptr;
+		for (UEdGraphPin* Pin : InputNode->Pins)
+		{
+			if (Pin && Pin->Direction == EGPD_Output)
+			{
+				InputOutputPin = Pin;
+				break;
+			}
+		}
+		if (!OutputInputPin || !InputOutputPin)
+		{
+			return nullptr;
+		}
+		OutputInputPin->MakeLinkTo(InputOutputPin);
+		return OutputNode;
+	}
