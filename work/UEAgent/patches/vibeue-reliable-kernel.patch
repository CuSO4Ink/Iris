+	void Initialize()
+	{
+		if (bInitialized.Load()) return;
+		bInitialized.Store(true);
+		bool bConfiguredEnabled = false;
+		if (GConfig)
+		{
+			GConfig->GetBool(UEAgentReliable::ConfigSection, TEXT("Enabled"), bConfiguredEnabled, GEditorIni);
+			GConfig->GetInt(UEAgentReliable::ConfigSection, TEXT("SaveTokenLifetimeSeconds"), SaveTokenLifetimeSeconds, GEditorIni);
+			GConfig->GetBool(UEAgentReliable::ConfigSection, TEXT("EnableFaultInjection"), bFaultInjectionEnabled, GEditorIni);
+		}
+		bEnabled.Store(bConfiguredEnabled);
+		SaveTokenLifetimeSeconds = FMath::Clamp(SaveTokenLifetimeSeconds, 30, 3600);
+		EditorEpoch = FGuid::NewGuid().ToString(EGuidFormats::DigitsWithHyphens);
+		TokenSecret = FGuid::NewGuid().ToString(EGuidFormats::Digits)
+			+ FGuid::NewGuid().ToString(EGuidFormats::Digits);
+
+		OperationsDir = FPaths::ConvertRelativePathToFull(FPaths::ProjectSavedDir() / TEXT("UEAgent/Operations"));
+		EvidenceDir = FPaths::ConvertRelativePathToFull(FPaths::ProjectSavedDir() / TEXT("UEAgent/Evidence"));
+		InboxDir = FPaths::ConvertRelativePathToFull(FPaths::ProjectSavedDir() / TEXT("UEAgent/Inbox"));
+		IFileManager::Get().MakeDirectory(*OperationsDir, true);
+		IFileManager::Get().MakeDirectory(*EvidenceDir, true);
+		IFileManager::Get().MakeDirectory(*InboxDir, true);
+
+		BuildReadOnlyAllowlist();
+		PackageSavedHandle = UPackage::PackageSavedWithContextEvent.AddRaw(this, &FImpl::HandlePackageSaved);
+		PackageDirtyHandle = UPackage::PackageDirtyStateChangedEvent.AddRaw(this, &FImpl::HandlePackageDirty);
+		TickerHandle = FTSTicker::GetCoreTicker().AddTicker(
+			FTickerDelegate::CreateRaw(this, &FImpl::Tick), 0.0f);
+
+		RecoverIncomplete(true);
+		WriteStateFile();
+	}
+
+	void Shutdown()
+	{
+		if (!bInitialized.Load()) return;
+		bInitialized.Store(false);
+		if (TickerHandle.IsValid())
+		{
+			FTSTicker::GetCoreTicker().RemoveTicker(TickerHandle);
+			TickerHandle.Reset();
+		}
+		if (PackageSavedHandle.IsValid())
+		{
+			UPackage::PackageSavedWithContextEvent.Remove(PackageSavedHandle);
+			PackageSavedHandle.Reset();
+		}
+		if (PackageDirtyHandle.IsValid())
+		{
+			UPackage::PackageDirtyStateChangedEvent.Remove(PackageDirtyHandle);
+			PackageDirtyHandle.Reset();
+		}
+		if (!ActiveJobId.IsEmpty())
+		{
+			if (TSharedPtr<FJob>* Job = Jobs.Find(ActiveJobId))
+			{
+				(*Job)->State = TEXT("terminal");
+				(*Job)->Outcome = TEXT("result_unknown");
+				(*Job)->Effect = TEXT("unknown");
+				(*Job)->Verification = TEXT("not_run");
+				(*Job)->ErrorCode = TEXT("EDITOR_SHUTDOWN");
+				(*Job)->ErrorMessage = TEXT("Editor shut down while the command was active");
+				Finalize(*(*Job));
+			}
+		}
+		Queue.Reset();
+		ActiveJobId.Reset();
+		ActiveLeases.Reset();
+		bMutationActive.Store(false);
+		bPerformanceFrozen.Store(false);
+		bManagedSave = false;
+		ManagedSavePackages.Reset();
+		UnexpectedManagedSavePackages.Reset();
+	}
