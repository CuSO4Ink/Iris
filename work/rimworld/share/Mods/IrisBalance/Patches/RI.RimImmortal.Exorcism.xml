          <xpath>Defs/GeneDef[defName="RI_ZombieGene_BoneScale"]/statOffsets</xpath>
          <value>
            <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationConditional">
