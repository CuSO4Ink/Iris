+FNiagaraScratchResult UNiagaraScratchPadService::CreateEmitterAsset(const FString& AssetPath)
+{
+	FNiagaraScratchResult R;
+	const FString AssetName = FPaths::GetBaseFilename(AssetPath);
+	if (AssetName.IsEmpty() || !AssetPath.StartsWith(TEXT("/Game/")))
+	{
+		R.Message = TEXT("Asset path must be a /Game/ asset path");
+		return R;
+	}
+	if (UEditorAssetLibrary::DoesAssetExist(AssetPath))
+	{
+		R.Message = TEXT("Asset already exists");
+		return R;
+	}
+
+	UPackage* Package = CreatePackage(*AssetPath);
+	UNiagaraEmitter* Emitter = NewObject<UNiagaraEmitter>(Package, UNiagaraEmitter::StaticClass(), FName(*AssetName), RF_Public | RF_Standalone | RF_Transactional);
+	UNiagaraEmitterFactoryNew::InitializeEmitter(Emitter, false);
+	Emitter->SetUniqueEmitterName(AssetName);
+
+	FAssetRegistryModule& AssetRegistryModule = FModuleManager::LoadModuleChecked<FAssetRegistryModule>(TEXT("AssetRegistry"));
+	AssetRegistryModule.Get().AssetCreated(Emitter);
+	Emitter->PostEditChange();
+	Package->MarkPackageDirty();
+
+	R.bSuccess = true;
+	R.Message = FString::Printf(TEXT("Emitter asset created: %s"), *AssetPath);
+	return R;
+}
+FNiagaraScratchResult UNiagaraScratchPadService::AddParticleReadNode(
+	const FString& SystemPath,
+	const FString& EmitterName,
+	const FString& ModuleName,
+	const FString& NodeId,
+	const FString& SourceEmitterName,
+	const FString& PinName,
+	int32 PosX,
+	int32 PosY)
+{
+	FNiagaraScratchResult R;
+	UNiagaraSystem* System = LoadSystem(SystemPath);
+	if (!System) { R.Message = TEXT("System not found"); return R; }
+	FNiagaraEmitterHandle* Handle = FindEmitterHandle(System, EmitterName);
+	if (!Handle) { R.Message = TEXT("Emitter not found"); return R; }
+	UNiagaraNodeFunctionCall* Call = FindModuleNodeOnEmitter(Handle->GetEmitterData(), ModuleName);
+	UNiagaraGraph* Graph = GetScratchGraphFromCall(Call);
+	if (!Graph) { R.Message = TEXT("Scratch module not found"); return R; }
+	UNiagaraNodeCustomHlsl* HlslNode = Cast<UNiagaraNodeCustomHlsl>(FindNodeByGuid(Graph, NodeId));
+	if (!HlslNode) { R.Message = TEXT("Custom HLSL node not found"); return R; }
+
+	const FNiagaraTypeDefinition ReadType(UNiagaraDataInterfaceParticleRead::StaticClass());
+
+	Graph->Modify();
+	HlslNode->Modify();
+
+	UEdGraphPin* HlslInPin = HlslNode->RequestNewTypedPin(EGPD_Input, ReadType, FName(*PinName));
+	if (!HlslInPin) { R.Message = TEXT("Failed to create DI input pin on HLSL node"); return R; }
+
+	FGraphNodeCreator<UNiagaraNodeInput> Creator(*Graph);
+	UNiagaraNodeInput* InputNode = Creator.CreateNode();
+	InputNode->Input = FNiagaraVariable(ReadType, FName(*PinName));
+	InputNode->Usage = ENiagaraInputNodeUsage::Parameter;
+	InputNode->ExposureOptions.bExposed = false;
+	InputNode->NodePosX = PosX;
+	InputNode->NodePosY = PosY;
+
+	EObjectFlags DIFlags = RF_Transactional;
+	if (InputNode->HasAnyFlags(RF_Public) || InputNode->IsTemplate()) { DIFlags |= RF_Public; }
+	UNiagaraDataInterfaceParticleRead* ReadDI = NewObject<UNiagaraDataInterfaceParticleRead>(
+		InputNode, UNiagaraDataInterfaceParticleRead::StaticClass(), NAME_None, DIFlags);
+	ReadDI->EmitterBinding.BindingMode = ENiagaraDataInterfaceEmitterBindingMode::Other;
+	ReadDI->EmitterBinding.EmitterName = FName(*SourceEmitterName);
+	if (FObjectPropertyBase* DIProp = CastField<FObjectPropertyBase>(UNiagaraNodeInput::StaticClass()->FindPropertyByName(TEXT("DataInterface"))))
+	{
+		DIProp->SetObjectPropertyValue_InContainer(InputNode, ReadDI);
+	}
+	Creator.Finalize();
+
+	if (UEdGraphPin* OutPin = InputNode->GetOutputPin(0))
+	{
+		OutPin->MakeLinkTo(HlslInPin);
+	}
+
+	Graph->NotifyGraphChanged();
+	System->MarkPackageDirty();
+
+	R.bSuccess = true;
+	R.Message = FString::Printf(TEXT("ParticleRead input '%s' bound to emitter '%s'"), *PinName, *SourceEmitterName);
+	R.NodeId = InputNode->NodeGuid.ToString();
+	return R;
+}
