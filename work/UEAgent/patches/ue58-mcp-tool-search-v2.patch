+		TSharedRef<TJsonReader<>> Reader = TJsonReaderFactory<>::Create(RawSchema);
+		if (!FJsonSerializer::Deserialize(Reader, Schema) || !Schema.IsValid())
+		{
+			return MakeError(TEXT("Toolset schema is not valid JSON"));
+		}
+
+		TSharedRef<FJsonObject> Result = MakeShared<FJsonObject>();
+		FString Value;
+		if (Schema->TryGetStringField(TEXT("name"), Value)) Result->SetStringField(TEXT("name"), Value);
+		if (Schema->TryGetStringField(TEXT("version"), Value)) Result->SetStringField(TEXT("version"), Value);
+		if (Schema->TryGetStringField(TEXT("description"), Value)) Result->SetStringField(TEXT("description"), Value);
