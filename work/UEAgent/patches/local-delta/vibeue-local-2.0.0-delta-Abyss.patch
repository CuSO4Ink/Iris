+FString UPerformanceService::ReadMonitor()
+{
+	if (!GMonitorHasSession)
+	{
+		return ErrJson(TEXT("NOT_STARTED"), TEXT("No performance monitor session exists. Call StartMonitor first."));
+	}
+
+	TSharedPtr<FJsonObject> Root = BuildMonitorSnapshot(GMonitorActive ? TEXT("monitoring") : TEXT("stopped"));
+	Root->SetNumberField(TEXT("warmup_frames_remaining"), GMonitorWarmupRemaining);
+	if (GMonitorActive)
+	{
+		GMonitorSuppressFrames = FMath::Max(GMonitorSuppressFrames, 3);
+		Root->SetStringField(
+			TEXT("note"),
+			TEXT("The next three frames will be discarded so this MCP read cannot create a false GameThread hitch."));
+	}
+	return OkJson(Root);
+}
+
+FString UPerformanceService::StopMonitor(const FString& Name, bool SaveSnapshot)
+{
+	if (!GMonitorHasSession)
+	{
+		return ErrJson(TEXT("NOT_STARTED"), TEXT("No performance monitor session exists. Call StartMonitor first."));
+	}
+	if (GMonitorTickerHandle.IsValid())
+	{
+		FTSTicker::GetCoreTicker().RemoveTicker(GMonitorTickerHandle);
+		GMonitorTickerHandle.Reset();
+	}
+	GMonitorActive = false;
+
+	TSharedPtr<FJsonObject> Root = BuildMonitorSnapshot(GMonitorContextLost ? TEXT("context_lost") : TEXT("stopped"));
+	Root->SetStringField(TEXT("note"), TEXT("Monitoring stopped; final rolling statistics are retained until the next StartMonitor call."));
+	if (!SaveSnapshot) return OkJson(Root);
+
+	FString SafeName = FPaths::MakeValidFileName(Name.IsEmpty() ? TEXT("monitor") : Name, TEXT('_'));
+	if (SafeName.IsEmpty()) SafeName = TEXT("monitor");
+	const FString Directory = PerformanceOutputDirAbs(TEXT("Snapshots"));
+	const FString Path = Directory / FString::Printf(
+		TEXT("%s_%s.json"),
+		*SafeName,
+		*FDateTime::Now().ToString(TEXT("%Y%m%d_%H%M%S")));
+	Root->SetStringField(TEXT("snapshot_file"), ProjectRelativePath(Path));
+	const FString Json = OkJson(Root);
+	if (!FFileHelper::SaveStringToFile(Json, *Path, FFileHelper::EEncodingOptions::ForceUTF8WithoutBOM))
+	{
+		return ErrJson(TEXT("SNAPSHOT_WRITE_FAILED"), FString::Printf(TEXT("Could not write monitor snapshot: %s"), *ProjectRelativePath(Path)));
+	}
+	return Json;
+}
+
+FString UPerformanceService::CaptureGPUProfile()
+{
+	if (!IsPIERunning())
+	{
+		return ErrJson(TEXT("PIE_REQUIRED"), TEXT("Start in-process PIE first; ProfileGPU must capture the game world, not the editor viewport."));
+	}
+	if (GProfileGpuCapturePending || UE::RHI::GPUProfiler::IsProfiling())
+	{
+		return ErrJson(TEXT("PROFILEGPU_BUSY"), TEXT("A ProfileGPU capture is already in progress."));
+	}
+
+	IConsoleObject* const ProfileGpuCommand = IConsoleManager::Get().FindConsoleObject(TEXT("ProfileGPU"));
+	if (!ProfileGpuCommand || !ProfileGpuCommand->AsCommand())
+	{
+		return ErrJson(TEXT("PROFILEGPU_UNAVAILABLE"), TEXT("This editor build does not expose Unreal's ProfileGPU command."));
+	}
+
+	IConsoleVariable* const ShowUICVar = IConsoleManager::Get().FindConsoleVariable(TEXT("r.ProfileGPU.ShowUI"));
+	if (!ShowUICVar)
+	{
+		return ErrJson(TEXT("PROFILEGPU_UI_CVAR_UNAVAILABLE"), TEXT("r.ProfileGPU.ShowUI is unavailable; refusing a capture that may open editor UI."));
+	}
+	const int32 SavedShowUI = ShowUICVar->GetInt();
+	const EConsoleVariableFlags SavedShowUISetBy = static_cast<EConsoleVariableFlags>(ShowUICVar->GetFlags() & ECVF_SetByMask);
+	const auto RestoreShowUI = [ShowUICVar, SavedShowUI, SavedShowUISetBy]()
+	{
+		if (SavedShowUISetBy == ECVF_SetByConsole) ShowUICVar->Set(SavedShowUI != 0, ECVF_SetByConsole);
+		else ShowUICVar->Unset(ECVF_SetByConsole);
+	};
+	ShowUICVar->Set(false, ECVF_SetByConsole);
+	if (ShowUICVar->GetInt() != 0)
+	{
+		RestoreShowUI();
+		return ErrJson(TEXT("PROFILEGPU_UI_SUPPRESSION_FAILED"), TEXT("Could not suppress the ProfileGPU visualizer; capture was not requested."));
+	}
+
+	const FDateTime RequestedAtUtc = FDateTime::UtcNow();
+	const FString CaptureId = FGuid::NewGuid().ToString(EGuidFormats::Digits);
+	const FString LogMarker = FString::Printf(TEXT("VIBEUE_PROFILEGPU_BEGIN capture_id=%s"), *CaptureId);
+	const FString CompletionMarker = FString::Printf(TEXT("VIBEUE_PROFILEGPU_END capture_id=%s"), *CaptureId);
+	UE_LOG(LogPerformance, Display, TEXT("%s requested_at_utc=%s"), *LogMarker, *RequestedAtUtc.ToIso8601());
+
+	if (!IConsoleManager::Get().ProcessUserConsoleInput(TEXT("ProfileGPU"), *GLog, GEditor->PlayWorld))
+	{
+		RestoreShowUI();
+		UE_LOG(LogPerformance, Error, TEXT("%s status=rejected"), *CompletionMarker);
+		return ErrJson(TEXT("PROFILEGPU_REJECTED"), TEXT("Unreal rejected the native ProfileGPU command."));
+	}
+
+	GProfileGpuCapturePending = true;
+	constexpr double RestoreTimeoutSeconds = 30.0;
+	constexpr double LogQuietSeconds = 0.5;
+	const double RestoreDeadline = FPlatformTime::Seconds() + RestoreTimeoutSeconds;
+	// ponytail: one global capture plus a short post-profile quiet window; add a log sink only if a backend
+	// emits ProfileGPU rows after IsProfiling() clears for longer than this window.
+	FTSTicker::GetCoreTicker().AddTicker(FTickerDelegate::CreateLambda(
+		[RestoreShowUI, ShowUICVar, SavedShowUI, CaptureId, CompletionMarker, RestoreDeadline, CompletedAt = 0.0](float) mutable -> bool
+		{
+			const double Now = FPlatformTime::Seconds();
+			const bool bTimedOut = Now >= RestoreDeadline;
+			if (!bTimedOut && UE::RHI::GPUProfiler::IsProfiling())
+			{
+				CompletedAt = 0.0;
+				return true;
+			}
+			if (!bTimedOut && CompletedAt == 0.0)
+			{
+				CompletedAt = Now;
+				return true;
+			}
+			if (!bTimedOut && Now - CompletedAt < LogQuietSeconds) return true;
+
+			RestoreShowUI();
+			const bool bShowUIRestored = ShowUICVar->GetInt() == SavedShowUI;
+			GProfileGpuCapturePending = false;
+			UE_LOG(
+				LogPerformance,
+				Display,
+				TEXT("%s status=%s show_ui_restored=%s"),
+				*CompletionMarker,
+				bTimedOut ? TEXT("timeout") : TEXT("complete"),
+				bShowUIRestored ? TEXT("true") : TEXT("false"));
+			return false;
+		}));
+
+	TSharedPtr<FJsonObject> Result = MakeShared<FJsonObject>();
+	Result->SetStringField(TEXT("status"), TEXT("requested"));
+	Result->SetStringField(TEXT("capture_id"), CaptureId);
+	Result->SetStringField(TEXT("requested_at_utc"), RequestedAtUtc.ToIso8601());
+	Result->SetStringField(TEXT("log_marker"), LogMarker);
+	Result->SetStringField(TEXT("completion_marker"), CompletionMarker);
+	Result->SetBoolField(TEXT("show_ui_suppressed"), true);
+	Result->SetStringField(TEXT("note"), TEXT("The native GPU pass tree will be logged after the next rendered frame. Read the log between log_marker and completion_marker."));
+	return OkJson(Result);
+}
