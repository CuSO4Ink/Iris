+FString FUEAgentReliableKernel::GetControlToolDescription(const FString& ToolName)
+{
+	if (ToolName == TEXT("ueagent_state")) return TEXT("Read the reliable editor epoch, queue, leases, dirty packages, and performance-freeze state.");
+	if (ToolName == TEXT("ueagent_submit")) return TEXT("Durably submit one typed ToolsetRegistry or VibeUE mutation with command identity, scopes, OCC snapshots, payload hash, and verification policy. Returns immediately with a job.");
+	if (ToolName == TEXT("ueagent_get_job")) return TEXT("Read a reliable command's current job state or immutable terminal receipt.");
+	if (ToolName == TEXT("ueagent_cancel")) return TEXT("Cancel a queued job or request cancellation of an active job without releasing an uncertain lease early.");
+	if (ToolName == TEXT("ueagent_snapshot")) return TEXT("Capture bounded authoritative live-editor snapshots and SHA-256 hashes for package, object, world, selection, or viewport scopes.");
+	if (ToolName == TEXT("ueagent_batch_read")) return TEXT("Execute up to 64 bounded state/snapshot/job/receipt reads in one MCP round trip.");
+	if (ToolName == TEXT("ueagent_save")) return TEXT("Validate a mutation-issued save token, recheck snapshots and package generations, then save exactly the authorized packages.");
+	if (ToolName == TEXT("ueagent_recover")) return TEXT("Scan durable journals and issue honest RESULT_UNKNOWN receipts for commands left incomplete by a previous editor epoch.");
+	if (ToolName == TEXT("ueagent_profile_gpu")) return TEXT("Queue a deterministic warmup/sample GPU profiling job under a global performance freeze and return structured evidence through its receipt.");
+	return TEXT("UEAgent reliable editor control tool.");
+}
+
+TSharedPtr<FJsonObject> FUEAgentReliableKernel::GetControlToolSchema(const FString& ToolName)
+{
+	TSharedPtr<FJsonObject> Schema = MakeShared<FJsonObject>();
+	Schema->SetStringField(TEXT("type"), TEXT("object"));
+	TSharedPtr<FJsonObject> Properties = MakeShared<FJsonObject>();
+	auto StringProperty = [&Properties](const TCHAR* Name, const TCHAR* Description)
+	{
+		TSharedPtr<FJsonObject> Property = MakeShared<FJsonObject>();
+		Property->SetStringField(TEXT("type"), TEXT("string"));
+		Property->SetStringField(TEXT("description"), Description);
+		Properties->SetObjectField(Name, Property);
+	};
+	auto NumberProperty = [&Properties](const TCHAR* Name, const TCHAR* Description)
+	{
+		TSharedPtr<FJsonObject> Property = MakeShared<FJsonObject>();
+		Property->SetStringField(TEXT("type"), TEXT("number"));
+		Property->SetStringField(TEXT("description"), Description);
+		Properties->SetObjectField(Name, Property);
+	};
+	auto BooleanProperty = [&Properties](const TCHAR* Name, const TCHAR* Description)
+	{
+		TSharedPtr<FJsonObject> Property = MakeShared<FJsonObject>();
+		Property->SetStringField(TEXT("type"), TEXT("boolean"));
+		Property->SetStringField(TEXT("description"), Description);
+		Properties->SetObjectField(Name, Property);
+	};
+	auto ArrayProperty = [&Properties](const TCHAR* Name, const TCHAR* ItemType, const TCHAR* Description)
+	{
+		TSharedPtr<FJsonObject> Property = MakeShared<FJsonObject>();
+		Property->SetStringField(TEXT("type"), TEXT("array"));
+		Property->SetStringField(TEXT("description"), Description);
+		TSharedPtr<FJsonObject> Items = MakeShared<FJsonObject>();
+		Items->SetStringField(TEXT("type"), ItemType);
+		Property->SetObjectField(TEXT("items"), Items);
+		Properties->SetObjectField(Name, Property);
+	};
+	auto ObjectProperty = [&Properties](const TCHAR* Name, const TCHAR* Description)
+	{
+		TSharedPtr<FJsonObject> Property = MakeShared<FJsonObject>();
+		Property->SetStringField(TEXT("type"), TEXT("object"));
+		Property->SetStringField(TEXT("description"), Description);
+		Properties->SetObjectField(Name, Property);
+	};
+
+	TArray<TSharedPtr<FJsonValue>> Required;
+	if (ToolName == TEXT("ueagent_submit"))
+	{
+		StringProperty(TEXT("command_id"), TEXT("Canonical hyphenated UUID, stable across retries."));
+		StringProperty(TEXT("target_type"), TEXT("toolset or vibeue."));
+		StringProperty(TEXT("toolset_name"), TEXT("Typed ToolsetRegistry name; required for target_type=toolset."));
+		StringProperty(TEXT("tool_name"), TEXT("Typed function/tool name."));
+		ObjectProperty(TEXT("arguments"), TEXT("Arguments validated by the underlying typed tool schema."));
+		ArrayProperty(TEXT("scopes"), TEXT("string"), TEXT("Canonical package/object/editor lease and snapshot scopes."));
+		ObjectProperty(TEXT("expected_snapshots"), TEXT("Optional scope to authoritative SHA-256 map for OCC."));
+		StringProperty(TEXT("lease_mode"), TEXT("scoped or exclusive."));
+		StringProperty(TEXT("verify"), TEXT("changed_or_noop, changed, unchanged, or success."));
+		StringProperty(TEXT("payload_sha256"), TEXT("SHA-256 of canonical arguments; mandatory at 64 KiB and above."));
+		ArrayProperty(TEXT("attachments"), TEXT("object"), TEXT("UTF-8 payload files under Saved/UEAgent/Inbox, each with argument/path/sha256."));
+		BooleanProperty(TEXT("allow_preexisting_dirty_save"), TEXT("Explicitly allow a later save token to persist pre-existing dirty edits in the declared packages; false by default."));
+		NumberProperty(TEXT("timeout_ms"), TEXT("Logical deadline in milliseconds; uncertain work keeps its lease."));
+		Required.Add(MakeShared<FJsonValueString>(TEXT("command_id")));
+		Required.Add(MakeShared<FJsonValueString>(TEXT("tool_name")));
+	}
+	else if (ToolName == TEXT("ueagent_profile_gpu"))
+	{
+		StringProperty(TEXT("command_id"), TEXT("Canonical hyphenated UUID, stable across retries."));
+		NumberProperty(TEXT("warmup_frames"), TEXT("Frames discarded before capture, 0-600."));
+		NumberProperty(TEXT("sample_frames"), TEXT("Measured frames, 30-3600."));
+		NumberProperty(TEXT("target_fps"), TEXT("Budget used by the structured verdict."));
+		NumberProperty(TEXT("hitch_threshold_ms"), TEXT("Frame threshold counted as a hitch."));
+		NumberProperty(TEXT("timeout_ms"), TEXT("Profile deadline in milliseconds."));
+		Required.Add(MakeShared<FJsonValueString>(TEXT("command_id")));
+	}
+	else if (ToolName == TEXT("ueagent_snapshot"))
+	{
+		ArrayProperty(TEXT("scopes"), TEXT("string"), TEXT("1-64 canonical scopes."));
+		BooleanProperty(TEXT("include_values"), TEXT("Include bounded reflected property values instead of hashes and metadata only."));
+		Required.Add(MakeShared<FJsonValueString>(TEXT("scopes")));
+	}
+	else if (ToolName == TEXT("ueagent_batch_read"))
+	{
+		ArrayProperty(TEXT("requests"), TEXT("object"), TEXT("1-64 state, snapshot, job, or receipt requests."));
+		Required.Add(MakeShared<FJsonValueString>(TEXT("requests")));
+	}
+	else if (ToolName == TEXT("ueagent_save"))
+	{
+		StringProperty(TEXT("save_token"), TEXT("Capability issued only by a verified mutation receipt."));
+		ArrayProperty(TEXT("packages"), TEXT("string"), TEXT("Optional exact package assertion; must equal the token set."));
+		Required.Add(MakeShared<FJsonValueString>(TEXT("save_token")));
+	}
+	else if (ToolName == TEXT("ueagent_get_job") || ToolName == TEXT("ueagent_cancel"))
+	{
+		StringProperty(TEXT("command_id"), TEXT("Canonical command UUID."));
+		Required.Add(MakeShared<FJsonValueString>(TEXT("command_id")));
+	}
+	Schema->SetObjectField(TEXT("properties"), Properties);
+	if (!Required.IsEmpty()) Schema->SetArrayField(TEXT("required"), Required);
+	return Schema;
+}
+
+#if WITH_AUTOMATION_TESTS
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(
+	FUEAgentReliableCanonicalJsonTest,
+	"VibeUE.UEAgentReliable.CanonicalJson",
+	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FUEAgentReliableCanonicalJsonTest::RunTest(const FString&)
+{
+	TSharedPtr<FJsonObject> First = MakeShared<FJsonObject>();
+	First->SetStringField(TEXT("z"), TEXT("line\nvalue"));
+	First->SetNumberField(TEXT("a"), 1.0);
+	TSharedPtr<FJsonObject> Second = MakeShared<FJsonObject>();
+	Second->SetNumberField(TEXT("a"), 1.0);
+	Second->SetStringField(TEXT("z"), TEXT("line\nvalue"));
+	TestEqual(TEXT("key order is canonical"), UEAgentReliable::CanonicalJson(First), UEAgentReliable::CanonicalJson(Second));
+	TestEqual(TEXT("hash is stable"), UEAgentReliable::Sha256String(UEAgentReliable::CanonicalJson(First)), UEAgentReliable::Sha256String(UEAgentReliable::CanonicalJson(Second)));
+	TestTrue(TEXT("canonical UUID accepted"), UEAgentReliable::IsGuid(TEXT("12345678-1234-1234-1234-1234567890ab")));
+	TestFalse(TEXT("noncanonical UUID rejected"), UEAgentReliable::IsGuid(TEXT("123456781234123412341234567890ab")));
+	TestTrue(TEXT("constant-time equality works"), UEAgentReliable::ConstantTimeEquals(TEXT("abc"), TEXT("abc")));
+	TestFalse(TEXT("constant-time inequality works"), UEAgentReliable::ConstantTimeEquals(TEXT("abc"), TEXT("abd")));
+	TestEqual(TEXT("native HMAC is stable"), UEAgentReliable::HmacSha1(TEXT("key"), TEXT("The quick brown fox jumps over the lazy dog")), TEXT("de7c9b85b8b78aa6bc8a7a36f70a90701c9db4d9"));
+	TestTrue(TEXT("save tools are recognized"), UEAgentReliable::IsSaveToolName(TEXT("VibeUE.USkeletonService.SaveAsset")));
+	TestFalse(TEXT("non-save mutations are not overblocked"), UEAgentReliable::IsSaveToolName(TEXT("ApplyChanges")));
+
+	FUEAgentReliableKernel& Kernel = FUEAgentReliableKernel::Get();
+	TSharedPtr<FJsonObject> State = Kernel.Invoke(TEXT("ueagent_state"), MakeShared<FJsonObject>());
+	bool bEnabled = false;
+	TestTrue(TEXT("reliable kernel is enabled"), State->TryGetBoolField(TEXT("enabled"), bEnabled) && bEnabled);
+
+	TSharedPtr<FJsonObject> SnapshotParams = MakeShared<FJsonObject>();
+	SnapshotParams->SetArrayField(TEXT("scopes"), { MakeShared<FJsonValueString>(TEXT("/Game/__UEAgentReliable_Missing__")) });
+	const TSharedPtr<FJsonObject> SnapshotA = Kernel.Invoke(TEXT("ueagent_snapshot"), SnapshotParams);
+	const TSharedPtr<FJsonObject> SnapshotB = Kernel.Invoke(TEXT("ueagent_snapshot"), SnapshotParams);
+	const TArray<TSharedPtr<FJsonValue>>* SnapshotsA = nullptr;
+	const TArray<TSharedPtr<FJsonValue>>* SnapshotsB = nullptr;
+	FString HashA, HashB;
+	if (SnapshotA->TryGetArrayField(TEXT("snapshots"), SnapshotsA) && SnapshotsA && SnapshotsA->Num() == 1)
+		(*SnapshotsA)[0]->AsObject()->TryGetStringField(TEXT("sha256"), HashA);
+	if (SnapshotB->TryGetArrayField(TEXT("snapshots"), SnapshotsB) && SnapshotsB && SnapshotsB->Num() == 1)
+		(*SnapshotsB)[0]->AsObject()->TryGetStringField(TEXT("sha256"), HashB);
+	TestTrue(TEXT("missing targets have deterministic snapshots"), !HashA.IsEmpty() && HashA == HashB);
+
+	FString AuthorizationError;
+	TestTrue(TEXT("reviewed read is allowed"), Kernel.AuthorizeMCPCall(TEXT("VibeUE.ActorService.GetAllProperties"), MakeShared<FJsonObject>(), AuthorizationError));
+	AuthorizationError.Reset();
+	TestFalse(TEXT("unknown direct call defaults to mutation"), Kernel.AuthorizeMCPCall(TEXT("VibeUE.UUnknownService.DoThing"), MakeShared<FJsonObject>(), AuthorizationError));
+
+	TSharedPtr<FJsonObject> Fault = MakeShared<FJsonObject>();
+	const FString CommandId = FGuid::NewGuid().ToString(EGuidFormats::DigitsWithHyphens).ToLower();
+	Fault->SetStringField(TEXT("command_id"), CommandId);
+	Fault->SetStringField(TEXT("target_type"), TEXT("toolset"));
+	Fault->SetStringField(TEXT("toolset_name"), TEXT("VibeUE.Automation"));
+	Fault->SetStringField(TEXT("tool_name"), TEXT("NeverRuns"));
+	Fault->SetStringField(TEXT("lease_mode"), TEXT("scoped"));
+	Fault->SetStringField(TEXT("verify"), TEXT("changed"));
+	Fault->SetStringField(TEXT("fault_injection"), TEXT("after_accept"));
+	Fault->SetArrayField(TEXT("scopes"), { MakeShared<FJsonValueString>(TEXT("/Game/__UEAgentReliable_Missing__")) });
+	TSharedPtr<FJsonObject> FaultReceipt = Kernel.Invoke(TEXT("ueagent_submit"), Fault);
+	FString FaultErrorCode;
+	FaultReceipt->TryGetStringField(TEXT("error_code"), FaultErrorCode);
+	if (FaultErrorCode == TEXT("FAULT_INJECTION_DISABLED"))
+	{
+		AddWarning(TEXT("Fault boundary check skipped; launch with -ini:Editor:[UEAgent.Reliable]:EnableFaultInjection=True"));
+	}
+	else
+	{
+		TestEqual(TEXT("after-accept fault is terminal"), UEAgentReliable::JsonStringField(FaultReceipt, TEXT("outcome")), TEXT("failed"));
+		TSharedPtr<FJsonObject> Replay = Kernel.Invoke(TEXT("ueagent_submit"), Fault);
+		bool bReplayed = false;
+		TestTrue(TEXT("same command is idempotently replayed"), Replay->TryGetBoolField(TEXT("replayed"), bReplayed) && bReplayed);
+		TSharedPtr<FJsonObject> Reused = UEAgentReliable::CloneObject(Fault);
+		Reused->SetStringField(TEXT("tool_name"), TEXT("DifferentDigest"));
+		TestEqual(TEXT("UUID reuse with another digest is rejected"), UEAgentReliable::JsonStringField(Kernel.Invoke(TEXT("ueagent_submit"), Reused), TEXT("error_code")), TEXT("COMMAND_ID_REUSED"));
+	}
+	return true;
+}
+#endif
